---
import Layout from '../../layouts/Layout.astro';
import MembershipForm from '../../components/MembershipForm.astro';

const lang = 'de';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'SprachCafé Polnisch e.V.',
  'url': 'https://sprachcafe-polnisch.org',
  'description': 'Wo Gemeinschaft und Kultur ein Zuhause finden — Mitgliedschaft beim SprachCafé Polnisch e.V.',
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Mitgliedschaftsstufen',
    'itemListElement': [
      {
        '@type': 'Offer',
        'name': 'Silver Mitgliedschaft',
        'price': '50.00',
        'priceCurrency': 'EUR',
        'description': 'Jahresbeitrag für Einzelpersonen & Förderer'
      },
      {
        '@type': 'Offer',
        'name': 'Gold Mitgliedschaft',
        'price': '120.00',
        'priceCurrency': 'EUR',
        'description': 'Jahresbeitrag für Familien & engagierte Förderer'
      },
      {
        '@type': 'Offer',
        'name': 'Platinum Mitgliedschaft',
        'price': '200.00',
        'priceCurrency': 'EUR',
        'description': 'Jahresbeitrag für besondere Kulturförderer'
      },
      {
        '@type': 'Offer',
        'name': 'Firmenmitgliedschaft',
        'priceSpecification': {
          '@type': 'PriceSpecification',
          'description': 'Individueller Jahresbeitrag für Unternehmen & Partner'
        }
      }
    ]
  }
};
---

<Layout
  title="Mitglied werden — SprachCafé Polnisch e.V."
  description="Wo Gemeinschaft und Kultur ein Zuhause finden: Werden Sie Mitglied beim SprachCafé Polnisch e.V. Erfahren Sie alles zu den 4 Schritten, Beitragsstufen (Silver, Gold, Platinum, Firmen) und Bankverbindung."
  lang={lang}
  jsonLd={jsonLd}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>❤️ Gemeinschaft & Kultur mitgestalten</span>
      </div>
      
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight mb-6">
        Wo Gemeinschaft und Kultur ein Zuhause finden
      </h1>
      
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] max-w-3xl mx-auto leading-relaxed">
        Werden Sie Teil des SprachCafé Polnisch e.V. — Gemeinsam fördern wir den interkulturellen Austausch, die zweisprachige Erziehung und gelebte Nachbarschaft in Berlin-Pankow, Schöneberg und Köpenick.
      </p>
    </div>

    <!-- 4-Schritte-Erklärung -->
    <section class="mb-20" id="schritte">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
          In 4 einfachen Schritten zur Mitgliedschaft
        </h2>
        <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2]">
          Der Weg zu Ihrer Mitgliedschaft ist unkompliziert und transparent aufgebaut.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Schritt 1 -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 relative flex flex-col justify-between shadow-[0_4px_20px_rgba(51,49,48,0.04)] hover:shadow-lg transition-all">
          <div>
            <div class="w-10 h-10 rounded-full bg-[#8B263E] text-white flex items-center justify-center font-bold text-lg mb-4">
              1
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Satzung lesen
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6">
              Lesen Sie unsere Vereinssatzung, um unsere Rechte, Pflichten und gemeinnützigen Ziele kennenzulernen.
            </p>
          </div>
          <a
            href="/downloads/Satzung-SCP-12.06.2020.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
          >
            <span>📄 Satzungs-PDF herunterladen</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <!-- Schritt 2 -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 relative flex flex-col justify-between shadow-[0_4px_20px_rgba(51,49,48,0.04)] hover:shadow-lg transition-all">
          <div>
            <div class="w-10 h-10 rounded-full bg-[#8B263E] text-white flex items-center justify-center font-bold text-lg mb-4">
              2
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Werte unterstützen
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6">
              Erfahren Sie mehr über unsere Werte für Toleranz, Sprachenvielfalt und gelebte Nachbarschaft.
            </p>
          </div>
          <a
            href="/ueber-uns/mission/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
          >
            <span>🎯 Mission & Werte ansehen</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <!-- Schritt 3 -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 relative flex flex-col justify-between shadow-[0_4px_20px_rgba(51,49,48,0.04)] hover:shadow-lg transition-all">
          <div>
            <div class="w-10 h-10 rounded-full bg-[#8B263E] text-white flex items-center justify-center font-bold text-lg mb-4">
              3
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Mitgliedschaftsart
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6">
              Wählen Sie zwischen **ordentlicher Mitgliedschaft** (aktiv mit Stimmrecht in der MV) oder **Förder-Mitgliedschaft**.
            </p>
          </div>
          <span class="text-xs text-[#8B263E] dark:text-[#ff758f] font-medium">Ordentlich oder Fördernd</span>
        </div>

        <!-- Schritt 4 -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 relative flex flex-col justify-between shadow-[0_4px_20px_rgba(51,49,48,0.04)] hover:shadow-lg transition-all">
          <div>
            <div class="w-10 h-10 rounded-full bg-[#8B263E] text-white flex items-center justify-center font-bold text-lg mb-4">
              4
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Stufe wählen
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6">
              Entscheiden Sie sich für Ihre passende Förderstufe (Silver, Gold, Platinum oder Firmenmitgliedschaft).
            </p>
          </div>
          <a href="#stufen" class="inline-flex items-center gap-2 text-sm font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline">
            <span>👇 Zu den Stufen</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 4 Mitgliedschaftsstufen -->
    <section class="mb-20" id="stufen">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
          Wählen Sie Ihre Mitgliedschaftsstufe
        </h2>
        <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] max-w-2xl mx-auto">
          Mit Ihrem Beitrag sichern Sie das Überleben unserer Begegnungsorte, der Hausbibliothek und der Sprachförderung für Kinder und Erwachsene.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        <!-- Silver -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#5b403d] dark:text-[#d4c5c2]">Einzelpersonen</span>
            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-1 mb-4">Silver</h3>
            <div class="mb-6">
              <span class="font-serif text-4xl font-bold text-[#8B263E] dark:text-[#ff758f]">50 €</span>
              <span class="text-sm text-[#5b403d] dark:text-[#d4c5c2]"> / Jahr</span>
            </div>
            <ul class="space-y-3 text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-8">
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Stimmrecht in der Mitgliederversammlung (bei ordentlicher Mgl.)
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Kostenloser Zugang zur Hausbibliothek
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> 10% Rabatt auf kostenpflichtige Workshops
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Regelmäßiger Vereins-Newsletter
              </li>
            </ul>
          </div>
          <a
            href="#mitglied-form"
            class="w-full text-center px-4 py-3 rounded-xl border border-[#8B263E] text-[#8B263E] dark:text-[#ff758f] font-semibold hover:bg-[#8B263E] hover:text-white transition-colors"
          >
            Silver wählen
          </a>
        </div>

        <!-- Gold (Empfohlen) -->
        <div class="bg-gradient-to-b from-[#8B263E] to-[#6b1d30] text-white rounded-3xl p-8 flex flex-col justify-between shadow-xl relative transform lg:-translate-y-2 border-2 border-[#ff758f]">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-[#8B263E] text-white font-bold text-xs uppercase px-4 py-1 rounded-full tracking-wider shadow-md">
            Empfohlen
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold text-white/80">Familien & Engagierte</span>
            <h3 class="font-serif text-2xl font-bold mt-1 mb-4">Gold</h3>
            <div class="mb-6">
              <span class="font-serif text-4xl font-bold text-white">120 €</span>
              <span class="text-sm text-white/80"> / Jahr</span>
            </div>
            <ul class="space-y-3 text-sm text-white/90 mb-8">
              <li class="flex items-start gap-2">
                <span class="text-[#ff758f] font-bold">✓</span> Alle Vorteile der Silver-Stufe
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#ff758f] font-bold">✓</span> Freier Eintritt zu ausgewählten Kulturveranstaltungen
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#ff758f] font-bold">✓</span> Vorrangige Ausleihe aus der Hausbibliothek
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#ff758f] font-bold">✓</span> Einladung zu exklusiven Mitgliederevents
              </li>
            </ul>
          </div>
          <a
            href="#mitglied-form"
            class="w-full text-center px-4 py-3 rounded-xl bg-white text-[#8B263E] font-bold hover:bg-slate-100 transition-colors shadow-md"
          >
            Gold wählen
          </a>
        </div>

        <!-- Platinum -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#5b403d] dark:text-[#d4c5c2]">Kulturförderer</span>
            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-1 mb-4">Platinum</h3>
            <div class="mb-6">
              <span class="font-serif text-4xl font-bold text-[#8B263E] dark:text-[#ff758f]">200 €</span>
              <span class="text-sm text-[#5b403d] dark:text-[#d4c5c2]"> / Jahr</span>
            </div>
            <ul class="space-y-3 text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-8">
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Alle Vorteile der Gold-Stufe
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Garantierte Plätze bei begehrten Kinder-Camps & Workshops
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Namentliche Nennung auf der Förderer-Wand (optional)
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Einladung zum jährlichen Kultur-Empfang
              </li>
            </ul>
          </div>
          <a
            href="#mitglied-form"
            class="w-full text-center px-4 py-3 rounded-xl border border-[#8B263E] text-[#8B263E] dark:text-[#ff758f] font-semibold hover:bg-[#8B263E] hover:text-white transition-colors"
          >
            Platinum wählen
          </a>
        </div>

        <!-- Firmenmitgliedschaft -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 flex flex-col justify-between shadow-sm hover:shadow-xl transition-all">
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold text-[#5b403d] dark:text-[#d4c5c2]">Unternehmen & Partner</span>
            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-1 mb-4">Firmen</h3>
            <div class="mb-6">
              <span class="font-serif text-3xl font-bold text-[#8B263E] dark:text-[#ff758f]">Individuell</span>
            </div>
            <ul class="space-y-3 text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-8">
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Logo-Präsenz auf der Website & bei Großveranstaltungen
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Förderung zweisprachiger Kinder- & Jugendprojekte
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Ausstellen von Spendenbescheinigungen
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B263E] font-bold">✓</span> Maßeinheitlich abgestimmte Partnerschaft
              </li>
            </ul>
          </div>
          <a
            href="#mitglied-form"
            class="w-full text-center px-4 py-3 rounded-xl border border-[#8B263E] text-[#8B263E] dark:text-[#ff758f] font-semibold hover:bg-[#8B263E] hover:text-white transition-colors"
          >
            Firmen wählen
          </a>
        </div>
      </div>

      <!-- Online Form -->
      <MembershipForm lang={lang} />
    </section>

    <!-- Bank- & Überweisungsdetails -->
    <section class="bg-gradient-to-r from-[#8B263E]/5 to-[#8B263E]/10 dark:from-[#8B263E]/20 dark:to-[#8B263E]/10 border border-[#8B263E]/20 rounded-3xl p-8 sm:p-12 mb-16" id="ueberweisung">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-[#8B263E] text-white flex items-center justify-center text-2xl shadow-md">
            🏦
          </div>
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              Bankverbindung für den Mitgliedsbeitrag
            </h2>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
              Bitte überweisen Sie Ihren Jahresbeitrag auf folgendes Vereinskonto:
            </p>
          </div>
        </div>

        <div class="bg-white dark:bg-[#1e1c1a] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 sm:p-8 space-y-4 shadow-sm mb-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 py-2 border-b border-[#e7e1df] dark:border-[#363230]">
            <span class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2]">Kreditinstitut:</span>
            <span class="sm:col-span-2 font-mono font-semibold text-[#1d1b1a] dark:text-[#f5f0ee]">Deutsche Skatbank</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 py-2 border-b border-[#e7e1df] dark:border-[#363230]">
            <span class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2]">IBAN:</span>
            <span class="sm:col-span-2 font-mono font-bold text-lg text-[#8B263E] dark:text-[#ff758f] select-all">
              DE79 8306 5408 0004 9743 36
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 py-2 border-b border-[#e7e1df] dark:border-[#363230]">
            <span class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2]">BIC:</span>
            <span class="sm:col-span-2 font-mono font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] select-all">
              GENODEF1SLR
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 py-2">
            <span class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2]">Verwendungszweck:</span>
            <span class="sm:col-span-2 font-mono text-sm text-[#1d1b1a] dark:text-[#f5f0ee] bg-[#f8f2f0] dark:bg-[#2a2725] p-2 rounded border border-[#e7e1df] dark:border-[#363230]">
              Mitgliedsbeitrag 2026 - [Vorname Nachname]
            </span>
          </div>
        </div>

        <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed text-center">
          Der SprachCafé Polnisch e.V. ist als gemeinnütziger Verein anerkannt. Mitgliedsbeiträge und Spenden sind steuerlich abzugsfähig. Eine Zuwendungsbestätigung stellen wir Ihnen gerne aus.
        </p>
      </div>
    </section>

    <!-- Links & Dokumente Footer Section -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-6 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📜</span>
        <div>
          <h4 class="font-serif font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">Wichtige Vereinsdokumente</h4>
          <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2]">Satzung, Grundsätze und Mission des Vereins</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="/downloads/Satzung-SCP-12.06.2020.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-sm font-medium rounded-xl border border-[#8B263E] text-[#8B263E] dark:text-[#ff758f] hover:bg-[#8B263E] hover:text-white transition-colors"
        >
          Satzungs-PDF (12.06.2020)
        </a>
        <a
          href="/ueber-uns/mission/"
          class="px-4 py-2 text-sm font-medium rounded-xl bg-[#8B263E] text-white hover:bg-[#6b1d30] transition-colors"
        >
          Unsere Mission
        </a>
      </div>
    </div>
  </section>
</Layout>
