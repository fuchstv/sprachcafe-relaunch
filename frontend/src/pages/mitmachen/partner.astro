---
import Layout from '../../layouts/Layout.astro';
import partnersData from '../../data/partners.json';

const lang = 'de';

const { impact, culture } = partnersData;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': 'Unsere Partner & Förderer — SprachCafé Polnisch e.V.',
  'description': 'Lernen Sie die Kooperationspartner, Stiftungen, Förderer und Kulturpartner des SprachCafé Polnisch e.V. in Berlin kennen.',
  'publisher': {
    '@type': 'Organization',
    'name': 'SprachCafé Polnisch e.V.',
    'url': 'https://xn--sprachcaf-j4a.org'
  }
};
---

<Layout
  title="Unsere Partner & Förderer — SprachCafé Polnisch e.V."
  description="Von lokalen Initiativen über Bildungseinrichtungen und Stiftungen bis hin zu Berliner Senatsverwaltungen — Unsere Partner unterstützen das SprachCafé Polnisch."
  lang={lang}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-6">
        <span>🤝 Kooperationen &amp; Netzwerk</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight mb-6">
        Unsere Partner &amp; Förderer
      </h1>

      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto mb-8">
        Von lokalen Unternehmen über Bildungseinrichtungen und Stiftungen bis hin zu gemeinnützigen Organisationen – SprachCafé Polnisch ist stolz darauf, mit einer Vielzahl unterschiedlicher Partner zusammenzuarbeiten, die unsere Mission unterstützen. Wir sind ihnen für ihre Unterstützung zutiefst dankbar.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="#impact-partner"
          class="px-6 py-3 rounded-full bg-[#8B263E] hover:bg-[#6b1d30] text-white font-bold text-sm transition-all shadow-sm"
        >
          Impact-Partner &darr;
        </a>
        <a
          href="#kultur-partner"
          class="px-6 py-3 rounded-full bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold text-sm hover:bg-[#f8f2f0] dark:hover:bg-[#2a2725] transition-colors"
        >
          Gemeinschafts- &amp; Kulturpartner &darr;
        </a>
        <a
          href="#partner-werden"
          class="px-6 py-3 rounded-full bg-[#039dcc]/10 text-[#039dcc] dark:text-[#38bdf8] font-bold text-sm hover:bg-[#039dcc]/20 transition-colors"
        >
          Partner werden &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-t border-[#e7e1df] dark:border-[#363230]" />
  </div>

  <!-- 1. Impact-Partner Section -->
  <section id="impact-partner" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto scroll-mt-24">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
        <span>🏛️ Institutionelle Förderung</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Impact-Partner
      </h2>
      <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Partner, die finanzielle Unterstützung leisten und sich an einer beidseitigen Zusammenarbeit beteiligen, um unsere gesellschaftliche Wirkung partnerschaftlich zu steigern.
      </p>
    </div>

    <!-- Impact Partner Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {impact.map((partner) => (
        <a
          href={partner.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#8B263E]/40 transition-all flex flex-col justify-between items-center text-center"
          aria-label={`${partner.name} (öffnet externen Link)`}
        >
          <div class="w-full h-32 bg-[#faf6f3] dark:bg-[#181615] rounded-xl flex items-center justify-center p-4 mb-4 border border-[#e7e1df]/60 dark:border-[#363230]/60 group-hover:scale-[1.02] transition-transform">
            <img
              src={partner.localImg}
              alt={partner.name}
              class="max-h-20 max-w-[85%] object-contain"
              loading="lazy"
            />
          </div>
          <div class="w-full">
            <h3 class="font-sans font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors line-clamp-2">
              {partner.name}
            </h3>
            <span class="inline-flex items-center gap-1 text-xs text-[#8c7471] dark:text-[#a89895] mt-2 group-hover:underline">
              <span>Website besuchen</span>
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Info Detail Box for Berlin Administration -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-[#faf6f3] dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-sm text-[#5b403d] dark:text-[#d4c5c2]">
      <h4 class="font-serif text-base font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">
        🏛️ Gefördert durch das Land Berlin &amp; Bundesministerien:
      </h4>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3 bg-white dark:bg-[#181615] rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <strong>Senatsverwaltung für Kultur und Gesellschaftlichen Zusammenhalt:</strong>
          <p class="mt-1">Förderung von Kunst-, Literatur- und Theaterangeboten.</p>
        </div>
        <div class="p-3 bg-white dark:bg-[#181615] rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <strong>Senatsverwaltung für ASGIVA:</strong>
          <p class="mt-1">Integration, Vielfalt, Partizipation und Antidiskriminierung.</p>
        </div>
        <div class="p-3 bg-white dark:bg-[#181615] rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <strong>Landesbeirat für Partizipation:</strong>
          <p class="mt-1">Vertretung von Migrant*innen im Berliner Senat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-t border-[#e7e1df] dark:border-[#363230]" />
  </div>

  <!-- 2. Gemeinschafts- und Kulturpartner Section -->
  <section id="kultur-partner" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto scroll-mt-24">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#039dcc]/10 border border-[#039dcc]/20 text-[#039dcc] dark:text-[#38bdf8] text-xs font-bold uppercase tracking-wider mb-3">
        <span>🎨 Kultureller Austausch &amp; Nachbarschaft</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Gemeinschafts- und Kulturpartner
      </h2>
      <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Organisationen, Vereine und Netzwerke, die mit uns zusammenarbeiten, um Gemeinschaftsbildung, kulturellen Austausch, Zweisprachigkeit und Mehrsprachigkeit zu fördern.
      </p>
    </div>

    <!-- Culture Partner Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6">
      {culture.map((partner) => (
        <a
          href={partner.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-4 shadow-sm hover:shadow-md hover:border-[#039dcc]/40 transition-all flex flex-col justify-between items-center text-center"
          title={partner.name}
          aria-label={`${partner.name} (öffnet externen Link)`}
        >
          <div class="w-full h-24 bg-[#faf6f3] dark:bg-[#181615] rounded-xl flex items-center justify-center p-3 mb-3 border border-[#e7e1df]/60 dark:border-[#363230]/60 group-hover:scale-105 transition-transform">
            <img
              src={partner.localImg}
              alt={partner.name}
              class="max-h-16 max-w-[90%] object-contain"
              loading="lazy"
            />
          </div>
          <p class="font-sans text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#039dcc] dark:group-hover:text-[#38bdf8] transition-colors line-clamp-2">
            {partner.name}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Partner Werden CTA Section -->
  <section id="partner-werden" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto scroll-mt-24">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#8B263E]/10 via-[#FAF6F3] to-[#039dcc]/10 dark:from-[#8B263E]/20 dark:via-[#22201e] dark:to-[#039dcc]/20 border border-[#e7e1df] dark:border-[#363230] p-8 sm:p-14 text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider">
          Kooperationen &amp; Partnerschaften
        </span>
        
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Möchten Sie Partner des SprachCafés werden?
        </h2>

        <p class="text-base sm:text-lg text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Ob als Fördermitglied, Sponsor, Projektpartner im Bereich Bildung und Kultur oder für gemeinsame Nachbarschaftsinitiativen: Wir freuen uns auf den Dialog mit Ihnen!
        </p>

        <div class="pt-4 flex flex-wrap justify-center items-center gap-4">
          <a
            href="/kontakt/"
            class="px-8 py-3.5 rounded-full bg-[#8B263E] hover:bg-[#6b1d30] text-white font-bold text-base transition-all shadow-md focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          >
            Kontakt für Partneranfragen &rarr;
          </a>
          <a
            href="/mitmachen/mitglied-werden/"
            class="px-6 py-3.5 rounded-full bg-white dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold text-base hover:bg-[#f8f2f0] dark:hover:bg-[#363230] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          >
            Firmenmitgliedschaft entdecken
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
