---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const lang = 'pl';
---

<Layout
  title="Wielojęzyczność i Poradnictwo Językowe — SprachCafé Polnisch e.V."
  description="Poradnictwo językowe, kawiarnie konwersacyjne, projekt SprachCafé im Ohr oraz wsparcie w dwujęzycznym wychowaniu dzieci (polsko-niemieckim) w Berlinie."
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto space-y-16">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold">
        <span>🗣️ Różnorodność & Dwujęzyczność</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
        Wielojęzyczność i Poradnictwo Językowe
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Wielojęzyczne dorastanie to niezwykły dar i kapitał na całe życie. Wspieramy rodziny, dzieci i dorosłych poprzez indywidualne poradnictwo, otwarte spotkania językowe oraz bogaty księgozbiór.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-4xl mb-4">👶</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Dzieci i Rodziny</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
            Dwujęzyczne czytanie bajek, grupy zabawowe dla maluchów oraz indywidualne konsultacje dla rodziców na temat wspierania języka polskiego i niemieckiego w codziennym życiu.
          </p>
        </div>
        <span class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f]">Wczesna edukacja językowa</span>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-4xl mb-4">☕</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Otwarte Kawiarnie Językowe</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
            Swobodne spotkania konwersacyjne w relaksującej atmosferze. Praktykuj język polski i niemiecki w naturalnych rozmowach z native speakerami.
          </p>
        </div>
        <span class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f]">Dla każdego poziomu zaawansowania</span>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-4xl mb-4">📚</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Biblioteka Domowa</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
            Ponad 400 dwujęzycznych książek dla dzieci, młodzieży i dorosłych, powieści oraz materiałów do nauki języka dostępnych do bezpłatnego wypożyczenia.
          </p>
        </div>
        <a href="/pl/hausbibliothek/" class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
          Przejdź do Biblioteki Domowej →
        </a>
      </div>
    </div>

    <!-- Retrospective: SprachCafé im Ohr -->
    <div class="bg-[#faf6f3] dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 sm:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider">
            🎧 Projekt „SprachCafé im Ohr”
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
            Doradztwo językowe w 14 językach
          </h2>
          <p class="font-sans text-sm sm:text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
            W ramach wieloletniego projektu „SprachCafé im Ohr” zrealizowaliśmy ponad 1200 konsultacji telefonicznych, 30 stacjonarnych spotkań i warsztatów, braliśmy udział w międzynarodowych targach językowych Expolingua oraz Berlińskiej Nocy Rodzin.
          </p>
          <p class="font-sans text-xs text-[#8c7471] dark:text-[#a89895]">
            Projekt był dofinansowany przez Berlińską Senatsverwaltung für Arbeit, Soziales, Gleichstellung, Integration, Vielfalt und Antidiskriminierung (ASGIVA).
          </p>
        </div>
        <div class="lg:col-span-4 flex justify-center">
          <div class="p-6 bg-white dark:bg-[#181615] rounded-2xl border border-[#e7e1df] dark:border-[#363230] text-center space-y-2">
            <span class="text-4xl">🌍</span>
            <div class="font-serif font-bold text-2xl text-[#8B263E] dark:text-[#ff758f]">14 Języków</div>
            <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">Empatyczne wsparcie dla wielojęzycznych rodzin</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Banner -->
    <div class="bg-gradient-to-r from-[#8B263E]/5 to-[#8B263E]/10 dark:from-[#8B263E]/20 dark:to-[#8B263E]/10 border border-[#8B263E]/20 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto">
      <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Umów się na indywidualne doradztwo językowe</h3>
      <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6 leading-relaxed">
        Masz pytania dotyczące dwujęzycznego wychowania dziecka, wyboru odpowiedniej szkoły lub poszukujesz dopasowanego kursu językowego? Skontaktuj się z nami!
      </p>
      <a
        href="/pl/kontakt/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#8B263E] text-white font-bold hover:bg-[#6b1d30] transition-colors"
      >
        <span>Poproś o konsultację</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
