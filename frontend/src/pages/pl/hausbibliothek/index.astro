---
import Layout from '../../../layouts/Layout.astro';
import BookshelfWidget from '../../../components/BookshelfWidget.astro';
import { getBooks } from '../../../lib/cms-api';

const lang = 'pl';
const books = await getBooks();
const buildTime = new Date().toLocaleString('pl-PL', { dateStyle: 'medium', timeStyle: 'short' });

// Extract unique filter options for dropdowns
const categories = Array.from(new Set(books.map(b => b.category)));
const locations = Array.from(new Set(books.map(b => b.location)));
const languages = Array.from(new Set(books.map(b => b.language)));
const statuses = Array.from(new Set(books.map(b => b.status)));
---

<Layout
  title="Katalog Biblioteki Domowej — SprachCafé Polnisch"
  description="Przeglądaj cyfrowy katalog Biblioteki Domowej SprachCafé Polnisch e.V. w oddziale Pankow (Schulzestr. 1). Ponad 400 dwujęzycznych książek."
  lang={lang}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    
    <!-- Banner Link do Portalu hausbibliothek.org (?lang=pl) -->
    <div class="mb-8 p-6 rounded-2xl bg-[#FAF5EB] dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-[0_4px_20px_rgba(51,49,48,0.05)] flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-2">
          📖 Wypożyczenia online &amp; Stan na żywo
        </div>
        <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Chcesz wypożyczyć książki lub zarządzać swoim kontem czytelnika?</h2>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          Rezerwacje książek, rejestracja czytelnika oraz przedłużenia odbywają się na portalu hausbibliothek.org.
        </p>
      </div>
      <a
        href="https://hausbibliothek.org/?lang=pl"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-full bg-[#8B1E2D] hover:bg-[#6b1d30] text-white font-bold transition-all shadow-md whitespace-nowrap"
      >
        Przejdź do hausbibliothek.org &rarr;
      </a>
    </div>

    <!-- Header Section z obrazem biblioteki -->
    <div class="mb-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-b border-[#E2D8CC] dark:border-[#363230] pb-8">
      <div class="lg:col-span-7 space-y-4">
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">Katalog Biblioteki Domowej</h1>
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] max-w-2xl leading-relaxed">
          Przeglądaj zbiory literackie w naszej Bibliotece Domowej w oddziale Pankow (Schulzestr. 1). Ponad 400 dwujęzycznych dzieł, powieści, reportaży, bajek oraz książek dla dzieci i młodzieży.
        </p>
        <div class="bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl px-4 py-2 text-xs text-[#5b403d] dark:text-[#d4c5c2] inline-block space-y-1">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#8B1E2D] dark:bg-[#ff6b6b]"></span>
            <span>Stan katalogu: <strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">{buildTime}</strong></span>
          </div>
          <div id="live-status-notice" class="text-[#5b403d] dark:text-[#d4c5c2] text-[11px] flex items-center gap-1">
            <span class="animate-pulse">🔄</span> Synchronizacja dostępności w toku...
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E2D8CC] dark:border-[#363230]">
          <img
            src="/images/library/hausbibliothek-raum.webp"
            alt="Biblioteka Domowa SprachCafé Polnisch w Berlinie"
            class="w-full h-48 sm:h-56 object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Nowości na półce Bookshelf Widget -->
    <div class="mb-12">
      <BookshelfWidget maxBooks={10} lang="pl" />
    </div>

    <!-- Filter UI Elements with Torn Paper Accent -->
    <div class="relative bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-6 mb-10 shadow-[0_4px_20px_rgba(51,49,48,0.05)] overflow-hidden">
      <!-- Torn paper top edge texture accent -->
      <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#8B1E2D] via-[#D97706] to-[#8B1E2D] opacity-80 pointer-events-none" aria-hidden="true"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <!-- Text Search -->
        <div>
          <label for="filter-search" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Szukaj</label>
          <input
            type="text"
            id="filter-search"
            placeholder="Tytuł, autor, ISBN..."
            class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <!-- Filter: Language -->
        <div>
          <label for="filter-language" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Język</label>
          <select id="filter-language" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Wszystkie języki</option>
            {languages.map(l => (
              <option value={l} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{l === 'PL' ? 'Polski (PL)' : l === 'DE' ? 'Niemiecki (DE)' : l === 'EN' ? 'Angielski (EN)' : 'Ukraiński (UKR)'}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Category -->
        <div>
          <label for="filter-category" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Kategoria</label>
          <select id="filter-category" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Wszystkie kategorie</option>
            {categories.map(cat => (
              <option value={cat} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{cat}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Location -->
        <div>
          <label for="filter-location" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Lokalizacja</label>
          <select id="filter-location" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Wszystkie lokalizacje</option>
            {locations.map(loc => (
              <option value={loc} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{loc}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Status -->
        <div>
          <label for="filter-status" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Dostępność</label>
          <select id="filter-status" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Wszystkie statusy</option>
            <option value="verfuegbar" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Dostępna</option>
            <option value="ausgeliehen" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Wypożyczona</option>
            <option value="reserviert" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Zarezerwowana</option>
          </select>
        </div>

      </div>
    </div>

    <!-- Pagefind Body Area for Client-Side Search Indexing (Card Index / Karteikarten Styling) -->
    <div data-pagefind-body>
      <div id="books-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {books.map(book => {
          const numericId = book.id.replace('book-', '');
          return (
            <article
              class="book-card relative bg-[#FDFBF7] dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#3A3532] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.06)] hover:shadow-[0_8px_30px_rgba(51,49,48,0.12)] flex flex-col justify-between hover:border-[#8B1E2D]/60 transition-all duration-300 group"
              data-book-id={numericId}
              data-title={(book.title || '').toLowerCase()}
              data-author={(book.author || '').toLowerCase()}
              data-isbn={book.isbn ? book.isbn.toLowerCase() : ''}
              data-language={book.language}
              data-category={book.category}
              data-location={book.location}
              data-status={book.status}
              data-pagefind-filter={`language:${book.language}, category:${book.category}, location:${book.location}, status:${book.status}`}
            >
              <!-- Card Index Top Tab Line -->
              <div class="h-1.5 w-full bg-gradient-to-r from-[#E2D8CC] via-[#8B1E2D]/40 to-[#E2D8CC] dark:from-[#3A3532] dark:via-[#FF758F]/40 dark:to-[#3A3532]"></div>

              <div>
                <div class="h-64 bg-[#FAF5EB] dark:bg-[#2a2725] overflow-hidden flex items-center justify-center p-4 relative">
                  {book.cover ? (
                    <img src={book.cover} alt={book.title} class="max-h-full object-contain shadow-md group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  ) : (
                    <div class="text-4xl text-[#5b403d] dark:text-[#d4c5c2]">📖</div>
                  )}
                  
                  <!-- Authentic Rubber Stamp Indicator -->
                  <div class="absolute top-2 right-2 flex items-center gap-1 pointer-events-none">
                    {book.status === 'verfuegbar' ? (
                      <img src="/images/stamps/stamp-verfuegbar.svg" alt="Dostępne Stamp" class="h-7 w-auto drop-shadow-sm transform rotate-3" />
                    ) : book.status === 'ausgeliehen' ? (
                      <img src="/images/stamps/stamp-ausgeliehen.svg" alt="Wypożyczone Stamp" class="h-7 w-auto drop-shadow-sm transform -rotate-3" />
                    ) : (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-800 text-amber-800 dark:text-amber-300">
                        Zarezerwowana
                      </span>
                    )}
                  </div>
                </div>

                <div class="p-5">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-[#FAF5EB] dark:bg-[#2a2725] text-[#8B1E2D] dark:text-[#ff758f] border border-[#E2D8CC] dark:border-[#363230]">
                      {book.language}
                    </span>
                    <span
                      class:list={[
                        'book-status-badge status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase transition-colors',
                        book.status === 'verfuegbar' ? 'bg-emerald-100 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300' :
                        book.status === 'ausgeliehen' ? 'bg-rose-100 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-800 dark:text-rose-300' :
                        'bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-800 text-amber-800 dark:text-amber-300'
                      ]}
                      data-book-id={numericId}
                    >
                      {book.status === 'verfuegbar' ? '✓ Dostępna' : book.status === 'ausgeliehen' ? 'Wypożyczona' : 'Zarezerwowana'}
                    </span>
                  </div>

                  <h3 class="font-serif font-bold text-lg text-[#1d1b1a] dark:text-[#f5f0ee] leading-snug mb-1 group-hover:text-[#8B1E2D] dark:group-hover:text-[#ff758f] transition-colors">
                    <a href={`/pl/hausbibliothek/${book.id}/`}>{book.title}</a>
                  </h3>
                  
                  <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] font-medium mb-3">
                    {book.author}
                  </p>

                  <div class="mt-auto pt-3 border-t border-[#E2D8CC] dark:border-[#363230] text-xs text-[#5b403d] dark:text-[#d4c5c2] space-y-1">
                    <div class="flex justify-between">
                      <span>Kategoria:</span>
                      <span class="text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold">{book.category}</span>
                    </div>
                    <div class="flex justify-between">
                      <span>Lokalizacja:</span>
                      <span class="text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold">📍 {book.location}</span>
                    </div>
                    {book.isbn && (
                      <div class="flex justify-between">
                        <span>ISBN:</span>
                        <span class="font-mono text-[#5b403d] dark:text-[#d4c5c2]">{book.isbn}</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              <div class="p-5 pt-0">
                <a
                  href={`/pl/hausbibliothek/${book.id}/`}
                  class="block w-full py-2.5 text-center text-xs font-bold rounded-xl bg-[#8B1E2D] hover:bg-[#6b1d30] text-white transition-colors shadow-sm"
                >
                  Szczegóły &amp; Wypożyczenie &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-16 bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl">
        <div class="text-4xl mb-2">🔍</div>
        <h3 class="font-serif font-bold text-lg text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Nie znaleziono książek</h3>
        <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">Spróbuj zmienić parametry wyszukiwania lub filtry.</p>
      </div>
    </div>

  </section>

  <!-- Client-side filter and Live Status Hydration script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('filter-search');
      const langSelect = document.getElementById('filter-language');
      const catSelect = document.getElementById('filter-category');
      const locSelect = document.getElementById('filter-location');
      const statusSelect = document.getElementById('filter-status');
      const bookCards = document.querySelectorAll('.book-card');
      const emptyState = document.getElementById('empty-state');
      const liveNotice = document.getElementById('live-status-notice');

      const bookCache = Array.from(bookCards).map(card => ({
        card: card,
        title: card.getAttribute('data-title') || '',
        author: card.getAttribute('data-author') || '',
        isbn: card.getAttribute('data-isbn') || '',
        bookLang: card.getAttribute('data-language') || '',
        bookCat: card.getAttribute('data-category') || '',
        bookLoc: card.getAttribute('data-location') || '',
        bookSt: card.getAttribute('data-status') || '',
        bookId: card.getAttribute('data-book-id') || ''
      }));

      function filterBooks() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const selLang = langSelect ? langSelect.value : 'all';
        const selCat = catSelect ? catSelect.value : 'all';
        const selLoc = locSelect ? locSelect.value : 'all';
        const selStat = statusSelect ? statusSelect.value : 'all';

        let visibleCount = 0;

        bookCache.forEach(cachedBook => {
          const { card, title, author, isbn, bookLang, bookCat, bookLoc, bookSt } = cachedBook;

          const matchesQuery = !query || title.includes(query) || author.includes(query) || isbn.includes(query);
          const matchesLang = selLang === 'all' || bookLang === selLang;
          const matchesCat = selCat === 'all' || bookCat === selCat;
          const matchesLoc = selLoc === 'all' || bookLoc === selLoc;
          const matchesStat = selStat === 'all' || bookSt === selStat;

          if (matchesQuery && matchesLang && matchesCat && matchesLoc && matchesStat) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      }

      [searchInput, langSelect, catSelect, locSelect, statusSelect].forEach(el => {
        if (el) {
          el.addEventListener('input', filterBooks);
          el.addEventListener('change', filterBooks);
        }
      });

      // Live Availability Hydration
      const exportUrl = 'https://hausbibliothek.org/api/export/books';

      fetch(exportUrl)
        .then(res => res.ok ? res.json() : null)
        .catch(() => null)
        .then(data => {
          if (!data) return;
          const booksList = Array.isArray(data) ? data : (data.data || []);
          const statusMap = new Map();
          booksList.forEach(b => {
            if (b.id) statusMap.set(String(b.id), b.availability_status || b.status);
          });

          bookCache.forEach(cachedBook => {
            const { card, bookId } = cachedBook;
            const liveStatus = statusMap.get(bookId);
            if (liveStatus) {
              const badge = card.querySelector('.book-status-badge, .status-badge');
              if (badge) {
                if (liveStatus === 'available' || liveStatus === 'verfuegbar') {
                  badge.className = 'book-status-badge status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase transition-colors bg-emerald-100 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
                  badge.textContent = '✓ Dostępna';
                  card.setAttribute('data-status', 'verfuegbar');
                  cachedBook.bookSt = 'verfuegbar';
                } else {
                  badge.className = 'book-status-badge status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase transition-colors bg-rose-100 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-800 dark:text-rose-300';
                  badge.textContent = 'Wypożyczona';
                  card.setAttribute('data-status', 'ausgeliehen');
                  cachedBook.bookSt = 'ausgeliehen';
                }
              }
            }
          });

          filterBooks();

          if (liveNotice) {
            liveNotice.innerHTML = '✅ <span class="text-emerald-600 dark:text-emerald-400 font-bold">Stan na żywo zsynchronizowany</span>';
          }
        })
        .catch(err => {
          console.warn('Live status sync warning:', err.message);
          if (liveNotice) {
            liveNotice.innerHTML = '⚠️ <span class="text-[#5b403d] dark:text-[#d4c5c2]">Stan katalogu statyczny (offline)</span>';
          }
        });
    });
  </script>
</Layout>
