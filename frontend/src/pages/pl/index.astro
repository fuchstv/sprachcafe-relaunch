---
import Layout from '../../layouts/Layout.astro';
import LibraryReferralSection from '../../components/LibraryReferralSection.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'pl';
const t = useTranslations(lang);
---

<Layout title="SprachCafé Polnisch - Witamy (/pl/)" lang={lang}>
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 text-center max-w-[1200px] mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
      <span>{t('hero.badge')}</span>
    </div>
    
    <h1 class="font-serif text-4xl sm:text-6xl font-bold tracking-tight text-[#1d1b1a] dark:text-[#f5f0ee] mb-6 leading-tight">
      {t('hero.title')}
    </h1>
    
    <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] max-w-3xl mx-auto mb-12 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 sm:p-10 text-left shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
      <h2 class="font-serif text-2xl font-bold text-[#8B263E] dark:text-[#ff758f] mb-4">🇵🇱 Witamy na polskiej stronie SprachCafé</h2>
      <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-8">
        SprachCafé Polnisch wspiera dialog polsko-niemiecki, kursy językowe oraz spotkania kulturalne w Berlinie.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-[#f8f2f0] dark:bg-[#2a2725] p-6 rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <div class="text-3xl mb-3" aria-hidden="true">🗣️</div>
          <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Spotkania językowe</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Regularne kawiarnie językowe dla języka polskiego i niemieckiego.</p>
        </div>

        <div class="bg-[#f8f2f0] dark:bg-[#2a2725] p-6 rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <div class="text-3xl mb-3" aria-hidden="true">📚</div>
          <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Biblioteka domowa</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Cyfrowe wypożyczanie literatury polskiej i niemieckiej.</p>
        </div>

        <div class="bg-[#f8f2f0] dark:bg-[#2a2725] p-6 rounded-xl border border-[#e7e1df] dark:border-[#363230]">
          <div class="text-3xl mb-3" aria-hidden="true">🎉</div>
          <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Wydarzenia kulturalne</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Spotkania autorskie, seanse filmowe i warsztaty.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sekcja odnośnika do hausbibliothek.org -->
  <LibraryReferralSection lang={lang} />
</Layout>
