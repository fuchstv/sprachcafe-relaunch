---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
import VintageEventTicketCard from "../../components/VintageEventTicketCard.astro";
import BookshelfWidget from "../../components/BookshelfWidget.astro";
import KiezHubSelector from "../../components/KiezHubSelector.astro";
import TestimonialGrid from "../../components/TestimonialGrid.astro";
import { getCollection } from "astro:content";

const lang = "pl";

function stripHtml(html: string): string {
  if (!html) return "";
  return html
    .replace(/<[^>]*>?/gm, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, "\"")
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

const allEvents = await getCollection("events");
const sortedEvents = allEvents
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3)
  .map((e) => ({
    slug: e.slug,
    title: e.data.title[lang] || e.data.title.de,
    date_start: e.data.date,
    location: e.data.locationRef,
    language: e.data.language.join(", ").toUpperCase(),
    target_group: e.data.targetAudience[lang] || e.data.targetAudience.de,
    description: stripHtml(e.data.description[lang] || e.data.description.de),
    image: e.data.image.src || "/images/events/event-sprachabend.webp",
  }));
---

<Layout
  title="SprachCafé Polnisch — Miejsce spotkań, języka i kultury w Berlinie"
  description="SprachCafé Polnisch e.V. to dwujęzyczne centrum kultury, języka i dialogu polsko-niemieckiego w Berlinie (Pankow, Schöneberg, Köpenick)."
  lang={lang}
>
  
  <!-- 1. Hero Section -->
  <HeroSection
    title="Witamy w SprachCafé Polnisch"
    subtitle="Twoje dwujęzyczne centrum kultury i spotkań. Odkrywaj język polski i niemiecki, literaturę i żywą społeczność w sercu Berlina."
    badge="☕ Otwarte & Zapraszamy"
    primaryCtaText="Odkryj wydarzenia"
    primaryCtaLink="/pl/events/"
    secondaryCtaText="Katalog Biblioteki Domowej"
    secondaryCtaLink="/pl/hausbibliothek/"
    lang={lang}
  />

  <!-- 2. Wydarzenia z biletami w stylu retro (Stitch Widget) -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#FF758F] text-xs font-bold uppercase tracking-wider mb-2">
          🎟️ Program & Kultura
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1D1B1A] dark:text-[#F5F0EE] tracking-tight">
          Najbliższe wydarzenia i spotkania
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#5B403D] dark:text-[#D4C5C2] mt-1">
          Wstąp do nas – spotkania autorskie, tandemy językowe, koncerty i warsztaty.
        </p>
      </div>

      <a
        href="/pl/events/"
        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#3A3532] text-[#8B1E2D] dark:text-[#FF758F] font-bold text-xs sm:text-sm hover:border-[#8B1E2D] hover:bg-[#FAF5EB] transition-all shadow-sm group shrink-0"
      >
        <span>Wszystkie terminy w kalendarzu</span>
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedEvents.map((event) => (
        <VintageEventTicketCard
          slug={event.slug}
          title={event.title}
          dateStart={event.date_start}
          location={event.location}
          language={event.language}
          targetGroup={event.target_group}
          description={event.description}
          image={event.image}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- 3. Drewniana Półka z Książkami (Stitch Widget) -->
  <BookshelfWidget
    lang={lang}
    title="Nowości na półce"
    subtitle="Ponad 400 dwujęzycznych książek, powieści i literatury dziecięcej w naszej bibliotece domowej."
  />

  <!-- 4. Wybór Dzielnic (Stitch Widget) -->
  <KiezHubSelector lang={lang} />

  <!-- 5. Testimonial & Community Grid -->
  <TestimonialGrid lang={lang} />

</Layout>