---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const collectionEvents = await getCollection('events');
  return collectionEvents.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'events'>;
}

function stripHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

const { entry } = Astro.props;
const lang = 'pl';

const rawDesc = entry.data.description[lang] || entry.data.description.de;
const cleanDesc = stripHtml(rawDesc);

const event = {
  slug: entry.slug,
  title: entry.data.title[lang] || entry.data.title.de,
  date_start: entry.data.date,
  location: entry.data.locationRef,
  language: entry.data.language.join(', ').toUpperCase(),
  target_group: entry.data.targetAudience[lang] || entry.data.targetAudience.de,
  descriptionHtml: rawDesc,
  descriptionPlain: cleanDesc,
  image: entry.data.image.src || '/images/events/event-sprachabend.webp',
};

// Schema.org Event JSON-LD
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.title,
  "description": event.descriptionPlain,
  "startDate": event.date_start,
  "endDate": event.date_start,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": event.location || "SprachCafé Polnisch e.V.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Schulzestraße 1",
      "addressLocality": "Berlin",
      "postalCode": "13187",
      "addressCountry": "DE"
    }
  },
  "image": [
    event.image.startsWith('http') ? event.image : `https://sprachcafe-polnisch.org${event.image}`
  ],
  "organizer": {
    "@type": "Organization",
    "name": "SprachCafé Polnisch e.V.",
    "url": "https://sprachcafe-polnisch.org/pl/"
  },
  "inLanguage": "pl"
};
---

<Layout
  title={`${event.title} — Wydarzenia — SprachCafé Polnisch`}
  description={event.descriptionPlain}
  image={event.image}
  type="event"
  lang={lang}
  jsonLd={eventJsonLd}
>
  <article
    class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto"
    data-pagefind-body
    data-pagefind-filter={`type:Event, location:${event.location}, language:${event.language}, target_group:${event.target_group}`}
  >
    <nav class="mb-8">
      <a href="/pl/events/" class="inline-flex items-center gap-2 text-sm font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
        &larr; Powrót do kalendarza wydarzeń
      </a>
    </nav>

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
      {event.image && (
        <div class="w-full h-80 sm:h-96 overflow-hidden bg-[#8B263E]/10">
          <img
            src={event.image}
            alt={event.title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
            📍 Lokalizacja: {event.location}
          </span>
          <span class="px-3 py-1 rounded-full bg-[#1b5e20]/10 text-[#1b5e20] dark:text-[#81c784] border border-[#1b5e20]/20 text-xs font-semibold">
            🗣️ Język: {event.language}
          </span>
          <span class="px-3 py-1 rounded-full bg-[#f59e0b]/15 text-[#7c4a03] dark:text-[#fde047] border border-[#f59e0b]/30 text-xs font-semibold">
            👥 Odbiorcy: {event.target_group}
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6 leading-tight">
          {event.title}
        </h1>

        <div class="bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl p-4 sm:p-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="block text-xs uppercase tracking-wider text-[#5b403d] dark:text-[#d4c5c2] mb-1 font-bold">Data & Godzina</span>
            <span class="font-sans text-lg font-bold text-[#8B263E] dark:text-[#ff758f]">
              📅 {new Date(event.date_start).toLocaleDateString('pl-PL', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
            </span>
          </div>
        </div>

        <!-- Rich Event HTML Body -->
        <div class="mb-10">
          <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
            O tym wydarzeniu
          </h2>
          <div
            class="event-rich-text font-sans text-base text-[#1d1b1a] dark:text-[#f5f0ee] leading-relaxed space-y-4"
            set:html={event.descriptionHtml}
          />
        </div>

        <div class="p-6 rounded-2xl bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Chcesz wziąć udział?</h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Wstęp wolny – serdecznie zapraszamy!</p>
          </div>
          <a
            href="/pl/kontakt/"
            class="px-6 py-3 rounded-full bg-[#8B263E] hover:bg-[#6b1d30] text-white font-bold transition-all shadow-md text-center whitespace-nowrap"
          >
            Kontakt / Zadaj pytanie
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .event-rich-text a {
    color: #8B263E;
    text-decoration: underline;
    font-weight: 600;
    word-break: break-word;
  }
  .dark .event-rich-text a {
    color: #ff758f;
  }
  .event-rich-text a:hover {
    color: #b9151e;
  }
  .event-rich-text p {
    margin-bottom: 1rem;
    line-height: 1.65;
  }
  .event-rich-text strong, .event-rich-text b {
    font-weight: 700;
  }
</style>
