---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'pl';

function stripHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

const collectionEvents = await getCollection('events');
const events = collectionEvents.map((e) => ({
  slug: e.slug,
  title: e.data.title[lang] || e.data.title.de,
  date_start: e.data.date,
  location: e.data.locationRef,
  language: e.data.language.join(', ').toUpperCase(),
  target_group: e.data.targetAudience[lang] || e.data.targetAudience.de,
  description: stripHtml(e.data.description[lang] || e.data.description.de),
  image: e.data.image.src || '/images/events/event-sprachabend.webp',
}));

const mainCalendarUrl = "https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FBerlin&showPrint=0&hl=pl&mode=AGENDA&src=NWM0M2FmNGIyNmRjMDZhMWMxZjliOTRkNDhmMTNjMzFkNTk3YmJiYjI1Y2U0YzJiZTNhMjdlZGI0NTI3NTRjOUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=YTVmMDk2YTI3YjU1YmFhODYxOGUzMGZjYjlmMWM3ZDVjNTk3YWMwMjZjYWNhZjJiODk2ODViMmMzYWMyMmI4YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ODE3YzVkNTcwN2FmY2JmMWY5ZDVhNTRmZDQxMjQ3ZGM3YzUwOTM4NTk0YjIwNjQ2MDRlY2Q2MzlhYjVmNWFlM0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ZmE5MzhhZTUyNzQ1MDBmZjFmOWY2ODNmZmI1NjI0MWU0MTQ1ODM5ZTUzZDhmNDU1NGQ1NDRmZDUzNzBhOWU3MUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=OTU4MWYwMWZlNDQxZTljZGJlNzU3M2Q2Y2U3YzY3ZjQ0NDY2NDgxMmZjMDBjYzU5MTUxMzQ5MTI1ZTBjZmM4NEBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=MTNhMTI4MjY4NzEyMjM0Y2NkMTEzOWE0Zjk2ZDUzMDY5M2Q4YmE5MmZhN2ZlYzg2NzFkNDFhYzRjNjI1MjE0YUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23f09300&color=%233f51b5&color=%237986cb&color=%237986cb&color=%234285f4&color=%23616161";

const kidsCalendarUrl = "https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FBerlin&showPrint=0&hl=pl&mode=AGENDA&src=ZmQ4MGM5ZTViZWVhZDUxMzBmN2U0NDVkMTFhMGY3ZGQzNTYwOTZhMDdkZWZhYmVkOGMyNjczZjAzM2Y5YjI1OUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=NjQ1ZmVhNDI2NTdjYjM5ODJhZThjZWQ5Mjg2MTdmYmQyNmQ5YjU3NzBjMjE3YjBkMTI1OTg5NTBlM2I5NjBhYkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ZDg4MWZlMTEwNWNlNmUyMzM2OGFkNTkwOWI0ZTU3YjJkMWU0MWNjZGEyODk5YmJhNzcyNzIzZTMyOGFjMDY0YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=MTNhMTI4MjY4NzEyMjM0Y2NkMTEzOWE0Zjk2ZDUzMDY5M2Q4YmE5MmZhN2ZlYzg2NzFkNDFhYzRjNjI1MjE0YUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%239e69af&color=%23c0ca33&color=%23009688&color=%23616161";
---

<Layout
  title="Wydarzenia & Kalendarz spotkań — SprachCafé Polnisch"
  description="Przegląd wszystkich nadchodzących spotkań językowych, wieczorów kulturalnych i wydarzeń dla dzieci w kalendarzach SprachCafé Polnisch e.V."
  lang={lang}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
        Kalendarz na żywo &amp; Synchronizacja
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-3">Wydarzenia i Spotkania</h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2] max-w-3xl">
        Odkryj nasze aktualne kawiarnie językowe, wieczory kulturalne, czytania i spotkania w interaktywnych kalendarzach naszych lokalizacji.
      </p>
    </div>

    <!-- Interactive Calendar Switcher Tabs -->
    <div class="mb-8" id="calendar-switcher">
      <div class="flex flex-wrap gap-3 border-b border-[#e7e1df] dark:border-[#363230] pb-4">
        <button
          type="button"
          id="tab-main-cal"
          class="px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer"
        >
          <span>📅 Wszystkie wydarzenia &amp; SprachCafés</span>
        </button>
        <button
          type="button"
          id="tab-kids-cal"
          class="px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer"
        >
          <span>🎈 SprachCafé dla dzieci i rodziców</span>
        </button>
      </div>

      <!-- Main Calendar Container -->
      <div id="container-main-cal" class="mt-6">
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-4 sm:p-6 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] flex items-center gap-2">
              <span>📅 Kalendarz Google:</span>
              <span class="text-[#8B263E] dark:text-[#ff758f] text-base font-normal">Wszystkie lokalizacje (Pankow, Schöneberg, Köpenick)</span>
            </h2>
            <a
              href={mainCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#8B263E] dark:text-[#ff758f] hover:underline hidden sm:inline-flex items-center gap-1 font-semibold"
            >
              Otwórz w Kalendarzu Google &nearr;
            </a>
          </div>
          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-[#e7e1df] dark:border-[#363230] bg-[#FDFBF7] dark:bg-[#181615]">
            <iframe
              src={mainCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              title="Kalendarz Google wydarzeń SprachCafé Polnisch"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Kids Calendar Container -->
      <div id="container-kids-cal" class="mt-6 hidden">
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-4 sm:p-6 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
          <div class="mb-4 p-3.5 bg-[#8B263E]/10 border border-[#8B263E]/20 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="font-serif text-base font-bold text-[#8B263E] dark:text-[#ff758f]">
                🎈 Specjalna strona: Dzieci i Rodzice
              </h2>
              <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
                Odwiedź naszą podstronę ze szczegółowymi opisami grup, wideo i formularzem zapisu!
              </p>
            </div>
            <a
              href="/pl/events/kinder-und-eltern/"
              class="px-4 py-2 rounded-xl bg-[#8B263E] text-white text-xs font-bold hover:bg-[#6b1d30] transition-colors whitespace-nowrap text-center shadow-sm"
            >
              Do oferty dla dzieci i rodziców &rarr;
            </a>
          </div>

          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-[#e7e1df] dark:border-[#363230] bg-[#FDFBF7] dark:bg-[#181615]">
            <iframe
              src={kidsCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              title="Kalendarz Google wydarzeń dla dzieci"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Heading for Synchronized CMS Events -->
    <div class="mt-16 mb-8 border-t border-[#e7e1df] dark:border-[#363230] pt-12">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
        Najbliższe wydarzenia z kalendarza
      </h2>
      <p class="text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        Poniżej znajduje się zestawienie najbliższych zaplanowanych warsztatów i spotkań.
      </p>
    </div>

    <!-- Event Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {events.slice(0, 12).map((event) => (
        <article class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative bg-[#8B263E]/10">
              <img
                src={event.image}
                alt={event.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <span class="absolute top-3 right-3 bg-black/70 backdrop-blur-md text-white text-[11px] font-bold px-2.5 py-1 rounded-full">
                {event.location}
              </span>
            </div>

            <div class="p-5">
              <div class="flex items-center gap-2 text-xs text-[#8B263E] dark:text-[#ff758f] font-bold mb-2">
                <span>📅 {new Date(event.date_start).toLocaleDateString('pl-PL', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                <span>•</span>
                <span>{new Date(event.date_start).toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' })}</span>
              </div>

              <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2 line-clamp-2">
                {event.title}
              </h3>

              <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] line-clamp-3 leading-relaxed mb-4">
                {event.description}
              </p>
            </div>
          </div>

          <div class="p-5 pt-0">
            <a
              href={`/pl/events/${event.slug}/`}
              class="block w-full py-2.5 text-center text-xs font-bold rounded-xl bg-[#f8f2f0] dark:bg-[#2a2725] text-[#8B263E] dark:text-[#ff758f] hover:bg-[#8B263E] hover:text-white transition-all border border-[#e7e1df] dark:border-[#363230]"
            >
              Szczegóły wydarzenia &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Interactive tab switching script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabMain = document.getElementById('tab-main-cal');
      const tabKids = document.getElementById('tab-kids-cal');
      const conMain = document.getElementById('container-main-cal');
      const conKids = document.getElementById('container-kids-cal');

      if (!tabMain || !tabKids || !conMain || !conKids) return;

      tabMain.addEventListener('click', () => {
        tabMain.className = 'px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer';
        tabKids.className = 'px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer';
        conMain.classList.remove('hidden');
        conKids.classList.add('hidden');
      });

      tabKids.addEventListener('click', () => {
        tabKids.className = 'px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer';
        tabMain.className = 'px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer';
        conKids.classList.remove('hidden');
        conMain.classList.add('hidden');
      });
    });
  </script>
</Layout>
