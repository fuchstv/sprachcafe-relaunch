---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'pl';

const allTeam = await getCollection('team');
const sortedTeam = allTeam.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const sections = [
  {
    id: 'vorstand',
    title: 'Zarząd Stowarzyszenia',
    subtitle: 'Kierownictwo strategiczne, koordynacja i reprezentacja stowarzyszenia',
    icon: '🏛️',
    members: sortedTeam.filter((m) => m.data.category === 'vorstand')
  },
  {
    id: 'verwaltung',
    title: 'Administracja, Finanse i IT',
    subtitle: 'Koordynacja projektów, księgowość, organizacja i infrastruktura cyfrowa',
    icon: '💼',
    members: sortedTeam.filter((m) => m.data.category === 'verwaltung')
  },
  {
    id: 'paedagogik',
    title: 'Zespół Pedagogiczny i Edukacja Językowa',
    subtitle: 'Wczesna edukacja, Klub Malucha, grupy dziecięce i kursy języka polskiego',
    icon: '🎓',
    members: sortedTeam.filter((m) => m.data.category === 'paedagogik')
  },
  {
    id: 'literatur',
    title: 'Literatura i Kreatywne Pisanie',
    subtitle: 'Spotkania autorskie, warsztaty literackie i programy kulturalne',
    icon: '📖',
    members: sortedTeam.filter((m) => m.data.category === 'literatur')
  },
  {
    id: 'kunst',
    title: 'Sztuka, Galeria i Kultura',
    subtitle: 'Wystawy, warsztaty artystyczne i spotkania międzynarodowe',
    icon: '🎨',
    members: sortedTeam.filter((m) => m.data.category === 'kunst')
  },
  {
    id: 'business',
    title: 'Rynek Pracy, Biznes i Coaching',
    subtitle: 'Reorientacja zawodowa, warsztaty AI i całościowe wsparcie doradcze',
    icon: '💡',
    members: sortedTeam.filter((m) => m.data.category === 'business')
  },
  {
    id: 'technik',
    title: 'Technika i Obsługa Sceniczna',
    subtitle: 'Zarządzanie budynkiem przy Schulzestraße oraz technika dźwiękowa i sceniczna',
    icon: '🛠️',
    members: sortedTeam.filter((m) => m.data.category === 'technik')
  },
  {
    id: 'bfd',
    title: 'Wolontariat i Służba Obywatelska (BFD)',
    subtitle: 'Aktywne wsparcie w kawiarni, przy wydarzeniach i w bibliotece domowej',
    icon: '🤝',
    members: sortedTeam.filter((m) => m.data.category === 'bfd')
  }
];

function getInitials(fullName: string): string {
  const clean = fullName.replace(/^(Dr\.|Prof\.|DBA)\s+/i, '').replace(/,/g, '').trim();
  const words = clean.split(/\s+/).filter((w) => !['und', '&', '/', 'von', 'zu', 'de', 'der', 'i'].includes(w.toLowerCase()));
  if (words.length === 0) return 'SP';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return (words[0][0] + words[words.length - 1][0]).toUpperCase();
}
---

<Layout
  title="Nasz Zespół i Zarząd — SprachCafé Polnisch e.V."
  description="Poznaj zaangażowany zespół i zarząd SprachCafé Polnisch e.V. — Zarząd, pedagodzy, animatorzy kultury, specjaliści IT i wolontariusze w Berlinie."
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>👥 Ponad 25 zaangażowanych osób dla polsko-niemieckiej społeczności</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6">
        Nasz Zespół i Zarząd
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Ludzie stojący za sukcesem SprachCafé Polnisch e.V. — Razem tworzymy przestrzeń spotkań, kultury, dwujęzyczności i integracji sąsiedzkiej w Berlinie.
      </p>
    </div>

    <!-- Category Nav / Fast Jump -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-16 max-w-4xl mx-auto">
      {sections.filter(s => s.members.length > 0).map(s => (
        <a
          href={`#${s.id}`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-[#faf6f3] dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-[#5b403d] dark:text-[#d4c5c2] hover:bg-[#8B263E] hover:text-white dark:hover:bg-[#8B263E] dark:hover:text-white transition-all shadow-sm"
        >
          <span>{s.icon}</span>
          <span>{s.title}</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-black/5 dark:bg-white/10 ml-0.5">{s.members.length}</span>
        </a>
      ))}
    </div>

    <!-- Team Sections -->
    <div class="space-y-20">
      {sections.filter(s => s.members.length > 0).map(s => (
        <section id={s.id} class="scroll-mt-24">
          <div class="flex items-center gap-3 border-b border-[#e7e1df] dark:border-[#363230] pb-4 mb-8">
            <span class="text-2xl">{s.icon}</span>
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
                {s.title}
              </h2>
              <p class="text-xs sm:text-sm text-[#5b403d] dark:text-[#d4c5c2]">
                {s.subtitle}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {s.members.map(member => {
              const role = member.data.role[lang] || member.data.role.de;
              const bio = member.data.bio?.[lang] || member.data.bio?.de;
              const photo = member.data.photo;
              const initials = getInitials(member.data.name);

              return (
                <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#8B263E]/30 transition-all flex flex-col justify-between group">
                  <div>
                    <div class="flex items-center gap-4 mb-4">
                      {photo ? (
                        <img
                          src={photo}
                          alt={member.data.name}
                          class="w-16 h-16 rounded-full object-cover border-2 border-[#8B263E]/20 group-hover:scale-105 transition-transform"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-[#8B263E]/10 to-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] font-serif font-bold text-lg flex items-center justify-center border-2 border-[#8B263E]/20">
                          {initials}
                        </div>
                      )}
                      <div>
                        <h3 class="font-serif font-bold text-base sm:text-lg text-[#1d1b1a] dark:text-[#f5f0ee] leading-snug">
                          {member.data.name}
                        </h3>
                        <p class="text-xs text-[#8B263E] dark:text-[#ff758f] font-medium mt-0.5">
                          {role}
                        </p>
                      </div>
                    </div>

                    {bio && (
                      <p class="text-xs sm:text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
                        {bio}
                      </p>
                    )}
                  </div>

                  {member.data.contact?.email && (
                    <div class="pt-3 border-t border-[#e7e1df] dark:border-[#363230] mt-auto">
                      <a
                        href={`mailto:${member.data.contact.email}`}
                        class="inline-flex items-center gap-1.5 text-xs text-[#8B263E] dark:text-[#ff758f] hover:underline font-medium"
                      >
                        <span>✉️</span>
                        <span class="truncate">{member.data.contact.email}</span>
                      </a>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <!-- Join the Team CTA -->
    <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#8B263E]/10 via-[#faf6f3] dark:via-[#22201e] to-[#026c8f]/10 border border-[#e7e1df] dark:border-[#363230] text-center max-w-3xl mx-auto space-y-6">
      <span class="text-3xl">🤝</span>
      <h2 class="font-serif text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
        Chcesz dołączyć do naszego zespołu?
      </h2>
      <p class="font-sans text-sm sm:text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Stale poszukujemy entuzjastycznych wolontariuszy, animatorów warsztatów, nauczycieli językowych oraz osób chętnych do odbycia praktyk lub służby BFD.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/pl/mitmachen/"
          class="px-6 py-3 rounded-full bg-[#8B263E] text-white font-bold text-sm hover:bg-[#6b1d30] transition-colors shadow-sm"
        >
          Działaj z nami &rarr;
        </a>
        <a
          href="/pl/kontakt/"
          class="px-6 py-3 rounded-full bg-white dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold text-sm hover:bg-[#f8f2f0] transition-colors"
        >
          Napisz do nas
        </a>
      </div>
    </div>
  </section>
</Layout>
