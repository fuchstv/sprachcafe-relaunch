---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'pl';
---

<Layout
  title="O nas — Nasze miejsca w Berlinie — SprachCafé Polnisch e.V."
  description="SprachCafé Polnisch e.V. to miejsce spotkań non-profit poświęcone kulturze, językowi i dialogowi sąsiedzkiemu w Berlinie (Pankow, Schöneberg, Köpenick). Poznaj nasze lokalizacje, kawiarnię, bibliotekę, wystawy i możliwości współpracy."
  lang={lang}
>
  <div class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto space-y-20">
    
    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold">
        <span>🏡 Miejsce spotkań od 2008 roku</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight">
        O nas
      </h1>

      <p class="font-sans text-xl sm:text-2xl text-[#8B263E] dark:text-[#ff758f] font-serif italic max-w-3xl mx-auto leading-relaxed">
        „Serdecznie zapraszamy do dalszego współkreowania Kafejki, do pobycia tu z nami i korzystania z atmosfery tych miejsc!”
      </p>
    </header>

    <!-- SECTION 1: Nasze miejsca w Berlinie (Pankow, Schöneberg, Köpenick) -->
    <section class="space-y-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
          Lokalizacje w Berlinie
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Nasze miejsca w Berlinie
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- 1. Pankow (Główna siedziba) -->
        <article id="pankow" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/header-general.jpg"
                alt="SprachCafé Pankow przy Schulzestraße 1"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
                📍 Pankow
              </span>
              <span class="text-xs font-semibold text-[#8B263E] dark:text-[#ff758f]">Główna siedziba</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé w Berlinie-Pankow
            </h3>

            <p class="font-sans text-sm font-semibold text-[#8B263E] dark:text-[#ff758f]">
              u siebie w domu: Schulzestr. 1, 13187 Berlin, tuż przy S1 / Wollankstr.
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Od stycznia 2018 roku mamy tu własną siedzibę w północnej części Berlina. Lokalizacja w dawnym pasie muru berlińskiego ma dla nas charakter symboliczny: jesteśmy prawdziwymi budowniczymi mostów między Wschodem a Zachodem, między językami, kulturami i pokoleniami ❤️🩵💚
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Godziny otwarcia:</span>
              <span>Pn–Pt 10:00 – 18:00 (podczas wydarzeń dłużej)</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Schulzestr.+1,+13187+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>🗺️ Pokaż na mapie</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:kontakt@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 2. Schöneberg -->
        <article id="schoeneberg" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/hero-collage-2.avif"
                alt="SprachCafé Schöneberg im Stadtteilzentrum"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#026c8f]/10 text-[#026c8f] dark:text-[#38bdf8] text-xs font-bold uppercase">
                📍 Schöneberg
              </span>
              <span class="text-xs font-semibold text-[#026c8f] dark:text-[#38bdf8]">Południe miasta</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé w Berlinie-Schöneberg
            </h3>

            <p class="font-sans text-sm font-semibold text-[#026c8f] dark:text-[#38bdf8]">
              c/o Stadtteilzentrum Schöneberg, Hauptstraße 121 A, 10827 Berlin
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              To nowe miejsce dla mieszkańców południowej części miasta. Pozostajemy wierni naszej społeczności i cieszymy się na nowe synergie 🩵❤️💚 Od kwietnia 2023 r. do lutego 2026 r. spotykaliśmy się przy Gotenstr. 45 tuż przy Südkreuz.
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Godziny otwarcia:</span>
              <span>Otwarte podczas zaplanowanych wydarzeń</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Hauptstra%C3%9Fe+121+A,+10827+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#026c8f] dark:text-[#38bdf8] hover:underline"
              >
                <span>🗺️ Pokaż na mapie</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:kontakt@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#026c8f] dark:text-[#38bdf8] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 3. Köpenick -->
        <article id="koepenick" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/hero-collage-3.avif"
                alt="SprachCafé Köpenick im Wiesentreff"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#1e6e23]/10 text-[#1e6e23] dark:text-[#4ade80] text-xs font-bold uppercase">
                📍 Köpenick
              </span>
              <span class="text-xs font-semibold text-[#1e6e23] dark:text-[#4ade80]">Południowy wschód</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé w Berlinie-Köpenick
            </h3>

            <p class="font-sans text-sm font-semibold text-[#1e6e23] dark:text-[#4ade80]">
              c/o Nachbarschaftstreff Wiesentreff, Am Wiesengraben 7a, 12557 Berlin
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Położone w południowo-wschodniej części miasta. W lutym 2026 r. wystartowały tu pierwsze aktywności SprachCafé, odpowiadając na liczne prośby tutejszej społeczności 💚❤️🩵
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Godziny otwarcia:</span>
              <span>Otwarte podczas zaplanowanych wydarzeń</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Am+Wiesengraben+7a,+12557+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#1e6e23] dark:text-[#4ade80] hover:underline"
              >
                <span>🗺️ Pokaż na mapie</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:kontakt@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#1e6e23] dark:text-[#4ade80] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- SECTION 2: Teilsysteme des SprachCafés -->
    <section class="space-y-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
          Oferta i Obszary
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Nasze obszary działalności
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Kawiarnia -->
        <a href="/pl/ueber-uns/begegnungscafe/" class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">☕</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
              Kawiarnia sąsiedzka
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Kawiarnia sąsiedzka z polską nutą to przestrzeń do spotkań, odpoczynku oraz idealne miejsce do pracy indywidualnej.
            </p>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 group-hover:underline">
            <span>Więcej o kawiarni &rarr;</span>
          </span>
        </a>

        <!-- Sklepik -->
        <a href="/pl/ueber-uns/kleiner-laden/" class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">🛍️</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
              Sklepik
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Nasz sklepik oferuje książki na sprzedaż, Speak-Dating-Karty, koszulki SprachCafé oraz unikalne rękodzieło.
            </p>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 group-hover:underline">
            <span>Odwiedź sklepik &rarr;</span>
          </span>
        </a>

        <!-- Wystawy & Galeria -->
        <a href="/pl/ueber-uns/ausstellungen/" class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">🎨</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
              Galeria na Schulze
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Wystawy to przestrzeń dialogu dla gości i artystów. Cykliczne wernisaże wzbogacają muzyka i literatura.
            </p>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 group-hover:underline">
            <span>Zobacz wystawy &rarr;</span>
          </span>
        </a>

        <!-- Biblioteka -->
        <a href="/pl/hausbibliothek/" class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">📚</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
              Biblioteka Domowa
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Na Schulze mamy bogatą bibliotekę polsko-niemiecką z ponad 400 pozycjami oraz cyfrowym wypożyczaniem.
            </p>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 group-hover:underline">
            <span>Katalog biblioteki &rarr;</span>
          </span>
        </a>

        <!-- Praca zespołu -->
        <a href="/pl/ueber-uns/team/" class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">👥</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
              Nasz Zespół
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Zarząd, pedagodzy, tłumacze, wolontariusze i koordynatorzy projektów zaangażowani w rozwój społeczności.
            </p>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 group-hover:underline">
            <span>Poznaj zespół &rarr;</span>
          </span>
        </a>

        <!-- Wynajem pomieszczeń -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 shadow-sm flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-3xl">🏠</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              Wynajem sal
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              U nas można wynająć pomieszczenia na seminaria, warsztaty, spotkania grupowe czy przyjęcia okolicznościowe.
            </p>
          </div>
          <a
            href="mailto:kontakt@sprachcafe-polnisch.org"
            class="inline-flex items-center gap-1 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] mt-4 hover:underline"
          >
            <span>Napisz zapytanie &rarr;</span>
          </a>
        </div>

      </div>
    </section>

    <!-- SECTION 3: Zaangażowanie & Wsparcie -->
    <section class="bg-[#faf6f3] dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 sm:p-12 space-y-6">
      <div class="max-w-3xl">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
          Ludzie tworzą miejsca… Dołącz do nas!
        </h2>
        <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-6">
          Większość rzeczy już mamy, ale stale poszukujemy wolontariuszek i wolontariuszy do opieki nad miejscami, tworzenia oferty warsztatowej, promocji inicjatywy oraz realizacji pomysłów na długofalowy rozwój.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/pl/mitmachen/"
            class="px-6 py-3 rounded-xl bg-[#8B263E] text-white font-bold text-sm hover:bg-[#6b1d30] transition-colors"
          >
            Działaj z nami
          </a>
          <a
            href="/pl/kontakt/"
            class="px-6 py-3 rounded-xl bg-white dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold text-sm hover:bg-[#f8f2f0] transition-colors"
          >
            Skontaktuj się z nami
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
