---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';

const lang = 'pl';
---

<Layout
  title="Kontakt & Godziny otwarcia — SprachCafé Polnisch"
  description="Skontaktuj się ze stowarzyszeniem SprachCafé Polnisch e.V. — Lokalizacje w Pankow, Schöneberg i Köpenick. Formularz kontaktowy, telefony i adresy e-mail."
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto space-y-16">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold">
        <span>✉️ Jesteśmy tu dla Ciebie</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight">
        Kontakt & Informacje
      </h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2] max-w-2xl mx-auto leading-relaxed">
        Masz pytania dotyczące naszych spotkań językowych, wydarzeń kulturalnych, wynajmu sal lub Biblioteki Domowej? Napisz do nas bezpośrednio.
      </p>
    </div>

    <!-- 3 Quick Contact Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-2">📍</div>
        <h3 class="font-serif font-bold text-base text-[#1d1b1a] dark:text-[#f5f0ee]">Główna siedziba</h3>
        <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-1">
          Schulzestr. 1, 13187 Berlin<br />
          (przy S1 Wollankstraße)
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-2">📞</div>
        <h3 class="font-serif font-bold text-base text-[#1d1b1a] dark:text-[#f5f0ee]">Telefon</h3>
        <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-1">
          <a href="tel:+4916099680059" class="hover:underline font-semibold text-[#8B263E] dark:text-[#ff758f]">
            +49 (0)160 9968 0059
          </a>
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 text-center shadow-sm">
        <div class="text-3xl mb-2">✉️</div>
        <h3 class="font-serif font-bold text-base text-[#1d1b1a] dark:text-[#f5f0ee]">Adres e-mail</h3>
        <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-1">
          <a href="mailto:kontakt@sprachcafe-polnisch.org" class="hover:underline font-semibold text-[#8B263E] dark:text-[#ff758f]">
            kontakt@sprachcafe-polnisch.org
          </a>
        </p>
      </div>
    </div>

    <!-- Contact Form Component -->
    <ContactForm lang={lang} />
  </section>
</Layout>
