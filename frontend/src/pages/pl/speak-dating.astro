---
import Layout from '../../layouts/Layout.astro';
import VintageEventTicketCard from '../../components/VintageEventTicketCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getCollection } from 'astro:content';

const lang = 'pl';

// 1. Fetch live Speak-Dating events from the Astro Events Collection
const allEvents = await getCollection('events');
const now = new Date();

function stripHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

// Filter for Speak-Dating specific events (upcoming or past fallback)
const speakDatingEvents = allEvents.filter((e) => {
  const title = (e.data.title.de || e.data.title.pl || e.data.title.en || '').toLowerCase();
  const slug = e.slug.toLowerCase();
  return title.includes('speak-dating') || title.includes('speak dating') || slug.includes('speak-dating');
});

const upcomingSpeakDating = speakDatingEvents
  .filter((e) => {
    const eventEnd = e.data.endDate ? new Date(e.data.endDate) : new Date(e.data.date);
    return eventEnd.getTime() >= now.getTime();
  })
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const displayEvents = (upcomingSpeakDating.length > 0 ? upcomingSpeakDating : speakDatingEvents)
  .slice(0, 3)
  .map((e) => ({
    slug: e.slug,
    title: e.data.title[lang] || e.data.title.pl || e.data.title.de,
    date_start: e.data.date,
    location: e.data.locationRef,
    language: e.data.language.join(', ').toUpperCase(),
    target_group: e.data.targetAudience[lang] || e.data.targetAudience.pl || e.data.targetAudience.de,
    description: stripHtml(e.data.description[lang] || e.data.description.pl || e.data.description.de),
    image: e.data.image?.src || '/images/illustrations/linocut-tandem.webp',
  }));

// 2. Structured Data (Schema.org)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "SPEAK-DATING w SprachCafé Polnisch e.V.",
  "description": "Wymiana językowa i spotkania tandemowe w luźnej atmosferze w Berlinie-Pankow.",
  "eventSchedule": {
    "@type": "Schedule",
    "repeatFrequency": "P2W",
    "byDay": "https://schema.org/Wednesday",
    "startTime": "19:00",
    "endTime": "20:30"
  },
  "location": {
    "@type": "Place",
    "name": "SprachCafé Polnisch e.V.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Schulzestraße 1",
      "addressLocality": "Berlin",
      "postalCode": "13187",
      "addressCountry": "DE"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "SprachCafé Polnisch e.V.",
    "url": "https://xn--sprachcaf-j4a.org/pl/"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "description": "Wstęp wolny, dobrowolne datki mile widziane"
  }
};

// 3. FAQ Items
const faqItems = [
  {
    question: {
      de: "Brauche ich Vorkenntnisse, um beim Speak-Dating mitzumachen?",
      pl: "Czy muszę posiadać znajomość języka na wysokim poziomie, by wziąć udział?",
      en: "Do I need advanced language skills to participate in Speak-Dating?"
    },
    answer: {
      de: "Nein, überhaupt nicht! Alle Niveaus von Anfänger:innen (A1) bis zu Muttersprachler:innen sind herzlich willkommen. Unsere zweisprachigen Konversationskarten bieten einfache Impulse für jedes Level.",
      pl: "Zupełnie nie! Zapraszamy osoby na każdym poziomie zaawansowania – od początkujących (A1) po native speakerów. Nasze karty konwersacyjne zawierają pytania dostosowane do każdego.",
      en: "Not at all! All language levels from beginners (A1) to native speakers are warmly welcome. Our bilingual prompt cards provide easy inspiration for all levels."
    }
  },
  {
    question: {
      de: "Muss ich mich zwingend vorher per E-Mail anmelden?",
      pl: "Czy muszę się wcześniej zapisać mailowo?",
      en: "Is prior registration via email mandatory?"
    },
    answer: {
      de: "Eine kurze Anmeldung per E-Mail an speak-dating@sprachcafe-polnisch.org hilft uns bei der Raum- und Tischplanung sehr. Sie können aber auch spontan vorbeikommen, wenn Plätze frei sind.",
      pl: "Krótkie zgłoszenie mailowe na speak-dating@sprachcafe-polnisch.org ułatwia nam organizację miejsc, ale można również dołączyć spontanicznie.",
      en: "A quick email registration to speak-dating@sprachcafe-polnisch.org helps us greatly with table planning. Spontaneous drop-ins are also welcome if space permits."
    }
  },
  {
    question: {
      de: "Welche Sprachen werden gesprochen?",
      pl: "W jakich językach rozmawiamy?",
      en: "Which languages are practiced?"
    },
    answer: {
      de: "Der Schwerpunkt liegt auf Polnisch und Deutsch. Sehr gerne werden aber auch Englisch und andere Sprachen im Tandem gesprochen – je nachdem, welche Sprachinteressierten am Abend vor Ort sind.",
      pl: "Główny nacisk kładziemy na język polski i niemiecki. Bardzo chętnie praktykujemy również język angielski i inne języki w tandemach.",
      en: "The main focus is on Polish and German. English and other languages are also enthusiastically practiced depending on who joins that evening."
    }
  },
  {
    question: {
      de: "Kostet die Teilnahme etwas?",
      pl: "Czy udział w spotkaniu jest płatny?",
      en: "Does participation cost anything?"
    },
    answer: {
      de: "Die Teilnahme ist kostenfrei! Als gemeinnütziger Verein freuen wir uns sehr über eine kleine freiwillige Barspende vor Ort für Kaffee, Tee und Raumkosten.",
      pl: "Udział jest bezpłatny! Jako stowarzyszenie pożytku publicznego będziemy wdzięczni za dobrowolny datek do puszki na miejscu na kawę, herbatę i utrzymanie lokalu.",
      en: "Participation is free of charge! As a non-profit association, we greatly appreciate voluntary donations on-site for coffee, tea, and room upkeep."
    }
  }
];
---

<Layout
  title="SPEAK-DATING — Wymiana językowa & Tandem | SprachCafé Polnisch e.V."
  description="SPEAK-DATING w Berlinie-Pankow (Schulzestr. 1): Wymiana językowa w luźnej atmosferze dla języka polskiego, niemieckiego i angielskiego. 1. i 3. środa miesiąca. Wstęp wolny!"
  lang={lang}
  image="/images/illustrations/linocut-tandem.webp"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto overflow-hidden">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-sm font-bold tracking-wide uppercase mb-6">
        <span>🗣️ Otwarta wymiana językowa & Tandem</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6 leading-[1.1]">
        SPEAK-DATING
      </h1>

      <!-- Subtitle -->
      <p class="font-sans text-lg sm:text-2xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto mb-8">
        Ucz się języków i poznawaj ciekawych ludzi w luźnej, kawiarnianej atmosferze – bez stresu i z radością z rozmowy!
      </p>

      <!-- Trust Badges Bar -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-10 text-xs sm:text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2]">
        <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-sm">
          <span>🗓️</span>
          <span>1. i 3. środa miesiąca</span>
        </div>
        <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-sm">
          <span>⏰</span>
          <span>godz. 19:00 – 20:30</span>
        </div>
        <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-sm">
          <span>📍</span>
          <span>Schulzestr. 1, Berlin-Pankow</span>
        </div>
        <div class="flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-sm">
          <span>🎟️</span>
          <span>Wstęp wolny (darowizny)</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="mailto:speak-dating@sprachcafe-polnisch.org?subject=Zgłoszenie%20Speak-Dating&body=Dzie%C5%84%20dobry%2C%0A%0Achc%C4%99%20wzi%C4%85%C4%87%20udzia%C5%82%20w%20najbli%C5%BCszym%20spotkaniu%20Speak-Dating.%0A%0AImi%C4%99%3A%20%0AJ%C4%99zyki%20(jakie%20znam%20%2F%20jakie%20chc%C4%99%20praktykowa%C4%87)%3A%20%0A%0APozdrawiam"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-[#8B1E2D] hover:bg-[#6E1420] text-white font-bold text-base shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        >
          <span>✉️ Zapisz się przez e-mail</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="#terminy"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-white dark:bg-[#24201E] hover:bg-[#FAF6EE] dark:hover:bg-[#2A2725] text-[#1d1b1a] dark:text-[#f5f0ee] border border-[#E2D8CC] dark:border-[#363230] font-bold text-base shadow-sm transition-all"
        >
          <span>📅 Zobacz najbliższe terminy</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Illustration & Concept Banner -->
  <section class="py-8 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="bg-[#FAF5EB] dark:bg-[#22201E] border border-[#E2D8CC] dark:border-[#3A3532] rounded-3xl p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-center gap-8 lg:gap-12">
      <div class="w-48 h-48 sm:w-60 sm:h-60 shrink-0 rounded-2xl overflow-hidden border border-[#DCD3C7] dark:border-[#4A423F] bg-white dark:bg-[#2A2725] p-3 shadow-inner flex items-center justify-center">
        <img
          src="/images/illustrations/linocut-tandem.webp"
          alt="Ilustracja drzeworyt / linoryt dla tandemu językowego"
          class="w-full h-full object-cover rounded-xl"
        />
      </div>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-[#8B1E2D] dark:text-[#ff758f]">
          💡 Koncepcja
        </span>
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-1 mb-4">
          Jak działa Speak-Dating?
        </h2>
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-6">
          „Speak Dating“ to wieczór w swobodnej atmosferze, umożliwiający niestandardowe podejście do nauki języków i poznawania innych kultur. 
          Uczestnicy spotkania dobierają się w pary i prowadzą krótkie konwersacje w wybranym języku na wylosowane lub wybrane przez siebie tematy.
        </p>
        
        <!-- 3 Steps Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white dark:bg-[#2A2725] p-4 rounded-2xl border border-[#E2D8CC] dark:border-[#363230]">
            <div class="text-2xl mb-2">🎴</div>
            <h4 class="font-serif font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">1. Losuj pytanie</h4>
            <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2]">Dwujęzyczna karta ułatwia rozpoczęcie ciekawej rozmowy.</p>
          </div>
          <div class="bg-white dark:bg-[#2A2725] p-4 rounded-2xl border border-[#E2D8CC] dark:border-[#363230]">
            <div class="text-2xl mb-2">⏱️</div>
            <h4 class="font-serif font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">2. Rozmawiaj w parze</h4>
            <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2]">10–15 minut wymiany po polsku, niemiecku lub angielsku.</p>
          </div>
          <div class="bg-white dark:bg-[#2A2725] p-4 rounded-2xl border border-[#E2D8CC] dark:border-[#363230]">
            <div class="text-2xl mb-2">🔄</div>
            <h4 class="font-serif font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">3. Zmień rozmówcę</h4>
            <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2]">Po sygnale zmieniamy miejsca i poznajemy kolejne osoby!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights & Pillars -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Dlaczego warto przyjść na Speak-Dating?
      </h2>
      <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2]">
        Żadnych nudnych regułek gramatycznych ani oceniania – tylko autentyczny dialog i żywy język.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-[#8B1E2D]/10 text-[#8B1E2D] dark:text-[#ff758f] flex items-center justify-center text-2xl mb-6">
          🇵🇱🇩🇪
        </div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Polski & Niemiecki</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Idealna przestrzeń do swobodnego mówienia po polsku i niemiecku. Tandemy z językiem angielskim są również mile widziane.
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-[#8B1E2D]/10 text-[#8B1E2D] dark:text-[#ff758f] flex items-center justify-center text-2xl mb-6">
          👩‍🏫
        </div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Opieka profesjonalistów</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Zajęcia prowadzą nauczycielki, tłumaczki, lingwistki i native speakerki, które chętnie wspierają i podpowiadają słownictwo.
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-[#8B1E2D]/10 text-[#8B1E2D] dark:text-[#ff758f] flex items-center justify-center text-2xl mb-6">
          ☕
        </div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Kawiarniany klimat</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Ciepła kawa, herbata i ciasteczka w przytulnym lokalu w Pankow sprawiają, że każdy czuje się jak w domu.
        </p>
      </div>

    </div>
  </section>

  <!-- Live Upcoming Dates Section -->
  <section id="terminy" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto scroll-mt-24">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-2">
          📅 Kalendarz spotkań
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Najbliższe terminy Speak-Dating
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#5b403d] dark:text-[#d4c5c2] mt-1">
          Regularnie w 1. i 3. środę miesiąca w Pankow.
        </p>
      </div>

      <a
        href="/pl/events/"
        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#3A3532] text-[#8B1E2D] dark:text-[#ff758f] font-bold text-xs sm:text-sm hover:border-[#8B1E2D] hover:bg-[#FAF5EB] transition-all shadow-sm shrink-0"
      >
        <span>Pełny kalendarz wydarzeń</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    {displayEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {displayEvents.map((event) => (
          <VintageEventTicketCard
            slug={event.slug}
            title={event.title}
            dateStart={event.date_start}
            location={event.location}
            language={event.language}
            targetGroup={event.target_group}
            description={event.description}
            image={event.image}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 text-center">
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2]">
          Aktualnie planujemy terminy na nowy sezon. Odwiedź nas wkrótce lub napisz do nas e-mail!
        </p>
      </div>
    )}
  </section>

  <!-- Speak-Dating Cards Shop Feature Teaser -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="bg-gradient-to-br from-[#8B1E2D]/5 via-[#FAF5EB] to-[#8B1E2D]/10 dark:from-[#24201E] dark:via-[#1D1B1A] dark:to-[#2A2725] border border-[#8B1E2D]/20 rounded-3xl p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-center gap-8">
      <div class="w-full md:w-1/3 shrink-0 flex items-center justify-center">
        <div class="relative w-48 h-48 sm:w-56 sm:h-56 rounded-2xl overflow-hidden shadow-xl bg-white dark:bg-[#22201e] p-3 border border-[#E2D8CC] dark:border-[#363230]">
          <img
            src="/images/shop/laden-artikel-1.webp"
            alt="Karty konwersacyjne Speak-Dating"
            class="w-full h-full object-contain"
          />
        </div>
      </div>
      <div class="w-full md:w-2/3">
        <span class="px-3 py-1 rounded-full bg-[#8B1E2D]/10 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider">
          🛍️ Do domu & na spotkania
        </span>
        <h3 class="font-serif text-2xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-2 mb-4">
          Oficjalne karty konwersacyjne Speak-Dating
        </h3>
        <p class="font-sans text-sm sm:text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-6">
          Nasz autorski, dwujęzyczny zestaw kart z pytaniami po polsku i niemiecku. 
          Świetny do własnych tandemów, wieczorów gier ze znajomymi lub na prezent!
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <span class="font-serif text-xl font-bold text-[#8B1E2D] dark:text-[#ff758f]">
            20 € <span class="text-xs font-sans text-[#5b403d] dark:text-[#d4c5c2] font-normal">(darowizna)</span>
          </span>
          <a
            href="/pl/o-nas/maly-sklep/"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#8B1E2D] hover:bg-[#6E1420] text-white font-bold text-sm transition-all shadow-sm"
          >
            <span>Zobacz w naszym sklepiku</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Location & Registration Banner -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
