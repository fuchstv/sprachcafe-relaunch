---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum - SprachCafé Polnisch e.V."
  description="Impressum und rechtliche Angaben des SprachCafé Polnisch e.V. gem. § 5 TMG / § 18 MStV."
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
        Rechtliche Angaben
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Impressum
      </h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2]">
        Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG) / § 18 Medienstaatsvertrag (MStV).
      </p>
    </div>

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-sm space-y-8 text-[#1d1b1a] dark:text-[#f5f0ee] leading-relaxed">
      
      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-6">
        <h2 class="font-serif text-2xl font-bold mb-3">Diensteanbieter</h2>
        <p class="font-bold">SprachCafé Polnisch e.V.</p>
        <p>Schulzestraße 1</p>
        <p>13187 Berlin (Pankow)</p>
        <p>Deutschland</p>
      </div>

      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-6">
        <h2 class="font-serif text-2xl font-bold mb-3">Vertretungsberechtigter Vorstand</h2>
        <p>Agata Koch (1. Vorsitzende)</p>
        <p>Elke Albers (2. Vorsitzende / Stellvertretung)</p>
        <p>Agnieszka Ghanname (Vorstand)</p>
        <p>Sandra Filip-Badura (Vorstand)</p>
        <p>Katarzyna Aniela Koziol (Vorstand)</p>
      </div>

      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-6">
        <h2 class="font-serif text-2xl font-bold mb-3">Kontakt</h2>
        <p>Telefon: +49 30 89642057</p>
        <p>E-Mail: <a href="mailto:kontakt@sprachcafe-polnisch.org" class="text-[#8B263E] dark:text-[#ff758f] font-semibold underline">kontakt@sprachcafe-polnisch.org</a></p>
        <p>Web: <a href="https://sprachcafé.org" class="text-[#8B263E] dark:text-[#ff758f] font-semibold underline">https://sprachcafé.org</a></p>
      </div>

      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-6">
        <h2 class="font-serif text-2xl font-bold mb-3">Registereintrag</h2>
        <p>Eintragung im Vereinsregister.</p>
        <p>Registergericht: Amtsgericht Charlottenburg (Berlin)</p>
        <p>Registernummer: VR 32176 B</p>
        <p class="mt-2">Gemeinnützigkeit anerkannt durch das Finanzamt für Körperschaften I Berlin.</p>
      </div>

      <div>
        <h2 class="font-serif text-2xl font-bold mb-3">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <p>Agata Koch</p>
        <p>Schulzestraße 1, 13187 Berlin</p>
      </div>

    </div>
  </section>
</Layout>
