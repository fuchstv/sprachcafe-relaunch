---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const lang = 'de';

const allTeam = await getCollection('team');
const sortedTeam = allTeam.sort((a: CollectionEntry<'team'>, b: CollectionEntry<'team'>) => (a.data.order || 99) - (b.data.order || 99));

const sections = [
  {
    id: 'vorstand',
    title: 'Vereinsvorstand',
    subtitle: 'Strategische Leitung, Koordination und Vertretung des Vereins',
    icon: '🏛️',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'vorstand')
  },
  {
    id: 'verwaltung',
    title: 'Verwaltung, Finanzen & IT',
    subtitle: 'Projektkoordination, Buchhaltung, Vereinsorganisation und digitale Infrastruktur',
    icon: '💼',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'verwaltung')
  },
  {
    id: 'paedagogik',
    title: 'Pädagogisches Team & Sprachbegleitung',
    subtitle: 'Frühförderung, Klub Malucha, Kindergruppen und Polnischkurse',
    icon: '🎓',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'paedagogik')
  },
  {
    id: 'literatur',
    title: 'Literatur & Kreatives Schreiben',
    subtitle: 'Autorenlesungen, Schreibwerkstätten und literarische Kulturprogramme',
    icon: '📖',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'literatur')
  },
  {
    id: 'kunst',
    title: 'Kunst, Galerie & Kultur',
    subtitle: 'Ausstellungen, künstlerische Workshops und internationale Begegnungen',
    icon: '🎨',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'kunst')
  },
  {
    id: 'business',
    title: 'Arbeitsmarkt, Business & Coaching',
    subtitle: 'Berufliche Neuorientierung, KI-Workshops und ganzheitliche Begleitung',
    icon: '💡',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'business')
  },
  {
    id: 'technik',
    title: 'Haustechnik & Veranstaltungstechnik',
    subtitle: 'Facility Management in der Schulzestraße sowie Ton- und Bühnentechnik',
    icon: '🛠️',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'technik')
  },
  {
    id: 'bfd',
    title: 'Bundesfreiwilligendienst (BFD)',
    subtitle: 'Aktive Unterstützung im Café, bei Veranstaltungen und in der Hausbibliothek',
    icon: '🤝',
    members: sortedTeam.filter((m: CollectionEntry<'team'>) => m.data.category === 'bfd')
  }
];

function getInitials(fullName: string): string {
  const clean = fullName.replace(/^(Dr\.|Prof\.|DBA)\s+/i, '').replace(/,/g, '').trim();
  const words = clean.split(/\s+/).filter((w) => !['und', '&', '/', 'von', 'zu', 'de', 'der'].includes(w.toLowerCase()));
  if (words.length === 0) return 'SP';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return (words[0][0] + words[words.length - 1][0]).toUpperCase();
}
---

<Layout
  title="Team & Vorstand — SprachCafé Polnisch e.V."
  description="Lernen Sie das engagierte Team und den Vorstand des SprachCafé Polnisch e.V. kennen — Vorstand, Pädagog:innen, Kulturvermittlung, IT und Freiwillige in Berlin."
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1280px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>👥 Über 25 engagierte Köpfe für die deutsch-polnische Gemeinschaft</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6">
        Unser Team & Vorstand
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Die Menschen hinter dem SprachCafé Polnisch e.V. — Gemeinsam gestalten wir Begegnung, Kultur, Zweisprachigkeit und nachbarschaftliche Integration in Berlin.
      </p>
    </div>

    <!-- Category Nav / Fast Jump -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-16 max-w-4xl mx-auto">
      {sections.filter(s => s.members.length > 0).map(s => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 rounded-full text-xs font-semibold bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] hover:text-[#8B263E] dark:hover:text-[#ff758f] transition-all shadow-sm"
        >
          {s.icon} {s.title.split(' ')[0]}
        </a>
      ))}
    </div>

    <!-- Render All Sections -->
    <div class="space-y-20">
      {sections.filter(s => s.members.length > 0).map((sec) => (
        <section id={sec.id} class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-8 border-b border-[#e7e1df] dark:border-[#363230] pb-4">
            <span class="text-3xl">{sec.icon}</span>
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
                {sec.title}
              </h2>
              <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-0.5">
                {sec.subtitle}
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {sec.members.map((member) => {
              const name = member.data.name;
              const role = member.data.role[lang] || member.data.role.de;
              const bio = member.data.bio ? (member.data.bio[lang] || member.data.bio.de) : '';
              const photo = member.data.photo;
              const email = member.data.contact?.email;
              const isRealPhoto = photo && !photo.includes('avatar-default');

              return (
                <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all group">
                  <div>
                    <!-- Portrait Photo / Avatar -->
                    <div class="w-28 h-28 rounded-2xl overflow-hidden mb-5 mx-auto bg-slate-100 dark:bg-stone-800 border-2 border-[#e7e1df] dark:border-[#363230] group-hover:border-[#8B263E] transition-colors relative shadow-inner">
                      {isRealPhoto ? (
                        <img
                          src={photo}
                          alt={name}
                          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class="w-full h-full bg-gradient-to-tr from-[#8B263E] to-[#b93252] text-white flex items-center justify-center text-2xl font-bold font-serif tracking-wider shadow-inner select-none"
                          aria-label={`Initialen: ${getInitials(name)}`}
                        >
                          {getInitials(name)}
                        </div>
                      )}
                    </div>
                    
                    <div class="text-center mb-3">
                      <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1.5 leading-snug">
                        {name}
                      </h3>
                      <span class="inline-block px-2.5 py-1 bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] rounded-full text-[11px] font-semibold leading-tight max-w-full">
                        {role}
                      </span>
                    </div>

                    {bio && (
                      <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed text-center mb-4">
                        {bio}
                      </p>
                    )}
                  </div>

                  {email && (
                    <div class="pt-3 border-t border-[#e7e1df] dark:border-[#363230] text-center mt-auto">
                      <a
                        href={`mailto:${email}`}
                        class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline break-all"
                      >
                        <span>✉️</span>
                        <span>{email}</span>
                      </a>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <!-- General Contact Callout -->
    <div class="mt-20 bg-gradient-to-r from-[#8B263E]/5 to-[#8B263E]/10 dark:from-[#8B263E]/20 dark:to-[#8B263E]/10 border border-[#8B263E]/20 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto">
      <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Möchten Sie sich in unserem Team engagieren?</h3>
      <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6 leading-relaxed">
        Wir freuen uns über neue Ideen, ehrenamtliche Unterstützung, Praktikant:innen und Kursleiter:innen!
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/mitmachen/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#8B263E] text-white text-sm font-bold hover:bg-[#6b1d30] transition-colors shadow-md"
        >
          <span>Mitmachen & Ehrenamt →</span>
        </a>
        <a
          href="/kontakt/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] text-sm font-bold hover:border-[#8B263E] transition-colors"
        >
          <span>Kontakt aufnehmen</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
