---
import Layout from '../../layouts/Layout.astro';

const lang = 'de';
---

<Layout
  title="BegegnungsCafé — SprachCafé Polnisch e.V."
  description="Das BegegnungsCafé des SprachCafé Polnisch e.V. — Raum für Begegnung, Kulturdialog, Sprachpraxis und individuelles Arbeiten in Berlin-Pankow."
  lang={lang}
>
  <div class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto space-y-12">
    
    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold">
        <span>☕ Raum für Begegnung & Kultur</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight">
        Das BegegnungsCafé
      </h1>

      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Das Café mit polnischer Note ist ein offener Raum für Begegnungen, Kommunikation, interkulturellen Austausch und individuelles Arbeiten.
      </p>
    </header>

    <!-- Details Card -->
    <div class="max-w-3xl mx-auto bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 sm:p-12 shadow-sm space-y-8">
      <div class="rounded-2xl overflow-hidden shadow-sm border border-[#e7e1df] dark:border-[#363230]">
        <img
          src="/images/hero/hero-collage-1.avif"
          alt="Begegnung und Café-Atmosphäre im SprachCafé Polnisch"
          class="w-full h-64 sm:h-80 object-cover"
        />
      </div>

      <div>
        <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
          Atmosphäre, Sprache & Gemeinschaft
        </h2>
        <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
          In unserem gemütlichen Café in der <strong>Schulzestr. 1 in Berlin-Pankow</strong> kommen Nachbarinnen und Nachbarn, Sprachbegeisterte und Kulturliebhaber zusammen. Genießen Sie eine Tasse Kaffee oder Tee, schmökern Sie in Büchern unserer Hausbibliothek oder tauschen Sie sich auf Deutsch und Polnisch aus.
        </p>
        <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Hier finden regelmäßige offene Sprachcafés, Kulturabende, Buchlesungen und Gesprächsrunden statt.
        </p>
      </div>

      <div class="border-t border-[#e7e1df] dark:border-[#363230] pt-6 space-y-4">
        <h3 class="font-bold text-sm uppercase tracking-wider text-[#1d1b1a] dark:text-[#f5f0ee]">
          Standort & Öffnungszeiten
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          <div>
            <strong>📍 Adresse:</strong><br />
            Schulzestr. 1, 13187 Berlin<br />
            (direkt an der S1 / Wollankstr.)
          </div>
          <div>
            <strong>🕒 Öffnungszeiten:</strong><br />
            Montag – Freitag: 10:00 – 18:00 Uhr<br />
            (während Veranstaltungen länger)
          </div>
        </div>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a
          href="/events/"
          class="px-7 py-3 rounded-2xl bg-[#8B263E] hover:bg-[#6e1e31] text-white font-bold text-sm transition-all shadow-md inline-flex items-center gap-2"
        >
          <span>📅 Kommende Veranstaltungen</span>
        </a>
        <a
          href="/ueber-uns/"
          class="px-7 py-3 rounded-2xl bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] font-bold text-sm transition-all inline-flex items-center gap-2"
        >
          <span>&larr; Zurück zur Übersicht</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
