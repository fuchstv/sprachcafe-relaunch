---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'de';
---

<Layout
  title="Über uns — Unsere Orte in Berlin — SprachCafé Polnisch e.V."
  description="Das SprachCafé Polnisch e.V. ist ein gemeinnütziger Begegnungsort für Kultur, Sprache und Nachbarschaft in Berlin-Pankow, Schöneberg und Köpenick. Entdecken Sie unsere Standorte, Aktivitäten, Bibliotheks- und Galerieangebote sowie Möglichkeiten zum Mitmachen und Raummieten."
  lang={lang}
>
  <div class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto space-y-20">
    
    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold">
        <span>🏡 Ort der Begegnung seit 2008</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight">
        Über uns
      </h1>

      <p class="font-sans text-xl sm:text-2xl text-[#8B263E] dark:text-[#ff758f] font-serif italic max-w-3xl mx-auto leading-relaxed">
        „Wir freuen uns auf Euch, auf den gemeinsamen Dialog und den Genuss der besonderen Atmosphäre. Seid herzlich willkommen: Zum Verweilen und Mitmachen!“
      </p>
    </header>

    <!-- SECTION 1: Unsere Orte in Berlin (Pankow, Schöneberg, Köpenick) -->
    <section class="space-y-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
          Standorte in Berlin
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Unsere Orte in Berlin
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- 1. Pankow (Hauptstandort) -->
        <article id="pankow" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/header-general.jpg"
                alt="SprachCafé Pankow in der Schulzestraße 1"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
                📍 Pankow
              </span>
              <span class="text-xs font-semibold text-[#8B263E] dark:text-[#ff758f]">Hauptstandort</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé in Berlin-Pankow
            </h3>

            <p class="font-sans text-sm font-semibold text-[#8B263E] dark:text-[#ff758f]">
              bei sich zu Hause: Schulzestr. 1, 13187 Berlin, direkt an der S1 / Wollankstr.
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Seit Januar 2018 haben wir hier unseren eigenen Ort, direkt an der S1 Bhf Wollankstraße, im Norden Berlins. Die Lage im ehemaligen Mauerstreifen hat für uns einen symbolischen Charakter: Hier sind wir echte Brückenbauer*innen zwischen Ost und West, zwischen Sprachen, Kulturen, Generationen ❤️🩵💚
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Öffnungszeiten:</span>
              <span>Mo–Fr 10:00 – 18:00 Uhr (bei Veranstaltungen länger)</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Schulzestr.+1,+13187+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>🗺️ Auf Karte zeigen</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:kontakt@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 2. Schöneberg -->
        <article id="schoeneberg" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/hero-collage-2.avif"
                alt="SprachCafé Schöneberg Treffen und Dialog"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
                📍 Schöneberg
              </span>
              <span class="text-xs font-semibold text-[#1b5e20] dark:text-[#4ade80] bg-[#1b5e20]/10 px-2 py-0.5 rounded-full">NEU</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé in Berlin-Schöneberg
            </h3>

            <p class="font-sans text-sm font-semibold text-[#8B263E] dark:text-[#ff758f]">
              c/o Stadtteilzentrum Schöneberg, Hauptstraße 121 A, 10827 Berlin
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Es ist ein neuer Ort für die Nachbarschaft im Süden der Stadt. Wir bleiben treu unserer Community hier und freuen uns auf neue Synergien 🩵❤️💚 <br /><span class="text-xs text-[#5b403d]/80 dark:text-[#d4c5c2]/80 mt-1 block">(April 2023 bis Februar 2026 waren wir in der Gotenstr. 45, 10829 Berlin, am Südkreuz).</span>
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Treffen:</span>
              <span>Während der angekündigten Veranstaltungen & Kurse</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Hauptstraße+121A,+10827+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>🗺️ Auf Karte zeigen</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:schoeneberg@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 3. Köpenick -->
        <article id="koepenick" class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between scroll-mt-24">
          <div class="space-y-4">
            <div class="h-44 rounded-2xl overflow-hidden border border-[#e7e1df] dark:border-[#363230]">
              <img
                src="/images/hero/hero-collage-3.avif"
                alt="SprachCafé Köpenick Treffen und Aktivitäten"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
                📍 Köpenick
              </span>
              <span class="text-xs font-semibold text-[#1b5e20] dark:text-[#4ade80] bg-[#1b5e20]/10 px-2 py-0.5 rounded-full">NEU</span>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              SprachCafé in Berlin-Köpenick
            </h3>

            <p class="font-sans text-sm font-semibold text-[#8B263E] dark:text-[#ff758f]">
              c/o Nachbarschaftstreff Wiesentreff, Am Wiesengraben 7a, 12557 Berlin-Köpenick
            </p>

            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Im Süd-Osten der Stadt gelegen. Im Februar 2026 starteten hier die ersten Aktivitäten des SprachCafés. Denn: Auch hier sind unsere Fans 💚❤️🩵
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#e7e1df] dark:border-[#363230] space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            <div class="flex items-start gap-2">
              <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">🕒 Treffen:</span>
              <span>Wiesentreff: während der Veranstaltungen geöffnet</span>
            </div>
            <div class="flex items-center justify-between pt-2">
              <a
                href="https://maps.google.com/?q=Am+Wiesengraben+7a,+12557+Berlin"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>🗺️ Auf Karte zeigen</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <a
                href="mailto:koepenick@sprachcafe-polnisch.org"
                class="inline-flex items-center gap-1 font-semibold text-[#8B263E] dark:text-[#ff758f] hover:underline"
              >
                <span>✉️ E-Mail</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- SECTION 2: Bereiche & Aktivitäten im SprachCafé -->
    <section class="space-y-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
          Unsere Angebote
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Was das SprachCafé bietet
        </h2>
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] mt-3">
          Vom gemütlichen Café-Gespräch über Kunst und Bücher bis hin zu Gemeinschaftsprojekten.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- 1. BegegnungsCafé -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-7 shadow-sm hover:border-[#8B263E]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4" aria-hidden="true">☕</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              BegegnungsCafé
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Das Café mit polnischer Note ist ein Raum für Begegnungen, für Kommunikation und individuelles Arbeiten.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#e7e1df] dark:border-[#363230]">
            <a href="/events/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Termine & Sprachabende</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- 2. Kleiner Laden -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-7 shadow-sm hover:border-[#8B263E]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4" aria-hidden="true">🛍️</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Kleiner Laden
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Unser kleiner Laden bietet Bücher zum Kauf und originelle handgemachte Schätze – zum Bestaunen oder auch zum Kauf für diverse Anlässe.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#e7e1df] dark:border-[#363230]">
            <a href="/ueber-uns/kleiner-laden/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Sortiment ansehen</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- 3. Galerie -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-7 shadow-sm hover:border-[#8B263E]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4" aria-hidden="true">🎨</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Galerie & Ausstellungen
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Ausstellungen als Begegnungsraum besonderer Art – für alle Besucher*innen des SprachCafés, besonders für Kreative.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#e7e1df] dark:border-[#363230]">
            <a href="/ueber-uns/ausstellungen/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Ausstellungen entdecken</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- 4. Hausbibliothek & Antiquariat -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-7 shadow-sm hover:border-[#8B263E]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4" aria-hidden="true">📚</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Hausbibliothek & Antiquariat
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Sie freuen sich auf kleine und große Leser*innen. Vorhanden sind Bücher mit Schwerpunkt Polen. Diese sind zum Ausleihen und Kaufen da. Wenn man Glück hat, kann man hier auch Autor*innen persönlich begegnen …
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#e7e1df] dark:border-[#363230]">
            <a href="/hausbibliothek/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Online-Katalog aufrufen</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- 5. Team-Arbeit -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-7 shadow-sm hover:border-[#8B263E]/50 transition-all flex flex-col justify-between md:col-span-2 lg:col-span-2">
          <div>
            <div class="text-3xl mb-4" aria-hidden="true">👥</div>
            <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
              Team-Arbeit & Kooperationen
            </h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Hier finden unsere Team-Treffen, Vorstandssitzungen, Gespräche mit Kooperationspartner*innen, individuelle Besprechungen, Fortbildungen und Coachings statt.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#e7e1df] dark:border-[#363230] flex flex-wrap gap-4">
            <a href="/ueber-uns/team/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Unser Team & Vorstand</span>
              <span>&rarr;</span>
            </a>
            <a href="/mitmachen/kooperationen/unsere-partner/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
              <span>Partnerorganisationen</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 3: Räume mieten -->
    <section class="bg-gradient-to-br from-[#8B263E]/10 via-[#8B263E]/5 to-transparent border border-[#8B263E]/20 rounded-3xl p-8 sm:p-12 shadow-sm">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B263E] text-white text-xs font-bold uppercase tracking-wider">
          <span>🏢 Raumvermietung</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
          Räume mieten
        </h2>
        <p class="font-sans text-base sm:text-lg text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
          Du kannst bei uns die Räume mieten: <strong>stundenweise</strong> – für Deine Treffen, Seminare, Workshops oder auch für eine Geburtstagsfeier.
        </p>
        <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
          <a
            href="mailto:kontakt@sprachcafe-polnisch.org?subject=Raumanfrage%20SprachCaf%C3%A9"
            class="px-8 py-3.5 rounded-2xl bg-[#8B263E] hover:bg-[#6e1e31] text-white font-bold text-sm sm:text-base transition-all shadow-md hover:shadow-lg inline-flex items-center gap-2"
          >
            <span>✉️ Kontaktiere uns!</span>
          </a>
          <a
            href="/kontakt/"
            class="px-8 py-3.5 rounded-2xl bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] font-bold text-sm sm:text-base transition-all shadow-sm inline-flex items-center gap-2"
          >
            <span>Kontaktformular öffnen</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 4: Menschen schaffen Orte … (Was gebraucht wird & Mitmachen) -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
          Gemeinschaft & Engagement
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">
          Menschen schaffen Orte …
        </h2>
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] mt-3">
          Das Meiste ist da. Gebraucht werden jederzeit noch:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-5 flex items-start gap-4 shadow-sm">
          <span class="text-2xl mt-0.5" aria-hidden="true">🛠️</span>
          <div>
            <h4 class="font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Betreuung & Pflege vor Ort</h4>
            <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
              Freiwillige zur Betreuung der Orte, Durchführung kleiner Reparaturen, Pflege und Verschönerung, die laufend anfallen.
            </p>
          </div>
        </div>

        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-5 flex items-start gap-4 shadow-sm">
          <span class="text-2xl mt-0.5" aria-hidden="true">💻</span>
          <div>
            <h4 class="font-bold text-sm text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Programm & Online-Technik</h4>
