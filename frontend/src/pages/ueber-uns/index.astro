---
import Layout from '../../layouts/Layout.astro';

const lang = 'de';
---

<Layout
  title="Über uns — SprachCafé Polnisch e.V."
  description="Das SprachCafé Polnisch e.V. ist ein gemeinnütziger Begegnungsort für Kultur, Sprache und Nachbarschaft in Berlin-Pankow, Schöneberg und Köpenick."
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>🏡 Ort der Begegnung seit 2008</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6">
        Über das SprachCafé Polnisch e.V.
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Wir verbinden Menschen unterschiedlicher Herkunft durch Sprache, Kultur und gelebte Nachbarschaft. Erfahren Sie mehr über unsere Standorte, Aktivitäten und das Team.
      </p>
    </div>

    <!-- 3 Standorte Grid -->
    <section class="mb-20">
      <h2 class="font-serif text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] text-center mb-10">
        Unsere 3 Standorte in Berlin
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pankow -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-3xl mb-4">📍</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Pankow (Hauptstandort)</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-4">Schulzestraße 1, 13187 Berlin (direkt am S-Bhf Wollankstraße)</p>
          <span class="inline-block px-3 py-1 bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] rounded-full text-xs font-semibold">Mo–Fr: 10:00 – 18:00 Uhr</span>
        </div>

        <!-- Schöneberg -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-3xl mb-4">📍</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Schöneberg</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-4">Hauptstraße 121 A / Gotenstraße 45, 10827 Berlin</p>
          <span class="inline-block px-3 py-1 bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] rounded-full text-xs font-semibold">Zu Veranstaltungen & Kursen</span>
        </div>

        <!-- Köpenick -->
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-3xl mb-4">📍</div>
          <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Köpenick</h3>
          <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-4">Am Wiesengraben 7a (Wiesentreff), 12557 Berlin</p>
          <span class="inline-block px-3 py-1 bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] rounded-full text-xs font-semibold">Zu Veranstaltungen & Kursen</span>
        </div>
      </div>
    </section>

    <!-- Sub-Pages Quick Navigation -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <a href="/ueber-uns/mission/" class="group p-6 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl shadow-sm hover:border-[#8B263E] transition-all">
        <span class="text-3xl block mb-3">🎯</span>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] transition-colors">Mission & Werte</h3>
        <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-2">Geschichte ab 2008 & Kernwerte des Vereins</p>
      </a>

      <a href="/ueber-uns/team/" class="group p-6 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl shadow-sm hover:border-[#8B263E] transition-all">
        <span class="text-3xl block mb-3">👥</span>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] transition-colors">Team & Vorstand</h3>
        <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-2">Vorstand, Verwaltung & Pädagog:innen</p>
      </a>

      <a href="/ueber-uns/frequently-asked-questions/" class="group p-6 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl shadow-sm hover:border-[#8B263E] transition-all">
        <span class="text-3xl block mb-3">❓</span>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] transition-colors">Häufige Fragen (FAQ)</h3>
        <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-2">Antworten zu Öffnungszeiten & Kursen</p>
      </a>

      <a href="/mitmachen/mitglied-werden/" class="group p-6 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl shadow-sm hover:border-[#8B263E] transition-all">
        <span class="text-3xl block mb-3">❤️</span>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] transition-colors">Mitglied werden</h3>
        <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2] mt-2">Beitragsstufen & Online-Antrag</p>
      </a>
    </section>
  </section>
</Layout>
