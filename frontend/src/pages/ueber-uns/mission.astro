---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Unsere Mission & Werte — SprachCafé Polnisch e.V."
  description="Erfahren Sie mehr über die Mission, Vision und Kernwerte des SprachCafé Polnisch e.V. in Berlin."
  lang="de"
>
  <main class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>🕊️ Mission & Leitbild</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-6">
        Unsere Mission & Werte
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Das SprachCafé Polnisch e.V. steht für lebendige Nachbarschaft, zweisprachige Förderung und den brückenbauenden Austausch zwischen der deutschen und polnischen Kultur in Berlin.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-8 shadow-sm">
        <div class="text-3xl mb-4">🗣️</div>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Sprache als Brücke</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          Förderung der Mehrsprachigkeit ab dem Kleinkindalter und offene Sprachcafés für Erwachsene.
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-8 shadow-sm">
        <div class="text-3xl mb-4">🤝</div>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Gelebte Nachbarschaft</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          Begegnungsorte in Pankow, Schöneberg und Köpenick für Familien, Senioren und Zugewanderte.
        </p>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-8 shadow-sm">
        <div class="text-3xl mb-4">📚</div>
        <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Kultur & Literatur</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          Freier Zugang zur Hausbibliothek, Autorenlesungen, Ausstellungen und Theaterworkshops.
        </p>
      </div>
    </div>

    <div class="text-center">
      <a
        href="/mitmachen/mitglied-werden/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#8B263E] text-white font-bold hover:bg-[#6b1d30] transition-colors"
      >
        <span>Mitglied werden & unterstützen</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </main>
</Layout>
