---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'de';

const exhibitions = await getCollection('exhibitions');
const sortedExhibitions = exhibitions.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
---

<Layout
  title="Kunstgalerie & Ausstellungen — SprachCafé Polnisch e.V."
  description="Entdecken Sie aktuelle und vergangene Kunstausstellungen im SprachCafé Polnisch e.V. — Malerei, Fotografie und zweisprachige Kunstprojekte in Berlin."
  lang={lang}
>
  <main class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>🎨 Begegnung durch Kunst</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6">
        Kunstgalerie & Ausstellungen
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Das SprachCafé Polnisch e.V. bietet polnischen und internationalen Künstler:innen in Berlin eine Bühne. Erleben Sie Fotografie, Malerei und Rauminstallationen.
      </p>
    </div>

    <!-- Exhibitions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {sortedExhibitions.map((exhibition) => {
        const title = exhibition.data.title[lang] || exhibition.data.title.de;
        const artist = exhibition.data.artist;
        const description = exhibition.data.description[lang] || exhibition.data.description.de;
        const coverImage = exhibition.data.gallery?.[0]?.url || '/images/exhibitions/mutige-frauen.svg';
        const slug = exhibition.slug;
        const startDateStr = exhibition.data.startDate.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
        const endDateStr = exhibition.data.endDate.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });

        return (
          <article class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="h-56 overflow-hidden relative bg-[#8B263E]/10">
                <img
                  src={coverImage}
                  alt={title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full">
                  {startDateStr} – {endDateStr}
                </div>
              </div>

              <div class="p-6">
                <span class="text-xs uppercase tracking-wider font-bold text-[#8B263E] dark:text-[#ff758f]">
                  Künstlerin / Künstler: {artist}
                </span>
                <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mt-2 mb-3 group-hover:text-[#8B263E] transition-colors">
                  {title}
                </h2>
                <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] line-clamp-3 leading-relaxed">
                  {description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0">
              <a
                href={`/ueber-uns/ausstellungen/${slug}/`}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#8B263E] dark:text-[#ff758f] group-hover:underline"
              >
                <span>Ausstellung & Galerie ansehen</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout>
