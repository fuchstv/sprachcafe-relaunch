---
import Layout from '../../../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const exhibitions = await getCollection('exhibitions');
  return exhibitions.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'exhibitions'>;
}

const { entry } = Astro.props;
const lang = 'en';

const title = entry.data.title[lang] || entry.data.title.de;
const artist = entry.data.artist;
const description = entry.data.description[lang] || entry.data.description.de;
const gallery = entry.data.gallery || [];
const startDateStr = entry.data.startDate.toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' });
const endDateStr = entry.data.endDate.toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Layout
  title={`${title} — Exhibitions — SprachCafé Polnisch e.V.`}
  description={description}
  lang={lang}
>
  <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1100px] mx-auto">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
      <a href="/en/ueber-uns/" class="hover:underline">About Us</a>
      <span>/</span>
      <a href="/en/ueber-uns/ausstellungen/" class="hover:underline">Exhibitions</a>
      <span>/</span>
      <span class="font-semibold text-[#1d1b1a] dark:text-[#f5f0ee]">{title}</span>
    </nav>

    <!-- Header Section -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-4">
        Art Exhibition
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-6 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        <div>
          <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">Artist:</span> {artist}
        </div>
        <div>
          <span class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">Exhibition Duration:</span> {startDateStr} – {endDateStr}
        </div>
      </div>
    </div>

    <!-- Description Card -->
    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 mb-16 shadow-sm">
      <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">About the Exhibition</h2>
      <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Gallery Section -->
    <div class="mb-16">
      <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-8">Artwork Gallery</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {gallery.map((imgItem) => {
          const caption = imgItem.caption ? (imgItem.caption[lang] || imgItem.caption.de) : '';
          const alt = imgItem.alt ? (imgItem.alt[lang] || imgItem.alt.de) : title;

          return (
            <div class="group bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all">
              <div class="h-64 overflow-hidden relative">
                <img
                  src={imgItem.url}
                  alt={alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              {caption && (
                <div class="p-4 bg-[#f8f2f0] dark:bg-[#2a2725] border-t border-[#e7e1df] dark:border-[#363230]">
                  <p class="font-sans text-xs text-[#5b403d] dark:text-[#d4c5c2]">{caption}</p>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Back Button -->
    <div class="text-center">
      <a
        href="/en/ueber-uns/ausstellungen/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-[#8B1E2D] text-[#8B1E2D] dark:text-[#ff758f] font-bold hover:bg-[#8B1E2D] hover:text-white transition-colors"
      >
        <span>← Back to Exhibitions Overview</span>
      </a>
    </div>
  </section>
</Layout>
