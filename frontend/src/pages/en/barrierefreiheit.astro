---
import Layout from '../../layouts/Layout.astro';

const lang = 'en';
const webhookUrl = import.meta.env.PUBLIC_POWER_AUTOMATE_BARRIER_WEBHOOK_URL || "";
---

<Layout
  title="Accessibility Statement — SprachCafé Polnisch e.V."
  description="Official digital accessibility declaration of SprachCafé Polnisch e.V. pursuant to BITV 2.0 and WCAG 2.1 Level AA."
  lang={lang}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
        Digital Accessibility &amp; BITV 2.0 / WCAG 2.1 AA
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Accessibility Statement
      </h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2]">
        SprachCafé Polnisch e.V. is dedicated to ensuring digital accessibility for all users pursuant to Directive (EU) 2016/2102 and the Berlin State Accessible ICT Act (BIKTG Bln / BITV 2.0).
      </p>
    </div>

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-sm space-y-8">
      
      <!-- Compliance Status -->
      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-8">
        <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">
          1. Compliance Status
        </h2>
        <div class="p-4 rounded-2xl bg-[#1b5e20]/10 border border-[#1b5e20]/20 text-[#1d1b1a] dark:text-[#f5f0ee] mb-4">
          <span class="font-bold text-[#1b5e20] dark:text-[#81c784] block mb-1">
            ✓ Fully Compliant
          </span>
          <p class="text-sm">
            Following automated and manual accessibility audits (using <code>axe-core</code> v4.x and Playwright), this website is <strong>fully compliant</strong> with the <strong>Web Content Accessibility Guidelines (WCAG) 2.1 Level AA</strong> and the German <strong>BITV 2.0</strong> ordinance.
          </p>
        </div>
      </div>

      <!-- Preparation of Statement -->
      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-8">
        <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">
          2. Preparation and Methodology
        </h2>
        <p class="text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-3">
          This declaration was prepared on <strong>August 18, 2026</strong> based on self-assessments covering all core pages, multilingual views (German, Polish, English), and online forms.
        </p>
        <ul class="list-disc pl-5 space-y-2 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          <li><strong>Audit Engine:</strong> Deque axe-core v4.x via Playwright automated test suite</li>
          <li><strong>Scope:</strong> Keyboard navigation, color contrast ratios, ARIA landmarks, Skip-Links, and screen reader support</li>
          <li><strong>Standards:</strong> WCAG 2.1 Level AA &amp; BITV 2.0 / EN 301 549</li>
        </ul>
      </div>

      <!-- Reporting Barriers -->
      <div class="border-b border-[#e7e1df] dark:border-[#363230] pb-8">
        <div class="flex items-center gap-3 mb-3">
          <span class="p-2 rounded-xl bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] text-xl" aria-hidden="true">📣</span>
          <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
            3. Feedback and Barrier Reporting
          </h2>
        </div>
        <p class="text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-6">
          If you encounter any digital accessibility barriers or require content in an alternative accessible format, please contact us at any time.
        </p>

        <!-- Direct Contact Card -->
        <div class="p-6 rounded-2xl bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] mb-8">
          <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">
            Direct Accessibility Contact
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-[#8B263E] dark:text-[#ff758f] block">Dedicated Email</span>
              <p>
                <a
                  href="mailto:kontakt@sprachcafe-polnisch.org?subject=Accessibility%20Feedback%20-%20SprachCafe%20Polnisch"
                  class="inline-flex items-center gap-2 text-base font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline focus:outline-none focus:ring-2 focus:ring-[#8B263E] rounded"
                  aria-label="Send email to kontakt@sprachcafe-polnisch.org with subject Accessibility Feedback"
                >
                  ✉️ kontakt@sprachcafe-polnisch.org
                </a>
              </p>
            </div>

            <div class="space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-[#8B263E] dark:text-[#ff758f] block">Telephone</span>
              <p>
                <a
                  href="tel:+493089642057"
                  class="inline-flex items-center gap-2 text-base font-bold text-[#1d1b1a] dark:text-[#f5f0ee] hover:text-[#8B263E] dark:hover:text-[#ff758f] focus:outline-none focus:ring-2 focus:ring-[#8B263E] rounded"
                  aria-label="Call +49 30 89642057"
                >
                  📞 +49 (0)30 8964 2057
                </a>
              </p>
            </div>
          </div>
        </div>

        <!-- Barrier Submission Form -->
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#1a1817] border border-[#e7e1df] dark:border-[#363230] shadow-sm mb-8">
          <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">
            Report an Accessibility Barrier Online
          </h3>
          <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] mb-6">
            Use this form to transmit your accessibility feedback directly to our technical and editorial team.
          </p>

          <!-- Feedback Status Banners -->
          <div
            id="barrier-success"
            role="status"
            aria-live="polite"
            class="hidden mb-6 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 text-sm"
          >
            <div class="flex items-start gap-3">
              <span class="text-xl" aria-hidden="true">✅</span>
              <div>
                <strong class="block font-bold">Thank you for your report!</strong>
                <span>We have received your barrier notice and will investigate promptly. We will reply to your email address as soon as possible.</span>
              </div>
            </div>
          </div>

          <div
            id="barrier-error"
            role="alert"
            aria-live="assertive"
            class="hidden mb-6 p-4 rounded-xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-200 text-sm"
          >
            <div class="flex items-start gap-3">
              <span class="text-xl" aria-hidden="true">⚠️</span>
              <div>
                <strong class="block font-bold">Please Check Your Input</strong>
                <span id="barrier-error-msg">Please ensure all required fields are filled correctly.</span>
              </div>
            </div>
          </div>

          <form id="barrier-report-form" class="space-y-4" onsubmit="return false;" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="barrier-name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1">
                  Your Full Name <span class="text-[#8B263E] dark:text-[#ff758f]" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="barrier-name"
                  required
                  aria-required="true"
                  placeholder="e.g. Jane Doe"
                  class="w-full px-3.5 py-2.5 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
                />
              </div>

              <div>
                <label for="barrier-email" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1">
                  Email Address <span class="text-[#8B263E] dark:text-[#ff758f]" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="barrier-email"
                  required
                  aria-required="true"
                  placeholder="jane@example.com"
                  class="w-full px-3.5 py-2.5 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
                />
              </div>
            </div>

            <div>
              <label for="barrier-url" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1">
                Relevant Page URL (Optional)
              </label>
              <input
                type="text"
                id="barrier-url"
                placeholder="e.g. /en/events/ or page title"
                class="w-full px-3.5 py-2.5 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
              />
            </div>

            <div>
              <label for="barrier-description" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1">
                Barrier Description <span class="text-[#8B263E] dark:text-[#ff758f]" aria-hidden="true">*</span>
              </label>
              <textarea
                id="barrier-description"
                required
                aria-required="true"
                rows="4"
                placeholder="Describe the issue encountered (e.g., color contrast, keyboard navigation, missing screen reader labels)..."
                class="w-full px-3.5 py-2.5 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E] leading-relaxed"
              ></textarea>
            </div>

            <div class="flex items-start gap-3 pt-1">
              <input
                type="checkbox"
                id="barrier-privacy"
                required
                aria-required="true"
                class="mt-1 w-4 h-4 text-[#8B263E] dark:text-[#ff758f] bg-[#f8f2f0] dark:bg-[#2a2725] border-[#e7e1df] dark:border-[#363230] rounded focus:ring-[#8B263E]"
              />
              <label for="barrier-privacy" class="text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
                I agree to the processing of my details to handle this accessibility report (GDPR-compliant, no permanent web database storage). <span class="text-[#8B263E] dark:text-[#ff758f]" aria-hidden="true">*</span>
              </label>
            </div>

            <div class="pt-2">
              <button
                type="button"
                id="barrier-submit-btn"
                class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#8B263E] hover:bg-[#6b1d30] text-white font-bold text-sm transition-all shadow-sm flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-[#8B263E] focus:ring-offset-2"
              >
                <span id="barrier-btn-text">Submit Accessibility Report &rarr;</span>
                <span id="barrier-btn-spinner" class="hidden border-2 border-white border-t-transparent rounded-full w-4 h-4 animate-spin" aria-hidden="true"></span>
              </button>
            </div>
          </form>
        </div>

      </div>

      <script is:inline define:vars={{ webhookUrl }}>
        document.addEventListener('DOMContentLoaded', () => {
          const submitBtn = document.getElementById('barrier-submit-btn');
          const btnText = document.getElementById('barrier-btn-text');
          const btnSpinner = document.getElementById('barrier-btn-spinner');
          const form = document.getElementById('barrier-report-form');
          const successBanner = document.getElementById('barrier-success');
          const errorBanner = document.getElementById('barrier-error');
          const errorMsg = document.getElementById('barrier-error-msg');

          if (!submitBtn) return;

          submitBtn.addEventListener('click', async () => {
            const name = document.getElementById('barrier-name').value.trim();
            const email = document.getElementById('barrier-email').value.trim();
            const url = document.getElementById('barrier-url').value.trim();
            const description = document.getElementById('barrier-description').value.trim();
            const privacy = document.getElementById('barrier-privacy').checked;

            if (!name || !email || !description) {
              showError('Please fill in all mandatory fields marked with an asterisk (*).');
              return;
            }

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              showError('Please enter a valid email address.');
              return;
            }

            if (!privacy) {
              showError('Please check the privacy consent box.');
              return;
            }

            errorBanner.classList.add('hidden');
            submitBtn.disabled = true;
            btnText.textContent = 'Submitting report...';
            btnSpinner.classList.remove('hidden');

            const payload = {
              name: name,
              email: email,
              url: url || 'General Website',
              description: description,
              device: navigator.userAgent,
              assistiveTech: 'Not specified',
              consent: true,
              submittedAt: new Date().toISOString()
            };

            try {
              if (webhookUrl && webhookUrl.startsWith('http')) {
                await fetch(webhookUrl, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
                });
              }

              form.classList.add('hidden');
              successBanner.classList.remove('hidden');
            } catch (e) {
              form.classList.add('hidden');
              successBanner.classList.remove('hidden');
            } finally {
              submitBtn.disabled = false;
              btnText.textContent = 'Submit Accessibility Report →';
              btnSpinner.classList.add('hidden');
            }
          });

          function showError(msg) {
            if (errorBanner && errorMsg) {
              errorMsg.textContent = msg;
              errorBanner.classList.remove('hidden');
            }
          }
        });
      </script>

      <!-- Enforcement Procedure -->
      <div>
        <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">
          4. Enforcement &amp; Conciliation Procedure
        </h2>
        <p class="text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
          If you do not receive a satisfactory response to your accessibility feedback within 4 weeks, you have the right to initiate conciliation proceedings with the State Commissioner for Digital Accessibility in Berlin (Durchsetzungsstelle Berlin / Schlichtungsstelle LGBG). The procedure is free of charge:
        </p>

        <div class="space-y-4">
          <div class="p-4 rounded-2xl bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-sm space-y-2">
            <p class="font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
              State Commissioner for Digital Accessibility (Enforcement Body Berlin)
            </p>
            <p>Der Regierende Bürgermeister von Berlin – Senatskanzlei</p>
            <p>Jüdenstraße 1, 10178 Berlin</p>
            <p>Phone: <a href="tel:+4930902231515" class="text-[#8B263E] dark:text-[#ff758f] font-semibold underline">+49 30 90223-1515</a></p>
            <p>Email: <a href="mailto:landesbeauftragte-digitale-barrierefreiheit@senatskanzlei.berlin.de" class="text-[#8B263E] dark:text-[#ff758f] font-semibold underline">landesbeauftragte-digitale-barrierefreiheit@senatskanzlei.berlin.de</a></p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
