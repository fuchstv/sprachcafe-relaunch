---
import Layout from '../../../layouts/Layout.astro';
import { getPosts } from '../../../lib/cms-api';

const lang = 'en';
const posts = await getPosts({ limit: 30, lang: 'en' });
---

<Layout
  title="Blog & Stories — SprachCafé Polnisch"
  description="Latest blog articles, community chronicles, and news from SprachCafé Polnisch e.V. in Berlin."
  lang={lang}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-semibold uppercase tracking-wider mb-3">
        Chronicle &amp; Reports
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-3">Blog &amp; News</h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2] max-w-2xl">
        Insights into our community gatherings, intercultural dialogues, initiatives, and everyday life in Berlin.
      </p>
    </div>

    <!-- Blog Posts Listing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        const plainExcerpt = post.excerpt || post.content.replace(/<[^>]+>/g, '').slice(0, 160).trim();
        return (
          <article class="bg-[#FDFBF7] dark:bg-[#22201e] border border-[#e2d8cc] dark:border-[#363230] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.05)] hover:border-[#8B1E2D]/50 transition-all duration-300 flex flex-col">
            {post.featured_image && (
              <div class="aspect-video w-full overflow-hidden bg-[#FAF6EE] dark:bg-[#2a2725] border-b border-[#e2d8cc]/60">
                <img
                  src={post.featured_image}
                  alt={post.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}

            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center gap-2 mb-3 text-xs flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] font-bold uppercase tracking-wider text-[10px]">
                  {post.category || 'News'}
                </span>
                <span class="text-[#5b403d] dark:text-[#d4c5c2] ml-auto text-xs">
                  {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>

              <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3 leading-snug hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors line-clamp-2">
                <a href={`/en/posts/${post.slug}/`}>
                  {post.title}
                </a>
              </h2>

              <p class="font-sans text-[#5b403d] dark:text-[#d4c5c2] text-sm line-clamp-3 mb-6 flex-grow leading-relaxed">
                {plainExcerpt}
              </p>

              <div class="pt-4 border-t border-[#e2d8cc]/60 dark:border-[#363230] flex items-center justify-between mt-auto">
                <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
                  {post.author || 'SprachCafé Editorial'}
                </span>
                <a
                  href={`/en/posts/${post.slug}/`}
                  class="inline-flex items-center gap-1 text-sm font-bold text-[#8B1E2D] dark:text-[#ff758f] hover:underline transition-colors"
                >
                  Read &rarr;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
