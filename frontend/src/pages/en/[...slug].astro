---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DynamicPageRenderer from '../../components/DynamicPageRenderer.astro';
import { getPageBySlug, getPostBySlug } from '../../lib/cms-api';

const { slug } = Astro.params;

// Don't intercept root or special paths
if (!slug || slug === '/' || slug === 'favicon.ico' || slug.startsWith('_')) {
  return new Response(null, { status: 404 });
}

// Clean up slug (strip trailing slashes)
const cleanSlug = slug.replace(/^\/+|\/+$/g, '');

// Intercept legal pages to guarantee static Astro pages (never overwritten by WP)
if (cleanSlug === 'privacy-policy' || cleanSlug === 'privacy' || cleanSlug === 'datenschutz' || cleanSlug === 'datenschutzerklaerung') {
  return Astro.redirect('/en/datenschutz/', 301);
}
if (cleanSlug === 'impressum' || cleanSlug === 'legal-notice') {
  return Astro.redirect('/en/impressum/', 301);
}
if (cleanSlug === 'accessibility' || cleanSlug === 'barrierefreiheit' || cleanSlug === 'accessibility-statement') {
  return Astro.redirect('/en/barrierefreiheit/', 301);
}
if (cleanSlug === '2026-2' || cleanSlug === 'events' || cleanSlug === 'veranstaltungen') {
  return Astro.redirect('/en/events/', 301);
}
if (cleanSlug === 'library' || cleanSlug === 'hausbibliothek' || cleanSlug === 'biblioteka') {
  return Astro.redirect('/en/hausbibliothek/', 301);
}
if (cleanSlug === 'team-work') {
  return Astro.redirect('/en/mitmachen/', 301);
}
if (cleanSlug === 'team-work/donations' || cleanSlug === 'donations') {
  return Astro.redirect('/en/spenden/', 301);
}
if (cleanSlug.startsWith('kategorie/') || cleanSlug.startsWith('category/')) {
  return Astro.redirect('/en/posts/', 301);
}
if (cleanSlug === 'news' || cleanSlug === 'blog') {
  return Astro.redirect('/en/posts/', 301);
}

// Check if the path matches WordPress date-based post permalink: YYYY/MM/post-name
const datePostMatch = cleanSlug.match(/^\d{4}\/\d{2}\/([a-z0-9_-]+)$/i);
const postSlug = datePostMatch ? datePostMatch[1] : cleanSlug;

let page = await getPageBySlug(cleanSlug, 'en');

if (!page) {
  // Check if it's a WordPress post
  const post = await getPostBySlug(postSlug, 'en');
  if (post) {
    return Astro.redirect(`/en/posts/${post.slug}/`, 301);
  }
  return new Response(null, {
    status: 404,
    statusText: 'Page not found'
  });
}
---

<DynamicPageRenderer slug={cleanSlug} lang="en" defaultTitle={page.title} badge="SprachCafé Polnisch">
  <Layout
    title={`${page.title} — SprachCafé Polnisch`}
    description={page.blocks?.[0]?.body?.replace(/<[^>]+>/g, '').slice(0, 160).trim()}
    lang="en"
  >
    <main class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <header class="mb-10 text-center sm:text-left">
        <span class="inline-block px-3.5 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] font-bold uppercase text-xs tracking-wider mb-3">
          SprachCafé Polnisch
        </span>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight mb-4">
          {page.title}
        </h1>
        <div class="h-1 w-20 bg-[#8B1E2D] rounded-full"></div>
      </header>

      <div class="bg-[#FDFBF7] dark:bg-[#22201e] border border-[#e2d8cc] dark:border-[#363230] rounded-3xl p-6 sm:p-12 shadow-[0_4px_24px_rgba(51,49,48,0.06)]">
        <div class="wp-gutenberg-content prose prose-lg prose-warm max-w-none text-[#1d1b1a] dark:text-[#f5f0ee] leading-relaxed font-sans" set:html={page.blocks?.[0]?.body || ''} />
      </div>
    </main>
  </Layout>
</DynamicPageRenderer>

<style is:global>
  /* Gutenberg Block Typography & Polish Poster Styling */
  .wp-gutenberg-content p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }
  .wp-gutenberg-content h2 {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.85rem;
    font-weight: 700;
    color: #8B1E2D;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .wp-gutenberg-content h3 {
    font-family: 'Literata', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1d1b1a;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .wp-gutenberg-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .wp-gutenberg-content li {
    margin-bottom: 0.5rem;
  }
  .wp-gutenberg-content a {
    color: #8B1E2D;
    text-decoration: underline;
    font-weight: 600;
  }
  .wp-gutenberg-content figure.wp-block-image {
    margin: 2rem auto;
    max-width: 100%;
  }
  .wp-gutenberg-content figure.wp-block-image img {
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    height: auto;
    max-width: 100%;
  }
  .wp-gutenberg-content figure.wp-block-image figcaption {
    text-align: center;
    font-size: 0.875rem;
    color: #5b403d;
    margin-top: 0.5rem;
    font-style: italic;
  }
  .wp-gutenberg-content .wp-block-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }
  .wp-gutenberg-content .wp-block-button__link {
    display: inline-block;
    background-color: #8B1E2D;
    color: #ffffff !important;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(139, 30, 45, 0.2);
    transition: all 0.2s ease-in-out;
  }
  .wp-gutenberg-content .wp-block-button__link:hover {
    background-color: #721824;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(139, 30, 45, 0.3);
  }
  .wp-gutenberg-content blockquote {
    border-left: 4px solid #8B1E2D;
    padding-left: 1.25rem;
    font-style: italic;
    color: #5b403d;
    margin: 1.5rem 0;
  }
  .dark .wp-gutenberg-content blockquote {
    color: #d4c5c2;
    border-left-color: #ff758f;
  }
  .dark .wp-gutenberg-content h2 {
    color: #ff758f;
  }
  .dark .wp-gutenberg-content h3 {
    color: #f5f0ee;
  }
  .dark .wp-gutenberg-content a {
    color: #ff758f;
  }
</style>
