---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const lang = 'de';
const pageData = await getEntry('pages', 'mehrsprachigkeit');
const title = pageData?.data.title[lang] || "Mehrsprachigkeit — SprachCafé Polnisch e.V.";
---

<Layout
  title={title}
  description="Beratung, Sprachcafés und Angebote zur zweisprachigen Erziehung (Deutsch-Polnisch) beim SprachCafé Polnisch e.V. in Berlin."
  lang={lang}
>
  <main class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <!-- Hero Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-sm font-semibold mb-6">
        <span>🗣️ Vielfalt & Zweisprachigkeit</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6">
        Mehrsprachigkeit & Sprachberatung
      </h1>
      <p class="font-sans text-lg sm:text-xl text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed max-w-3xl mx-auto">
        Mehrsprachiges Aufwachsen ist ein Geschenk und eine Bereicherung. Wir unterstützen Familien, Kinder und Erwachsene mit Beratung, Sprachcafés und Literatur.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm">
        <div class="text-4xl mb-4">👶</div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Kinder & Familien</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
          Zweisprachiges Vorlesen, Spielgruppen und Eltern-Beratung zur Förderung von Deutsch und Polnisch im Alltag.
        </p>
        <span class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f]">Frühkindliche Sprachförderung</span>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm">
        <div class="text-4xl mb-4">☕</div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Offene Sprachcafés</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
          Ungezwungene Konversationsrunden in entspannter Atmosphäre zum Üben von Polnisch und Deutsch.
        </p>
        <span class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f]">Für jedes Sprachniveau</span>
      </div>

      <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8 shadow-sm">
        <div class="text-4xl mb-4">📚</div>
        <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3">Hausbibliothek</h3>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed mb-4">
          Über 400 zweisprachige Kinderbücher, Romane und Sprachlernmaterialien zur kostenlosen Ausleihe.
        </p>
        <a href="/hausbibliothek/" class="text-xs font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline">
          Zur Hausbibliothek →
        </a>
      </div>
    </div>

    <!-- Contact Banner -->
    <div class="bg-gradient-to-r from-[#8B263E]/5 to-[#8B263E]/10 dark:from-[#8B263E]/20 dark:to-[#8B263E]/10 border border-[#8B263E]/20 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto">
      <h3 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Persönliche Sprachberatung vereinbaren</h3>
      <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6 leading-relaxed">
        Sie haben Fragen zur zweisprachigen Erziehung Ihres Kindes oder suchen einen passenden Sprachkurs? Sprechen Sie uns an!
      </p>
      <a
        href="/kontakt/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#8B263E] text-white font-bold hover:bg-[#6b1d30] transition-colors"
      >
        <span>Beratung anfragen</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </main>
</Layout>
