---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/cms-api';
import type { PostItem } from '../../types/cms';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: PostItem;
}

const { post } = Astro.props;

// Schema.org BlogPosting / Article JSON-LD
const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.content.slice(0, 160),
  "datePublished": post.date,
  "dateModified": post.date,
  "author": {
    "@type": "Organization",
    "name": post.author || "SprachCafé Polnisch e.V.",
    "url": "https://sprachcafe-polnisch.org"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SprachCafé Polnisch e.V.",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sprachcafe-polnisch.org/brand-assets/logo.png"
    }
  },
  "image": post.featured_image ? (post.featured_image.startsWith('http') ? post.featured_image : `https://sprachcafe-polnisch.org${post.featured_image}`) : "https://sprachcafe-polnisch.org/brand-assets/logo.png",
  "inLanguage": "de"
};
---

<Layout
  title={`${post.title} - SprachCafé Polnisch`}
  description={post.content.slice(0, 160)}
  image={post.featured_image}
  type="article"
  jsonLd={postJsonLd}
>
  <article
    class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto"
    data-pagefind-body
    data-pagefind-filter={`type:Post, category:${post.category}, location:${post.location_tag || 'Global'}`}
  >
    <nav class="mb-8">
      <a href="/posts/" class="inline-flex items-center gap-2 text-sm font-bold text-[#DD3333] dark:text-[#ff6b6b] hover:underline">
        &larr; Zurück zur Übersicht
      </a>
    </nav>

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4 text-sm flex-wrap">
        <span class="px-3 py-1 rounded-full bg-[#DD3333]/10 border border-[#DD3333]/20 text-[#DD3333] dark:text-[#ff6b6b] font-bold uppercase text-xs">
          {post.category}
        </span>
        {post.location_tag && (
          <span class="px-3 py-1 rounded-full bg-[#f8f2f0] dark:bg-[#2a2725] text-[#5b403d] dark:text-[#d4c5c2] border border-[#e7e1df] dark:border-[#363230] text-xs font-semibold">
            📍 {post.location_tag}
          </span>
        )}
        <time datetime={post.date} class="text-[#5b403d] dark:text-[#d4c5c2] text-xs font-medium ml-auto">
          {new Date(post.date).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight leading-tight mb-4">
        {post.title}
      </h1>

      <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        Veröffentlicht von <span class="text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold">{post.author || 'SprachCafé Redaktion'}</span>
      </p>
    </header>

    {post.featured_image && (
      <div class="w-full h-80 sm:h-96 rounded-3xl overflow-hidden bg-[#f8f2f0] dark:bg-[#2a2725] mb-10 border border-[#e7e1df] dark:border-[#363230] shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
        <img src={post.featured_image} alt={post.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
      <div class="font-sans text-[#1d1b1a] dark:text-[#f5f0ee] text-lg leading-relaxed space-y-6">
        <p>{post.content}</p>
      </div>
    </div>
  </article>
</Layout>
