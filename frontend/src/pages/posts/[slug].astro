---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/cms-api';
import type { PostItem } from '../../types/cms';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: PostItem;
}

const { post } = Astro.props;
---

<Layout title={`${post.title} - SprachCafé Polnisch`} description={post.content.slice(0, 160)}>
  <article class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <nav class="mb-8">
      <a href="/posts/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-primary-light hover:underline">
        &larr; Zurück zur Übersicht
      </a>
    </nav>

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4 text-sm">
        <span class="px-3 py-1 rounded-full bg-rose-950/80 border border-rose-800/50 text-rose-300 font-bold uppercase text-xs">
          {post.category}
        </span>
        {post.location_tag && (
          <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-semibold">
            📍 {post.location_tag}
          </span>
        )}
        <time datetime={post.date} class="text-slate-400 text-xs font-medium ml-auto">
          {new Date(post.date).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {post.title}
      </h1>

      <p class="text-sm text-slate-400">
        Veröffentlicht von <span class="text-slate-200 font-semibold">{post.author || 'SprachCafé Redaktion'}</span>
      </p>
    </header>

    {post.featured_image && (
      <div class="w-full h-80 sm:h-96 rounded-3xl overflow-hidden bg-slate-900 mb-10 border border-slate-800 shadow-2xl">
        <img src={post.featured_image} alt={post.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="bg-brand-surface border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl">
      <div class="prose prose-invert max-w-none text-brand-text-muted text-lg leading-relaxed space-y-6">
        <p>{post.content}</p>
      </div>
    </div>
  </article>
</Layout>
