---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/cms-api';

const posts = await getPosts();
---

<Layout title="Blog - SprachCafé Polnisch" description="Aktuelle Blog-Einträge, Berichte und Neuigkeiten aus dem SprachCafé Polnisch e.V.">
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Blog & Neuigkeiten
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3">Blog</h1>
      <p class="text-lg text-brand-text-muted max-w-2xl">
        Aktuelle Blog-Einträge, Berichte und Geschichten aus unserem Vereinsleben, Projekten und der Hausbibliothek.
      </p>
    </div>

    <!-- Blog Posts Listing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
        <article class="bg-brand-surface border border-slate-800 rounded-2xl overflow-hidden shadow-xl hover:border-slate-700 transition-all duration-300 flex flex-col">
          {post.featured_image && (
            <div class="aspect-video w-full overflow-hidden bg-slate-900">
              <img
                src={post.featured_image}
                alt={post.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
          )}

          <div class="p-6 sm:p-8 flex flex-col flex-grow">
            <div class="flex items-center gap-3 mb-3 text-xs">
              <span class="px-2.5 py-0.5 rounded-md bg-rose-950/60 border border-rose-800/40 text-rose-300 font-bold uppercase">
                {post.category || 'Blog'}
              </span>
              {post.location_tag && (
                <span class="px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-300">
                  📍 {post.location_tag}
                </span>
              )}
              <span class="text-slate-400 ml-auto">
                {new Date(post.date).toLocaleDateString('de-DE', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
            </div>

            <h2 class="text-2xl font-bold text-white mb-3 leading-snug hover:text-brand-primary-light transition-colors">
              <a href={`/posts/${post.slug}/`}>
                {post.title}
              </a>
            </h2>

            <p class="text-brand-text-muted text-sm line-clamp-3 mb-6 flex-grow leading-relaxed">
              {post.content}
            </p>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
              <span class="text-xs text-slate-400">
                Von {post.author || 'SprachCafé Redaktion'}
              </span>
              <a
                href={`/posts/${post.slug}/`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand-primary-light hover:text-white transition-colors"
              >
                Weiterlesen &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
