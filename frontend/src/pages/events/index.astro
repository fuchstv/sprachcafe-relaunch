const kidsCalendarUrl = "https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FBerlin&showPrint=0&hl=de&mode=AGENDA&src=ZmQ4MGM5ZTViZWVhZDUxMzBmN2U0NDVkMTFhMGY3ZGQzNTYwOTZhMDdkZWZhYmVkOGMyNjczZjAzM2Y5YjI1OUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=NjQ1ZmVhNDI2NTdjYjM5ODJhZThjZWQ5Mjg2MTdmYmQyNmQ5YjU3NzBjMjE3YjBkMTI1OTg5NTBlM2I5NjBhYkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ZDg4MWZlMTEwNWNlNmUyMzM2OGFkNTkwOWI0ZTU3YjJkMWU0MWNjZGEyODk5YmJhNzcyNzIzZTMyOGFjMDY0YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=MTNhMTI4MjY4NzEyMjM0Y2NkMTEzOWE0Zjk2ZDUzMDY5M2Q4YmE5MmZhN2ZlYzg2NzFkNDFhYzRjNjI1MjE0YUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%239e69af&color=%23c0ca33&color=%23009688&color=%23616161";
---

<Layout title="Veranstaltungen - SprachCafé Polnisch" description="Übersicht aller kommenden Sprachcafés, Kulturabende und Kinderveranstaltungen in den Live Google-Kalendern des SprachCafé Polnisch e.V.">
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-xs font-semibold uppercase tracking-wider mb-3">
        Live-Kalender & Synchronisation
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-3">Veranstaltungen</h1>
      <p class="text-lg text-brand-text-muted max-w-3xl">
        Entdecken Sie unsere aktuellen Sprachcafés, Kulturabende, Lesungen und Treffen in den Live-Kalendern unserer Standorte.
      </p>
    </div>

    <!-- Interactive Calendar Switcher Tabs -->
    <div class="mb-8" id="calendar-switcher">
      <div class="flex flex-wrap gap-3 border-b border-slate-800 pb-4">
        <button
          type="button"
          id="tab-main-cal"
          class="px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-sky-500 text-slate-950 shadow-lg shadow-sky-500/20 flex items-center gap-2 cursor-pointer"
        >
          <span>📅 Alle Veranstaltungen & SprachCafés</span>
        </button>
        <button
          type="button"
          id="tab-kids-cal"
          class="px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white flex items-center gap-2 cursor-pointer"
        >
          <span>🎈 SprachCafé für Kinder</span>
        </button>
      </div>

      <!-- Main Calendar Container -->
      <div id="container-main-cal" class="mt-6">
        <div class="bg-brand-surface border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>📅 Google Kalender:</span>
              <span class="text-brand-primary-light text-base font-normal">Alle Standorte (Pankow, Schöneberg, Köpenick)</span>
            </h2>
            <a
              href={mainCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-sky-400 hover:underline hidden sm:inline-flex items-center gap-1"
            >
              In Google Kalender öffnen &nearr;
            </a>
          </div>
          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-slate-800 bg-slate-950">
            <iframe
              src={mainCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              frameborder="0"
              scrolling="no"
              title="Google Kalender Veranstaltungen SprachCafé Polnisch"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Kids Calendar Container -->
      <div id="container-kids-cal" class="mt-6 hidden">
        <div class="bg-brand-surface border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>🎈 Google Kalender:</span>
              <span class="text-brand-primary-light text-base font-normal">SprachCafé für Kinder & Familien</span>
            </h2>
            <a
              href={kidsCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-sky-400 hover:underline hidden sm:inline-flex items-center gap-1"
            >
              In Google Kalender öffnen &nearr;
            </a>
          </div>
          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-slate-800 bg-slate-950">
            <iframe
              src={kidsCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              frameborder="0"
              scrolling="no"
              title="Google Kalender SprachCafé für Kinder"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Events Grid -->
    {events.length > 0 && (
      <div class="mt-16 pt-12 border-t border-slate-800/80">
        <h2 class="text-2xl font-bold text-white mb-6">Highlight-Veranstaltungen</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event) => (
            <article class="bg-brand-surface border border-slate-800 rounded-2xl overflow-hidden shadow-xl hover:border-slate-700 transition-all duration-300 flex flex-col">
              {event.image && (
                <div class="aspect-video w-full overflow-hidden bg-slate-900">
                  <img
                    src={event.image}
                    alt={event.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
              )}
              
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2.5 py-0.5 rounded-md bg-slate-700/80 text-brand-primary-light text-xs font-semibold">
                    📍 {event.location}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-300 text-xs font-medium">
                    🗣️ {event.language}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-300 text-xs font-medium">
                    👥 {event.target_group}
                  </span>
                </div>

                <h3 class="text-xl font-bold text-white mb-2 leading-snug hover:text-brand-primary-light transition-colors">
                  <a href={`/events/${event.slug}/`}>
                    {event.title}
                  </a>
                </h3>

                <p class="text-xs text-sky-400 font-semibold mb-3">
                  📅 {new Date(event.date_start).toLocaleDateString('de-DE', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })} Uhr
                </p>

                <p class="text-sm text-brand-text-muted line-clamp-3 mb-6 flex-grow leading-relaxed">
                  {event.description}
                </p>

                <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                  <span class="text-xs text-slate-400">
                    {event.max_participants ? `Max. ${event.max_participants} Plätze` : 'Ohne Anmeldung'}
                  </span>
                  <a
                    href={`/events/${event.slug}/`}
                    class="inline-flex items-center gap-1 text-sm font-semibold text-brand-primary-light hover:text-white transition-colors"
                  >
                    Details & Anmeldung &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>

  <script>
    const tabMain = document.getElementById('tab-main-cal');
    const tabKids = document.getElementById('tab-kids-cal');
    const containerMain = document.getElementById('container-main-cal');
    const containerKids = document.getElementById('container-kids-cal');

    if (tabMain && tabKids && containerMain && containerKids) {
      tabMain.addEventListener('click', () => {
        tabMain.className = 'px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-sky-500 text-slate-950 shadow-lg shadow-sky-500/20 flex items-center gap-2 cursor-pointer';
        tabKids.className = 'px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white flex items-center gap-2 cursor-pointer';
        containerMain.classList.remove('hidden');
        containerKids.classList.add('hidden');
      });

      tabKids.addEventListener('click', () => {
        tabKids.className = 'px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-sky-500 text-slate-950 shadow-lg shadow-sky-500/20 flex items-center gap-2 cursor-pointer';
        tabMain.className = 'px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white flex items-center gap-2 cursor-pointer';
        containerKids.classList.remove('hidden');
        containerMain.classList.add('hidden');
      });
    }
  </script>
</Layout>
