---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'de';

function stripHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<[^>]*>?/gm, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

const collectionEvents = await getCollection('events');
const events = collectionEvents.map((e) => ({
  slug: e.slug,
  title: e.data.title[lang] || e.data.title.de,
  date_start: e.data.date,
  location: e.data.locationRef,
  language: e.data.language.join(', ').toUpperCase(),
  target_group: e.data.targetAudience[lang] || e.data.targetAudience.de,
  description: stripHtml(e.data.description[lang] || e.data.description.de),
  image: e.data.image.src || '/images/events/default-event.svg',
}));

const mainCalendarUrl = "https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FBerlin&showPrint=0&hl=de&mode=AGENDA&src=NWM0M2FmNGIyNmRjMDZhMWMxZjliOTRkNDhmMTNjMzFkNTk3YmJiYjI1Y2U0YzJiZTNhMjdlZGI0NTI3NTRjOUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=YTVmMDk2YTI3YjU1YmFhODYxOGUzMGZjYjlmMWM3ZDVjNTk3YWMwMjZjYWNhZjJiODk2ODViMmMzYWMyMmI4YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ODE3YzVkNTcwN2FmY2JmMWY5ZDVhNTRmZDQxMjQ3ZGM3YzUwOTM4NTk0YjIwNjQ2MDRlY2Q2MzlhYjVmNWFlM0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ZmE5MzhhZTUyNzQ1MDBmZjFmOWY2ODNmZmI1NjI0MWU0MTQ1ODM5ZTUzZDhmNDU1NGQ1NDRmZDUzNzBhOWU3MUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=OTU4MWYwMWZlNDQxZTljZGJlNzU3M2Q2Y2U3YzY3ZjQ0NDY2NDgxMmZjMDBjYzU5MTUxMzQ5MTI1ZTBjZmM4NEBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=MTNhMTI4MjY4NzEyMjM0Y2NkMTEzOWE0Zjk2ZDUzMDY5M2Q4YmE5MmZhN2ZlYzg2NzFkNDFhYzRjNjI1MjE0YUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23f09300&color=%233f51b5&color=%237986cb&color=%237986cb&color=%234285f4&color=%23616161";

const kidsCalendarUrl = "https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FBerlin&showPrint=0&hl=de&mode=AGENDA&src=ZmQ4MGM5ZTViZWVhZDUxMzBmN2U0NDVkMTFhMGY3ZGQzNTYwOTZhMDdkZWZhYmVkOGMyNjczZjAzM2Y5YjI1OUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=NjQ1ZmVhNDI2NTdjYjM5ODJhZThjZWQ5Mjg2MTdmYmQyNmQ5YjU3NzBjMjE3YjBkMTI1OTg5NTBlM2I5NjBhYkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=ZDg4MWZlMTEwNWNlNmUyMzM2OGFkNTkwOWI0ZTU3YjJkMWU0MWNjZGEyODk5YmJhNzcyNzIzZTMyOGFjMDY0YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&src=MTNhMTI4MjY4NzEyMjM0Y2NkMTEzOWE0Zjk2ZDUzMDY5M2Q4YmE5MmZhN2ZlYzg2NzFkNDFhYzRjNjI1MjE0YUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%239e69af&color=%23c0ca33&color=%23009688&color=%23616161";
---

<Layout title="Veranstaltungen - SprachCafé Polnisch" description="Übersicht aller kommenden Sprachcafés, Kulturabende und Kinderveranstaltungen in den Live Google-Kalendern des SprachCafé Polnisch e.V.">
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
        Live-Kalender & Synchronisation
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-3">Veranstaltungen</h1>
      <p class="font-sans text-lg text-[#5b403d] dark:text-[#d4c5c2] max-w-3xl">
        Entdecken Sie unsere aktuellen Sprachcafés, Kulturabende, Lesungen und Treffen in den Live-Kalendern unserer Standorte.
      </p>
    </div>

    <!-- Interactive Calendar Switcher Tabs -->
    <div class="mb-8" id="calendar-switcher">
      <div class="flex flex-wrap gap-3 border-b border-[#e7e1df] dark:border-[#363230] pb-4">
        <button
          type="button"
          id="tab-main-cal"
          class="px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer"
        >
          <span>📅 Alle Veranstaltungen & SprachCafés</span>
        </button>
        <button
          type="button"
          id="tab-kids-cal"
          class="px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer"
        >
          <span>🎈 SprachCafé für Kinder</span>
        </button>
      </div>

      <!-- Main Calendar Container -->
      <div id="container-main-cal" class="mt-6">
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-4 sm:p-6 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] flex items-center gap-2">
              <span>📅 Google Kalender:</span>
              <span class="text-[#8B263E] dark:text-[#ff758f] text-base font-normal">Alle Standorte (Pankow, Schöneberg, Köpenick)</span>
            </h2>
            <a
              href={mainCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#8B263E] dark:text-[#ff758f] hover:underline hidden sm:inline-flex items-center gap-1 font-semibold"
            >
              In Google Kalender öffnen &nearr;
            </a>
          </div>
          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-[#e7e1df] dark:border-[#363230] bg-[#FDFBF7] dark:bg-[#181615]">
            <iframe
              src={mainCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              title="Google Kalender Veranstaltungen SprachCafé Polnisch"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Kids Calendar Container -->
      <div id="container-kids-cal" class="mt-6 hidden">
        <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-4 sm:p-6 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
          <div class="mb-4 p-3.5 bg-[#8B263E]/10 border border-[#8B263E]/20 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="text-xs sm:text-sm text-[#8B263E] dark:text-[#ff758f]">
              <strong>✨ Kursübersicht &amp; Anmeldung:</strong> Alle Details zu Kinderkursen, Eltern-Community &amp; Online-Anmeldung finden Sie auf unserer Spezialseite.
            </div>
            <a
              href="/events/kinder-und-eltern/"
              class="px-4 py-2 rounded-xl bg-[#8B263E] text-white text-xs font-bold hover:bg-[#6e1e31] transition-colors shrink-0 shadow-sm flex items-center justify-center gap-1.5"
            >
              <span>Zur Kinder &amp; Eltern Seite &rarr;</span>
            </a>
          </div>

          <div class="flex items-center justify-between mb-4">
            <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] flex items-center gap-2">
              <span>🎈 Google Kalender:</span>
              <span class="text-[#8B263E] dark:text-[#ff758f] text-base font-normal">SprachCafé für Kinder &amp; Familien</span>
            </h2>
            <a
              href={kidsCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#8B263E] dark:text-[#ff758f] hover:underline hidden sm:inline-flex items-center gap-1 font-semibold"
            >
              In Google Kalender öffnen &nearr;
            </a>
          </div>
          <div class="w-full aspect-[4/3] sm:aspect-[16/9] min-h-[500px] sm:min-h-[600px] rounded-xl overflow-hidden border border-[#e7e1df] dark:border-[#363230] bg-[#FDFBF7] dark:bg-[#181615]">
            <iframe
              src={kidsCalendarUrl}
              style="border:0;"
              width="100%"
              height="100%"
              title="Google Kalender SprachCafé für Kinder"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Events Grid -->
    {events.length > 0 && (
      <div class="mt-16 pt-12 border-t border-[#e7e1df] dark:border-[#363230]">
        <h2 class="font-serif text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-6">Highlight-Veranstaltungen</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {events.map((event) => (
            <article class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.05)] hover:border-[#8B263E]/50 transition-all duration-300 flex flex-col">
              {event.image && (
                <div class="aspect-video w-full overflow-hidden bg-[#8B263E]/10">
                  <img
                    src={event.image}
                    alt={event.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    onerror="this.src='/images/events/default-event.svg'"
                  />
                </div>
              )}
              
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class="px-2.5 py-0.5 rounded-full bg-[#f8f2f0] dark:bg-[#2a2725] text-[#8B263E] dark:text-[#ff758f] text-xs font-semibold border border-[#e7e1df] dark:border-[#363230]">
                    📍 {event.location}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-full bg-[#1b5e20]/10 text-[#1b5e20] dark:text-[#81c784] text-xs font-medium border border-[#1b5e20]/20">
                    🗣️ {event.language}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-full bg-[#f59e0b]/15 text-[#7c4a03] dark:text-[#fde047] text-xs font-medium border border-[#f59e0b]/30">
                    👥 {event.target_group}
                  </span>
                </div>

                <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2 leading-snug hover:text-[#8B263E] dark:hover:text-[#ff758f] transition-colors">
                  <a href={`/events/${event.slug}/`}>
                    {event.title}
                  </a>
                </h3>

                <p class="font-sans text-xs text-[#8B263E] dark:text-[#ff758f] font-semibold mb-3">
                  📅 {new Date(event.date_start).toLocaleDateString('de-DE', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })} Uhr
                </p>

                <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] line-clamp-3 mb-6 flex-grow leading-relaxed">
                  {event.description}
                </p>

                <div class="pt-4 border-t border-[#e7e1df] dark:border-[#363230] flex items-center justify-between">
                  <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
                    Ohne Anmeldung
                  </span>
                  <a
                    href={`/events/${event.slug}/`}
                    class="inline-flex items-center gap-1 text-sm font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline transition-colors"
                  >
                    Details &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>

  <script>
    const tabMain = document.getElementById('tab-main-cal');
    const tabKids = document.getElementById('tab-kids-cal');
    const containerMain = document.getElementById('container-main-cal');
    const containerKids = document.getElementById('container-kids-cal');

    if (tabMain && tabKids && containerMain && containerKids) {
      tabMain.addEventListener('click', () => {
        tabMain.className = 'px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer';
        tabKids.className = 'px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer';
        containerMain.classList.remove('hidden');
        containerKids.classList.add('hidden');
      });

      tabKids.addEventListener('click', () => {
        tabKids.className = 'px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 bg-[#8B263E] text-white shadow-md flex items-center gap-2 cursor-pointer';
        tabMain.className = 'px-5 py-2.5 rounded-full font-semibold text-sm transition-all duration-200 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] text-[#1d1b1a] dark:text-[#f5f0ee] hover:border-[#8B263E] flex items-center gap-2 cursor-pointer';
        containerKids.classList.remove('hidden');
        containerMain.classList.add('hidden');
      });
    }
  </script>
</Layout>
