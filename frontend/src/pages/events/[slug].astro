---
import Layout from '../../layouts/Layout.astro';
import { getEvents, getEventBySlug } from '../../lib/cms-api';
import type { EventItem } from '../../types/cms';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
---

<Layout title={`${event.title} - SprachCafé Polnisch`} description={event.description}>
  <article class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <nav class="mb-8">
      <a href="/events/" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-primary-light hover:underline">
        &larr; Zurück zur Veranstaltungsübersicht
      </a>
    </nav>

    <div class="bg-brand-surface border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">
      {event.image && (
        <div class="w-full h-80 sm:h-96 overflow-hidden bg-slate-900">
          <img src={event.image} alt={event.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-xs font-bold uppercase">
            📍 Standort: {event.location}
          </span>
          <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-200 text-xs font-semibold">
            🗣️ Sprache: {event.language}
          </span>
          <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-200 text-xs font-semibold">
            👥 Zielgruppe: {event.target_group}
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-6 leading-tight">
          {event.title}
        </h1>

        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 sm:p-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="block text-xs uppercase tracking-wider text-slate-400 mb-1">Datum & Uhrzeit</span>
            <span class="text-lg font-bold text-sky-400">
              📅 {new Date(event.date_start).toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })} Uhr
            </span>
          </div>
          {event.max_participants && (
            <div class="sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-800">
              <span class="block text-xs uppercase tracking-wider text-slate-400 mb-1">Teilnehmerbegrenzung</span>
              <span class="text-sm font-semibold text-slate-200">Max. {event.max_participants} Personen</span>
            </div>
          )}
        </div>

        <div class="prose prose-invert max-w-none text-brand-text-muted leading-relaxed text-lg space-y-4 mb-10">
          <h2 class="text-xl font-bold text-white mb-2">Über diese Veranstaltung</h2>
          <p>{event.description}</p>
        </div>

        <div class="p-6 rounded-2xl bg-gradient-to-r from-sky-950/40 to-slate-900 border border-sky-900/50 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold text-white mb-1">Möchten Sie teilnehmen?</h3>
            <p class="text-sm text-brand-text-muted">Kostenfrei & ohne verbindliche Anmeldung direkt vorbeikommen!</p>
          </div>
          <a
            href="#contact"
            class="px-6 py-3 rounded-xl bg-brand-primary-light text-slate-950 font-bold hover:bg-sky-300 transition-colors shadow-lg shadow-sky-500/20 text-center whitespace-nowrap"
          >
            Kontakt / Frage stellen
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
