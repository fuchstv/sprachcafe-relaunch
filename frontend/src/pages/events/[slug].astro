---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const collectionEvents = await getCollection('events');
  return collectionEvents.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = 'de';

const event = {
  slug: entry.slug,
  title: entry.data.title[lang] || entry.data.title.de,
  date_start: entry.data.date,
  location: entry.data.locationRef,
  language: entry.data.language.join(', ').toUpperCase(),
  target_group: entry.data.targetAudience[lang] || entry.data.targetAudience.de,
  description: entry.data.description[lang] || entry.data.description.de,
  image: entry.data.image.src,
};
---

<Layout title={`${event.title} - SprachCafé Polnisch`} description={event.description}>
  <article
    class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto"
    data-pagefind-body
    data-pagefind-filter={`type:Event, location:${event.location}, language:${event.language}, target_group:${event.target_group}`}
  >
    <nav class="mb-8">
      <a href="/events/" class="inline-flex items-center gap-2 text-sm font-bold text-[#DD3333] dark:text-[#ff6b6b] hover:underline">
        &larr; Zurück zur Veranstaltungsübersicht
      </a>
    </nav>

    <div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
      {event.image && (
        <div class="w-full h-80 sm:h-96 overflow-hidden bg-[#f8f2f0] dark:bg-[#2a2725]">
          <img src={event.image} alt={event.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 rounded-full bg-[#DD3333]/10 border border-[#DD3333]/20 text-[#DD3333] dark:text-[#ff6b6b] text-xs font-bold uppercase">
            📍 Standort: {event.location}
          </span>
          <span class="px-3 py-1 rounded-full bg-[#43AD48]/10 text-[#43AD48] dark:text-[#73dd71] border border-[#43AD48]/20 text-xs font-semibold">
            🗣️ Sprache: {event.language}
          </span>
          <span class="px-3 py-1 rounded-full bg-[#F2B705]/15 text-[#b48000] dark:text-[#F2B705] border border-[#F2B705]/30 text-xs font-semibold">
            👥 Zielgruppe: {event.target_group}
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-6 leading-tight">
          {event.title}
        </h1>

        <div class="bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl p-4 sm:p-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="block text-xs uppercase tracking-wider text-[#5b403d] dark:text-[#d4c5c2] mb-1 font-bold">Datum & Uhrzeit</span>
            <span class="font-sans text-lg font-bold text-[#DD3333] dark:text-[#ff6b6b]">
              📅 {new Date(event.date_start).toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })} Uhr
            </span>
          </div>
        </div>

        <div class="font-sans text-[#1d1b1a] dark:text-[#f5f0ee] leading-relaxed text-lg space-y-4 mb-10">
          <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Über diese Veranstaltung</h2>
          <p>{event.description}</p>
        </div>

        <div class="p-6 rounded-2xl bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Möchten Sie teilnehmen?</h3>
            <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Kostenfrei & ohne verbindliche Anmeldung direkt vorbeikommen!</p>
          </div>
          <a
            href="/kontakt/"
            class="px-6 py-3 rounded-full bg-[#DD3333] hover:bg-[#b9151e] text-white font-bold transition-all shadow-md text-center whitespace-nowrap"
          >
            Kontakt / Frage stellen
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
