---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import VintageEventTicketCard from "../components/VintageEventTicketCard.astro";
import BookshelfWidget from "../components/BookshelfWidget.astro";
import KiezHubSelector from "../components/KiezHubSelector.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import { getCollection } from "astro:content";

const lang = "de";

function stripHtml(html: string): string {
  if (!html) return "";
  return html
    .replace(/<[^>]*>?/gm, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, "\"")
    .replace(/&#039;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

const allEvents = await getCollection("events");
const now = new Date();

// Filter for upcoming events (event is upcoming if its end date or start date is >= now)
const upcomingEvents = allEvents.filter((e) => {
  const eventEnd = e.data.endDate ? new Date(e.data.endDate) : new Date(e.data.date);
  return eventEnd.getTime() >= now.getTime();
});

// Sort by date ascending (closest upcoming first) and pick 3 events
const sortedEvents = (upcomingEvents.length > 0 ? upcomingEvents : allEvents)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3)
  .map((e) => ({
    slug: e.slug,
    title: e.data.title[lang] || e.data.title.de,
    date_start: e.data.date,
    location: e.data.locationRef,
    language: e.data.language.join(", ").toUpperCase(),
    target_group: e.data.targetAudience[lang] || e.data.targetAudience.de,
    description: stripHtml(e.data.description[lang] || e.data.description.de),
    image: e.data.image.src || "/images/events/event-sprachabend.webp",
  }));
---

<Layout title="SprachCafé Polnisch - Kultur- & Begegnungszentrum in Berlin" lang={lang}>
  
  <!-- 1. Hero Section mit Bildcollage & Gemütlichkeits-Vibe -->
  <HeroSection
    title="Willkommen im SprachCafé Polnisch"
    subtitle="Ihr bilinguales Kultur- und Begegnungszentrum. Entdecken Sie die polnische und deutsche Sprache, Literatur und lebendige Gemeinschaft mitten in Berlin."
    badge="☕ Geöffnet & Willkommen"
    primaryCtaText="Veranstaltungen entdecken"
    primaryCtaLink="/events/"
    secondaryCtaText="Hausbibliothek Katalog"
    secondaryCtaLink="/hausbibliothek/"
    lang={lang}
  />

  <!-- 2. Nächste Veranstaltungen mit Vintage-Ticket-Karten (Stitch Widget) -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#FF758F] text-xs font-bold uppercase tracking-wider mb-2">
          🎟️ Programm & Kultur
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1D1B1A] dark:text-[#F5F0EE] tracking-tight">
          Nächste Events & Treffen
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#5B403D] dark:text-[#D4C5C2] mt-1">
          Kommen Sie vorbei – Lesungen, Sprach-Tandems, Konzerte und Workshops.
        </p>
      </div>

      <a
        href="/events/"
        class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#3A3532] text-[#8B1E2D] dark:text-[#FF758F] font-bold text-xs sm:text-sm hover:border-[#8B1E2D] hover:bg-[#FAF5EB] transition-all shadow-sm group shrink-0"
      >
        <span>Alle Termine im Kalender</span>
        <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedEvents.map((event) => (
        <VintageEventTicketCard
          slug={event.slug}
          title={event.title}
          dateStart={event.date_start}
          location={event.location}
          language={event.language}
          targetGroup={event.target_group}
          description={event.description}
          image={event.image}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- 3. Digitales Holz-Bücherregal (Stitch Bookshelf Widget) -->
  <BookshelfWidget
    lang={lang}
    title="Neu im Regal"
    subtitle="Über 400 zweisprachige Bücher, Romane und Kinderliteratur in unserer Hausbibliothek."
  />

  <!-- 4. Interaktiver 3-Kiez-Hub-Selector (Stitch Kiez Widget) -->
  <KiezHubSelector lang={lang} />

  <!-- 5. Testimonial & Community Grid -->
  <TestimonialGrid lang={lang} />

</Layout>