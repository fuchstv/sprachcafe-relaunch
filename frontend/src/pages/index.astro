---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import LocationOpeningHoursCard from '../components/LocationOpeningHoursCard.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import LibraryReferralSection from '../components/LibraryReferralSection.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);

const locationsCollection = await getCollection('locations');
const locations = locationsCollection.map((loc) => ({
  id: loc.slug,
  name: loc.data.name[lang] || loc.data.name.de,
  address: `${loc.data.address.street}, ${loc.data.address.zip} ${loc.data.address.city}`,
  openingHours: loc.data.openingHours[lang] || loc.data.openingHours.de,
  contactEmail: loc.data.email,
  mapUrl: loc.data.address.mapUrl,
}));
---

<Layout title="SprachCafé Polnisch - Ort der Begegnung, Sprache und Kultur" lang={lang}>
  
  <!-- Hero Section mit Bildcollage -->
  <HeroSection
    title="Willkommen im SprachCafé Polnisch"
    subtitle="Tauche ein in die polnische und deutsche Sprache und Kultur. Lerne, vernetze dich und erlebe Gemeinschaft in Berlin-Pankow, Schöneberg und Köpenick."
    badge="Offizielle Vereinsplattform"
    primaryCtaText="Veranstaltungen entdecken"
    primaryCtaLink="/events/"
    secondaryCtaText="Hausbibliothek Katalog"
    secondaryCtaLink="/hausbibliothek/"
  />

  <!-- Prominenter Verweis auf hausbibliothek.org ("Zu unserer Bibliothek") -->
  <LibraryReferralSection lang={lang} />

  <!-- Standorte & Öffnungszeiten Grid -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <div class="mb-10 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-[#DD3333]/10 border border-[#DD3333]/20 text-[#DD3333] dark:text-[#ff6b6b] text-xs font-bold uppercase tracking-wider mb-3">
        Unsere 3 Standorte in Berlin
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">Öffnungszeiten & Adressen</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {locations.map((loc) => (
        <LocationOpeningHoursCard
          location={loc.name}
          address={loc.address}
          openingHours={loc.openingHours}
          contactEmail={loc.contactEmail}
          mapUrl={loc.mapUrl}
        />
      ))}
    </div>
  </section>

  <!-- Testimonial Grid Komponente -->
  <TestimonialGrid lang={lang} />

</Layout>
