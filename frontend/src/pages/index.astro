---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);
---

<Layout title="SprachCafé Polnisch - Willkommen" lang={lang}>
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 text-center max-w-5xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-sm font-semibold mb-6">
      <span>{t('hero.badge')}</span>
    </div>
    
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      {t('hero.title')}
    </h1>
    
    <p class="text-lg sm:text-xl text-brand-text-muted max-w-3xl mx-auto mb-12 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <div class="bg-brand-surface border border-slate-800 rounded-2xl p-6 sm:p-10 text-left shadow-2xl">
      <h2 class="text-2xl font-bold text-brand-primary-light mb-4">🇩🇪 Willkommen auf der deutschen Startseite</h2>
      <p class="text-brand-text-muted leading-relaxed mb-8">
        Das SprachCafé Polnisch fördert den interkulturellen Austausch, Sprachkurse und Begegnungen in Berlin.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-slate-900/60 p-6 rounded-xl border border-slate-800/60">
          <div class="text-3xl mb-3" aria-hidden="true">🗣️</div>
          <h3 class="text-lg font-bold text-white mb-2">Sprach-Treffen</h3>
          <p class="text-sm text-brand-text-muted">Regelmäßige Sprachcafés für Polnisch und Deutsch.</p>
        </div>

        <div class="bg-slate-900/60 p-6 rounded-xl border border-slate-800/60">
          <div class="text-3xl mb-3" aria-hidden="true">📚</div>
          <h3 class="text-lg font-bold text-white mb-2">Hausbibliothek</h3>
          <p class="text-sm text-brand-text-muted">Digitale Ausleihe polnischer und deutscher Literatur.</p>
        </div>

        <div class="bg-slate-900/60 p-6 rounded-xl border border-slate-800/60">
          <div class="text-3xl mb-3" aria-hidden="true">🎉</div>
          <h3 class="text-lg font-bold text-white mb-2">Kulturevents</h3>
          <p class="text-sm text-brand-text-muted">Lesungen, Filmabende und Workshops.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
