---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);
---

<Layout title="SprachCafé Polnisch - Willkommen" lang={lang}>
  <main class="hero-section">
    <div class="container">
      <span class="badge">{t('hero.badge')}</span>
      <h1 class="title">{t('hero.title')}</h1>
      <p class="subtitle">{t('hero.subtitle')}</p>
      
      <div class="info-card">
        <h2>🇩🇪 Willkommen auf der deutschen Startseite</h2>
        <p>
          Das SprachCafé Polnisch fördert den interkulturellen Austausch, Sprachkurse und Begegnungen in Berlin.
        </p>
        <div class="features">
          <div class="feature-item">
            <span class="icon">🗣️</span>
            <h3>Sprach-Treffen</h3>
            <p>Regelmäßige Sprachcafés für Polnisch und Deutsch.</p>
          </div>
          <div class="feature-item">
            <span class="icon">📚</span>
            <h3>Hausbibliothek</h3>
            <p>Digitale Ausleihe polnischer und deutscher Literatur.</p>
          </div>
          <div class="feature-item">
            <span class="icon">🎉</span>
            <h3>Kulturevents</h3>
            <p>Lesungen, Filmabende und Workshops.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .hero-section {
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
  }
  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .title {
    font-size: 3.25rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .subtitle {
    font-size: 1.25rem;
    color: #94a3b8;
    max-width: 650px;
    margin: 0 auto 3rem auto;
    line-height: 1.6;
  }
  .info-card {
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    padding: 2.5rem;
    text-align: left;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
  }
  .info-card h2 {
    margin-top: 0;
    color: #38bdf8;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .feature-item {
    background: rgba(15, 23, 42, 0.6);
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .feature-item .icon {
    font-size: 2rem;
  }
  .feature-item h3 {
    margin: 0.5rem 0;
    font-size: 1.1rem;
  }
  .feature-item p {
    margin: 0;
    font-size: 0.9rem;
    color: #94a3b8;
  }
</style>
