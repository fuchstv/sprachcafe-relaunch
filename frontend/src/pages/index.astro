---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import LocationOpeningHoursCard from '../components/LocationOpeningHoursCard.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'de';
const t = useTranslations(lang);
---

<Layout title="SprachCafé Polnisch - Ort der Begegnung, Sprache und Kultur" lang={lang}>
  
  <!-- Hero Section mit Bildcollage -->
  <HeroSection
    title="Willkommen im SprachCafé Polnisch"
    subtitle="Tauche ein in die polnische und deutsche Sprache und Kultur. Lerne, vernetze dich und erlebe Gemeinschaft in Berlin-Pankow, Schöneberg und Köpenick."
    badge="Offizielle Vereinsplattform"
    primaryCtaText="Veranstaltungen entdecken"
    primaryCtaLink="/events/"
    secondaryCtaText="Hausbibliothek Katalog"
    secondaryCtaLink="/hausbibliothek/"
  />

  <!-- Standorte & Öffnungszeiten Grid -->
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="mb-10 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-xs font-bold uppercase tracking-wider mb-3">
        Unsere 3 Standorte in Berlin
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Öffnungszeiten & Adressen</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <LocationOpeningHoursCard
        location="Pankow"
        address="Schönholzer Str. 13, 13187 Berlin"
        hours={[
          { day: "Dienstag", time: "18:00 - 20:30 Uhr" },
          { day: "Donnerstag", time: "16:00 - 19:00 Uhr" }
        ]}
        contactEmail="pankow@sprachcafe-polnisch.org"
      />
      <LocationOpeningHoursCard
        location="Schöneberg"
        address="Hauptstraße 26, 10827 Berlin"
        hours={[
          { day: "Mittwoch", time: "17:00 - 20:00 Uhr" },
          { day: "Freitag", time: "18:30 - 21:30 Uhr" }
        ]}
        contactEmail="schoeneberg@sprachcafe-polnisch.org"
      />
      <LocationOpeningHoursCard
        location="Köpenick"
        address="Bahnhofstraße 8, 12555 Berlin"
        hours={[
          { day: "Montag", time: "15:00 - 18:00 Uhr" },
          { day: "Samstag", time: "11:00 - 15:00 Uhr" }
        ]}
        contactEmail="koepenick@sprachcafe-polnisch.org"
      />
    </div>
  </section>

  <!-- Testimonial Grid Komponente -->
  <TestimonialGrid />

</Layout>
