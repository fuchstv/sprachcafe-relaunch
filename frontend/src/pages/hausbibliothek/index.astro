---
import Layout from '../../layouts/Layout.astro';
import BookshelfWidget from '../../components/BookshelfWidget.astro';
import { getBooks } from '../../lib/cms-api';

const books = await getBooks();
const buildTime = new Date().toLocaleString('de-DE', { dateStyle: 'medium', timeStyle: 'short' });

// Extract unique filter options for dropdowns
const categories = Array.from(new Set(books.map(b => b.category)));
const locations = Array.from(new Set(books.map(b => b.location)));
const languages = Array.from(new Set(books.map(b => b.language)));
const statuses = Array.from(new Set(books.map(b => b.status)));
---

<Layout title="Hausbibliothek Katalog - SprachCafé Polnisch" description="Durchsuchen Sie den digitalen Buchkatalog der Hausbibliothek am Standort Pankow.">
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    
    <!-- Banner Link to Existing App (Go-Live Link & Live Status Info) -->
    <div class="mb-8 p-6 rounded-2xl bg-[#FAF5EB] dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] shadow-[0_4px_20px_rgba(51,49,48,0.05)] flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-2">
          📖 Digitale Ausleihe & Live-Status
        </div>
        <h2 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">Möchten Sie Bücher ausleihen oder Ihr Nutzerkonto verwalten?</h2>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">
          Für verbindliche Reservierungen, Konto-Management und Ausleihen besuchen Sie das Portal hausbibliothek.org.
        </p>
      </div>
      <a
        href="https://hausbibliothek.org"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-full bg-[#8B1E2D] hover:bg-[#6b1d30] text-white font-bold transition-all shadow-md whitespace-nowrap"
      >
        Zu hausbibliothek.org &rarr;
      </a>
    </div>

    <!-- Header Section mit Bild der Hausbibliothek & Build-Zeitstempel -->
    <div class="mb-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-b border-[#E2D8CC] dark:border-[#363230] pb-8">
      <div class="lg:col-span-7 space-y-4">
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">Hausbibliothek Katalog</h1>
        <p class="font-sans text-base text-[#5b403d] dark:text-[#d4c5c2] max-w-2xl leading-relaxed">
          Stöbern Sie im Literaturbestand unserer Hausbibliothek am Standort Pankow (Schulzestr. 1). Über 400 zweisprachige Werke, Romane, Kinder- und Jugendbücher.
        </p>
        <div class="bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl px-4 py-2 text-xs text-[#5b403d] dark:text-[#d4c5c2] inline-block space-y-1">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#8B1E2D] dark:bg-[#ff6b6b]"></span>
            <span>Katalogstand: <strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">{buildTime} Uhr</strong></span>
          </div>
          <div id="live-status-notice" class="text-[#5b403d] dark:text-[#d4c5c2] text-[11px] flex items-center gap-1">
            <span class="animate-pulse">🔄</span> Live-Status wird im Hintergrund abgeglichen...
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E2D8CC] dark:border-[#363230]">
          <img
            src="/images/library/hausbibliothek-raum.webp"
            alt="Hausbibliothek des SprachCafé Polnisch e.V. in Berlin-Pankow"
            class="w-full h-48 sm:h-56 object-cover"
          />
        </div>
      </div>
    </div>

    <!-- Neu im Regal Bookshelf Widget -->
    <div class="mb-12">
      <BookshelfWidget maxBooks={10} />
    </div>

    <!-- Filter UI Elements -->
    <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-6 mb-10 shadow-[0_4px_20px_rgba(51,49,48,0.05)]">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <!-- Text Search -->
        <div>
          <label for="filter-search" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Suche</label>
          <input
            type="text"
            id="filter-search"
            placeholder="Titel, Autor, ISBN..."
            class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <!-- Filter: Language -->
        <div>
          <label for="filter-language" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Sprache</label>
          <select id="filter-language" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Alle Sprachen</option>
            {languages.map(lang => (
              <option value={lang} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{lang === 'PL' ? 'Polnisch (PL)' : lang === 'DE' ? 'Deutsch (DE)' : lang === 'EN' ? 'Englisch (EN)' : 'Ukrainisch (UKR)'}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Category -->
        <div>
          <label for="filter-category" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Kategorie</label>
          <select id="filter-category" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Alle Kategorien</option>
            {categories.map(cat => (
              <option value={cat} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{cat}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Location -->
        <div>
          <label for="filter-location" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Standort</label>
          <select id="filter-location" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Alle Standorte</option>
            {locations.map(loc => (
              <option value={loc} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{loc}</option>
            ))}
          </select>
        </div>

        <!-- Filter: Status -->
        <div>
          <label for="filter-status" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-1.5">Ausleihstatus</label>
          <select id="filter-status" class="w-full px-3 py-2 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]">
            <option value="all" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Alle Status</option>
            {statuses.map(st => (
              <option value={st} class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">{st === 'verfuegbar' ? 'Verfügbar' : st === 'ausgeliehen' ? 'Ausgeliehen' : 'Reserviert'}</option>
            ))}
          </select>
        </div>

      </div>
    </div>

    <!-- Pagefind Body Area for Client-Side Search Indexing -->
    <div data-pagefind-body>
      <div id="book-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {books.map((book) => (
          <article
            class="book-card bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(51,49,48,0.05)] flex flex-col hover:border-[#8B1E2D]/50 transition-all duration-300"
            data-book-id={book.id.replace('book-', '')}
            data-title={book.title.toLowerCase()}
            data-author={book.author.toLowerCase()}
            data-isbn={book.isbn}
            data-language={book.language}
            data-category={book.category}
            data-location={book.location}
            data-status={book.status}
            data-pagefind-filter={`language:${book.language}, category:${book.category}, location:${book.location}, status:${book.status}`}
          >
            {book.cover && (
              <div class="h-64 w-full overflow-hidden bg-[#FAF5EB] dark:bg-[#2a2725] flex items-center justify-center p-4">
                <img
                  src={book.cover}
                  alt={`Buchcover: ${book.title}`}
                  class="h-full object-contain shadow-md hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            )}

            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 rounded-full bg-[#FAF5EB] dark:bg-[#2a2725] text-[#8B1E2D] dark:text-[#ff758f] border border-[#E2D8CC] dark:border-[#363230] text-xs font-bold">
                  {book.language}
                </span>
                <span class:list={[
                  'status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase transition-colors',
                  book.status === 'verfuegbar' ? 'bg-emerald-100 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300' :
                  book.status === 'ausgeliehen' ? 'bg-rose-100 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-800 dark:text-rose-300' :
                  'bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-800 text-amber-800 dark:text-amber-300'
                ]}>
                  {book.status === 'verfuegbar' ? 'Verfügbar' : book.status === 'ausgeliehen' ? 'Ausgeliehen' : 'Reserviert'}
                </span>
              </div>

              <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] leading-snug mb-1 hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors">
                <a href={`/hausbibliothek/${book.id}/`}>{book.title}</a>
              </h3>

              <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] font-medium mb-3">{book.author}</p>

              <div class="mt-auto pt-3 border-t border-[#E2D8CC] dark:border-[#363230] text-xs text-[#5b403d] dark:text-[#d4c5c2] space-y-1">
                <div class="flex justify-between">
                  <span>Kategorie:</span>
                  <span class="text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold">{book.category}</span>
                </div>
                <div class="flex justify-between">
                  <span>Standort:</span>
                  <span class="text-[#1d1b1a] dark:text-[#f5f0ee] font-semibold">📍 {book.location}</span>
                </div>
                <div class="flex justify-between">
                  <span>ISBN:</span>
                  <span class="font-mono text-[#5b403d] dark:text-[#d4c5c2]">{book.isbn}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Fallback No Results Message -->
      <div id="no-results" class="hidden text-center py-16 bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl">
        <p class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2">Keine Bücher gefunden</p>
        <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2]">Bitte passen Sie Ihre Such- und Filterkriterien an.</p>
      </div>
    </div>
  </section>

  <!-- Client-side Live Availability Hydration Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Filter logic
      const searchInput = document.getElementById('filter-search');
      const languageSelect = document.getElementById('filter-language');
      const categorySelect = document.getElementById('filter-category');
      const locationSelect = document.getElementById('filter-location');
      const statusSelect = document.getElementById('filter-status');
      const bookCards = document.querySelectorAll('.book-card');
      const noResults = document.getElementById('no-results');

      // Cache book data to avoid expensive DOM reading in the filter loop
      const bookCache = Array.from(bookCards).map(card => ({
        card: card,
        title: card.getAttribute('data-title') || '',
        author: card.getAttribute('data-author') || '',
        isbn: card.getAttribute('data-isbn') || '',
        bookLang: card.getAttribute('data-language') || '',
        bookCat: card.getAttribute('data-category') || '',
        bookLoc: card.getAttribute('data-location') || '',
        bookSt: card.getAttribute('data-status') || '',
        bookId: card.getAttribute('data-book-id') || ''
      }));

      function filterBooks() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const lang = languageSelect ? languageSelect.value : 'all';
        const cat = categorySelect ? categorySelect.value : 'all';
        const loc = locationSelect ? locationSelect.value : 'all';
        const st = statusSelect ? statusSelect.value : 'all';

        let visibleCount = 0;

        bookCache.forEach(cachedBook => {
          const { card, title, author, isbn, bookLang, bookCat, bookLoc, bookSt } = cachedBook;

          const matchesQuery = !query || title.includes(query) || author.includes(query) || isbn.includes(query);
          const matchesLang = lang === 'all' || bookLang === lang;
          const matchesCat = cat === 'all' || bookCat === cat;
          const matchesLoc = loc === 'all' || bookLoc === loc;
          const matchesSt = st === 'all' || bookSt === st;

          if (matchesQuery && matchesLang && matchesCat && matchesLoc && matchesSt) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      [searchInput, languageSelect, categorySelect, locationSelect, statusSelect].forEach(element => {
        if (element) {
          element.addEventListener('input', filterBooks);
          element.addEventListener('change', filterBooks);
        }
      });

      // 2. Client-side Live Availability Hydration from Export API
      const exportUrl = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
        ? 'http://localhost:8080/api/export/books'
        : 'https://hausbibliothek.org/api/export/books';

      fetch(exportUrl)
        .then(res => res.json())
        .then(data => {
          const booksList = Array.isArray(data) ? data : (data.data || []);
          const statusMap = new Map();
          booksList.forEach(b => {
            if (b.id) statusMap.set(String(b.id), b.availability_status || b.status);
          });

          bookCache.forEach(cachedBook => {
            const { card, bookId } = cachedBook;
            const liveStatus = statusMap.get(bookId);
            if (liveStatus) {
              const badge = card.querySelector('.status-badge');
              if (badge) {
                if (liveStatus === 'available' || liveStatus === 'verfuegbar') {
                  badge.className = 'status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-emerald-100 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
                  badge.textContent = '🟢 Verfügbar';
                  card.setAttribute('data-status', 'verfuegbar');
                  cachedBook.bookSt = 'verfuegbar';
                } else {
                  badge.className = 'status-badge px-2.5 py-0.5 rounded-full text-xs font-bold uppercase bg-rose-100 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-800 dark:text-rose-300';
                  badge.textContent = '🔴 Ausgeliehen';
                  card.setAttribute('data-status', 'ausgeliehen');
                  cachedBook.bookSt = 'ausgeliehen';
                }

              }
            }
          });
          // Re-trigger filter after live status update
          filterBooks();

          const liveNotice = document.getElementById('live-status-notice');
          if (liveNotice) {
            liveNotice.innerHTML = '✅ <span class="text-emerald-600 dark:text-emerald-400 font-bold">Live-Status abgeglichen</span>';
          }
        })
        .catch(err => {
          console.warn('Live availability fetch warning:', err.message);
        });
    });
  </script>
</Layout>
