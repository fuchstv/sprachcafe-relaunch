---
import Layout from '../layouts/Layout.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
---

<Layout
  title="Mitmachen & Engagement - SprachCafé Polnisch"
  description="Werden Sie Mitglied, engagieren Sie sich ehrenamtlich oder absolvieren Sie ein Praktikum im SprachCafé Polnisch e.V."
>
  <main class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Teil der Gemeinschaft werden
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        Ob als aktives Vereinsmitglied, Sprachbegleiter:in im SprachCafé oder Praktikant:in — gestalten Sie die interkulturelle Begegnung in Berlin mit!
      </p>
    </div>

    <!-- Application Form Component -->
    <ApplicationForm />
  </main>
</Layout>
