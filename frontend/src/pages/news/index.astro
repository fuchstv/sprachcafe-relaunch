---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');

// Sort newest first
const sortedNews = allNews.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const langBadges = {
  de: { label: 'Deutsch', flag: '🇩🇪', bg: 'bg-[#8B263E]/10 text-[#8B263E] dark:text-[#ff758f] border-[#8B263E]/20' },
  pl: { label: 'Polski', flag: '🇵🇱', bg: 'bg-[#DC143C]/10 text-[#DC143C] dark:text-[#ff6b81] border-[#DC143C]/20' },
  en: { label: 'English', flag: '🇬🇧', bg: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20' }
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Aktuelles & Newsletter - SprachCafé Polnisch e.V.",
  "description": "Aktuelle Mitteilungen, Newsletter und Berichte aus dem SprachCafé Polnisch e.V. auf Deutsch und Polnisch.",
  "url": "https://sprachcafe-polnisch.org/news/"
};
---

<Layout
  title="Aktuelles & Newsletter - SprachCafé Polnisch"
  description="Aktuelle Mitteilungen, Newsletter und Berichte aus dem SprachCafé Polnisch e.V. auf Deutsch und Polnisch."
  jsonLd={jsonLd}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
    <!-- Header Section -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-semibold uppercase tracking-wider mb-3">
        <span>📰</span>
        <span>Mitteilungen & Newsletter / Aktualności i Biuletyn</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight mb-4">
        Aktuelles & Newsletter
      </h1>
      <p class="font-sans text-base sm:text-lg text-[#5b403d] dark:text-[#d4c5c2] max-w-3xl leading-relaxed">
        Hier finden Sie alle aktuellen Vereinsnachrichten, Einladungen und Newsletter-Ausgaben des SprachCafé Polnisch e.V. in deutscher und polnischer Sprache.
      </p>
    </div>

    <!-- Language Filter Controls -->
    <div class="flex items-center gap-2 mb-8 overflow-x-auto pb-2" id="news-filter-buttons">
      <button
        type="button"
        data-filter="all"
        class="filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all duration-200 bg-[#8B263E] text-white border-[#8B263E] shadow-sm"
      >
        🌐 Alle / Wszystkie ({sortedNews.length})
      </button>
      <button
        type="button"
        data-filter="de"
        class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all duration-200 bg-white dark:bg-[#22201e] text-[#5b403d] dark:text-[#d4c5c2] border-[#e7e1df] dark:border-[#363230] hover:border-[#8B263E]"
      >
        🇩🇪 Deutsch ({sortedNews.filter(n => n.data.language === 'de').length})
      </button>
      <button
        type="button"
        data-filter="pl"
        class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all duration-200 bg-white dark:bg-[#22201e] text-[#5b403d] dark:text-[#d4c5c2] border-[#e7e1df] dark:border-[#363230] hover:border-[#DC143C]"
      >
        🇵🇱 Polski ({sortedNews.filter(n => n.data.language === 'pl').length})
      </button>
      {sortedNews.some(n => n.data.language === 'en') && (
        <button
          type="button"
          data-filter="en"
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all duration-200 bg-white dark:bg-[#22201e] text-[#5b403d] dark:text-[#d4c5c2] border-[#e7e1df] dark:border-[#363230] hover:border-blue-500"
        >
          🇬🇧 English ({sortedNews.filter(n => n.data.language === 'en').length})
        </button>
      )}
    </div>

    <!-- News Grid -->
    {sortedNews.length === 0 ? (
      <div class="text-center py-16 bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-8">
        <p class="text-lg text-[#5b403d] dark:text-[#d4c5c2]">
          Aktuell sind keine News-Einträge vorhanden.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8" id="news-grid">
        {sortedNews.map((item) => {
          const badge = langBadges[item.data.language] || langBadges.de;
          const formattedDate = new Date(item.data.date).toLocaleDateString(
            item.data.language === 'pl' ? 'pl-PL' : (item.data.language === 'en' ? 'en-US' : 'de-DE'),
            { year: 'numeric', month: 'long', day: 'numeric' }
          );

          return (
            <article
              class="news-card bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-8 shadow-[0_4px_20px_rgba(51,49,48,0.05)] hover:border-[#8B263E]/50 transition-all duration-300 flex flex-col justify-between"
              data-language={item.data.language}
            >
              <div>
                <!-- Top metadata: Language badge & Date -->
                <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
                  <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-bold ${badge.bg}`}>
                    <span>{badge.flag}</span>
                    <span>{badge.label}</span>
                  </span>

                  <time datetime={item.data.date.toISOString()} class="text-xs font-medium text-[#5b403d] dark:text-[#d4c5c2]">
                    📅 {formattedDate}
                  </time>
                </div>

                <!-- Title -->
                <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-3 leading-snug hover:text-[#8B263E] dark:hover:text-[#ff758f] transition-colors">
                  <a href={`/news/${item.slug}/`}>
                    {item.data.title}
                  </a>
                </h2>

                <!-- Description / Preview -->
                {item.data.description && (
                  <p class="font-sans text-sm text-[#5b403d] dark:text-[#d4c5c2] line-clamp-3 mb-6 leading-relaxed">
                    {item.data.description}
                  </p>
                )}
              </div>

              <!-- Footer Actions -->
              <div class="pt-4 border-t border-[#e7e1df] dark:border-[#363230] flex items-center justify-between">
                <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
                  {item.data.type === 'newsletter' ? '📧 Newsletter-Ausgabe' : '📰 Mitteilung'}
                </span>
                <a
                  href={`/news/${item.slug}/`}
                  class="inline-flex items-center gap-1 text-sm font-bold text-[#8B263E] dark:text-[#ff758f] hover:underline transition-colors"
                >
                  {item.data.language === 'pl' ? 'Czytaj dalej' : 'Weiterlesen'} &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- Client-side Interactive Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.news-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Update active button state
          buttons.forEach(b => {
            b.classList.remove('bg-[#8B263E]', 'text-white', 'border-[#8B263E]');
            b.classList.add('bg-white', 'dark:bg-[#22201e]', 'text-[#5b403d]', 'dark:text-[#d4c5c2]', 'border-[#e7e1df]', 'dark:border-[#363230]');
          });

          btn.classList.add('bg-[#8B263E]', 'text-white', 'border-[#8B263E]');
          btn.classList.remove('bg-white', 'dark:bg-[#22201e]', 'text-[#5b403d]', 'dark:text-[#d4c5c2]', 'border-[#e7e1df]', 'dark:border-[#363230]');

          // Filter news cards
          cards.forEach(card => {
            const cardLang = card.getAttribute('data-language');
            if (filter === 'all' || cardLang === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
