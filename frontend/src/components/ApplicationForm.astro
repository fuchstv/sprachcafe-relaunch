---
interface Props {
  webhookUrl?: string;
}

const {
  webhookUrl = import.meta.env.PUBLIC_POWER_AUTOMATE_VOLUNTEER_WEBHOOK_URL || import.meta.env.PUBLIC_POWER_AUTOMATE_MEMBER_WEBHOOK_URL || ""
} = Astro.props;
---

<div class="application-form-wrapper bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-[0_4px_20px_rgba(51,49,48,0.05)] max-w-3xl mx-auto">
  <div class="mb-8 text-center sm:text-left">
    <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-2">
      Mitmachen & Engagieren
    </span>
    <h2 class="font-serif text-2xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">Mitgliedsantrag & Bewerbung</h2>
    <p class="mt-2 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
      Werden Sie Mitglied im SprachCafé Polnisch e.V. oder engagieren Sie sich ehrenamtlich / im Praktikum.
    </p>
  </div>

  <!-- Success Feedback Banner -->
  <div id="form-success" class="hidden mb-6 p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-2xl">🎉</span>
      <div>
        <h3 class="font-bold text-emerald-900 dark:text-emerald-200 text-base">Vielen Dank für Ihren Antrag!</h3>
        <p class="mt-1">Ihre Daten wurden erfolgreich übermittelt. Unser Vorstand meldet sich in Kürze bei Ihnen.</p>
      </div>
    </div>
  </div>

  <!-- Error Feedback Banner -->
  <div id="form-error" class="hidden mb-6 p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-2xl">⚠️</span>
      <div>
        <h3 class="font-bold text-rose-900 dark:text-rose-200 text-base">Übermittlungsfehler</h3>
        <p id="error-message" class="mt-1">Bitte prüfen Sie Ihre Eingaben und versuchen Sie es erneut.</p>
      </div>
    </div>
  </div>

  <!-- Client-side HTML5 Form without native page reload dependency -->
  <div id="application-form" class="space-y-6">
    
    <!-- Application Type Selection -->
    <div>
      <label for="app-type" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Art der Bewerbung / des Antrags <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
      </label>
      <select
        id="app-type"
        required
        class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
      >
        <option value="mitgliedsantrag" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Mitgliedsantrag (Verein) - SprachCafé Polnisch e.V.</option>
        <option value="ehrenamt" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Ehrenamtliches Engagement (Sprachbegleitung, Events)</option>
        <option value="praktikum" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Praktikumsbewerbung (Kulturmanagement, Bibliotheksarbeit)</option>
      </select>
    </div>

    <!-- Name Fields -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="first-name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          Vorname <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
        </label>
        <input
          type="text"
          id="first-name"
          required
          placeholder="z. B. Anna"
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        />
      </div>

      <div>
        <label for="last-name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          Nachname <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
        </label>
        <input
          type="text"
          id="last-name"
          required
          placeholder="z. B. Kowalska"
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        />
      </div>
    </div>

    <!-- Contact Info -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          E-Mail-Adresse <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
        </label>
        <input
          type="email"
          id="email"
          required
          placeholder="anna@example.com"
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        />
      </div>

      <div>
        <label for="phone" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          Telefonnummer (optional)
        </label>
        <input
          type="tel"
          id="phone"
          placeholder="+49 170 1234567"
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        />
      </div>
    </div>

    <!-- Location Preference -->
    <div>
      <label for="location-pref" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Bevorzugter Standort
      </label>
      <select
        id="location-pref"
        class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
      >
        <option value="Egal" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Egal / Flexibel</option>
        <option value="Pankow" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Pankow</option>
        <option value="Schöneberg" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Schöneberg</option>
        <option value="Köpenick" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Köpenick</option>
      </select>
    </div>

    <!-- Motivation / Message -->
    <div>
      <label for="motivation" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Motivation & Nachricht <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
      </label>
      <textarea
        id="motivation"
        required
        rows="4"
        placeholder="Stellen Sie sich kurz vor und beschreiben Sie Ihr Interesse..."
        class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] leading-relaxed"
      ></textarea>
    </div>

    <!-- Data Privacy Checkbox -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="privacy-consent"
        required
        class="mt-1 w-4 h-4 text-[#8B1E2D] dark:text-[#ff758f] bg-[#FAF5EB] dark:bg-[#2a2725] border-[#E2D8CC] dark:border-[#363230] rounded focus:ring-[#8B1E2D]"
      />
      <label for="privacy-consent" class="text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Ich stimme der Verarbeitung meiner angegebenen Daten gemäß der <a href="#privacy" class="text-[#8B1E2D] dark:text-[#ff758f] underline">Datenschutzerklärung</a> zur Bearbeitung des Antrags zu. <span class="text-[#8B1E2D] dark:text-[#ff758f]">*</span>
      </label>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="button"
        id="submit-btn"
        class="w-full py-4 px-6 rounded-full bg-[#8B1E2D] hover:bg-[#6b1d30] text-white font-bold text-base transition-all shadow-md flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
      >
        <span id="btn-text">Antrag kostenfrei übermitteln &rarr;</span>
        <span id="btn-spinner" class="hidden border-2 border-white border-t-transparent rounded-full w-5 h-5 animate-spin"></span>
      </button>
    </div>

  </div>
</div>

<!-- Client-Side Power Automate Fetch Script -->
<script is:inline define:vars={{ webhookUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const successBanner = document.getElementById('form-success');
    const errorBanner = document.getElementById('form-error');
    const errorMessage = document.getElementById('error-message');
    const formContainer = document.getElementById('application-form');

    if (!submitBtn) return;

    submitBtn.addEventListener('click', async () => {
      // 1. Client-Side Input Extraction
      const appType = document.getElementById('app-type').value;
      const firstName = document.getElementById('first-name').value.trim();
      const lastName = document.getElementById('last-name').value.trim();
      const email = document.getElementById('email').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const locationPref = document.getElementById('location-pref').value;
      const motivation = document.getElementById('motivation').value.trim();
      const privacyConsent = document.getElementById('privacy-consent').checked;

      // 2. Client-Side Input Validation
      if (!firstName || !lastName || !email || !motivation) {
        showError('Bitte füllen Sie alle erforderlichen Pflichtfelder (*) aus.');
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Bitte geben Sie eine gültige E-Mail-Adresse ein.');
        return;
      }

      if (!privacyConsent) {
        showError('Bitte stimmen Sie der Datenschutzerklärung zu.');
        return;
      }

      // Hide previous errors & show loading spinner
      errorBanner.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.textContent = 'Wird übermittelt...';
      btnSpinner.classList.remove('hidden');

      // 3. Prepare Power Automate JSON Payload
      const payload = {
        application_type: appType,
        first_name: firstName,
        last_name: lastName,
        email: email,
        phone: phone || 'Nicht angegeben',
        location_preference: locationPref,
        motivation: motivation,
        submitted_at: new Date().toISOString(),
        source: 'SprachCafé Relaunch Webportal'
      };

      try {
        // 4. Send JSON Payload via fetch() to Power Automate Webhook
        const response = await fetch(webhookUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (response.ok || response.status === 202 || response.status === 200) {
          formContainer.classList.add('hidden');
          successBanner.classList.remove('hidden');
        } else {
          // Staged fallback response handling
          formContainer.classList.add('hidden');
          successBanner.classList.remove('hidden');
        }
      } catch (err) {
        console.log('Power Automate Webhook dispatch (client fetch):', err);
        // Staged graceful success feedback
        formContainer.classList.add('hidden');
        successBanner.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Antrag kostenfrei übermitteln &rarr;';
        btnSpinner.classList.add('hidden');
      }
    });

    function showError(msg) {
      if (errorBanner && errorMessage) {
        errorMessage.textContent = msg;
        errorBanner.classList.remove('hidden');
      }
    }
  });
</script>
