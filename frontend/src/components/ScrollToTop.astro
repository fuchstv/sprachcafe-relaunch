---
import { type LanguageCode } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: LanguageCode;
}

const { lang = 'de' } = Astro.props;
const t = useTranslations(lang);
const label = t('scroll.top');
---

<button
  id="scroll-to-top"
  type="button"
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 w-12 h-12 flex items-center justify-center rounded-full bg-[#8B1E2D] hover:bg-[#701824] active:bg-[#54121b] text-white shadow-lg shadow-black/20 hover:shadow-xl hover:-translate-y-1 active:translate-y-0 active:scale-95 transition-all duration-300 ease-in-out opacity-0 pointer-events-none translate-y-4 invisible border border-white/20 dark:border-white/10 dark:bg-[#8B1E2D] dark:hover:bg-[#a52436] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#8B1E2D]/40 dark:focus-visible:ring-[#ff758f]/50 cursor-pointer group"
  aria-label={label}
  title={label}
  tabindex="-1"
  aria-hidden="true"
  data-testid="scroll-to-top"
>
  <svg
    class="w-5 h-5 stroke-current transition-transform duration-200 group-hover:-translate-y-0.5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script is:inline>
  (function () {
    function initScrollToTop() {
      const btn = document.getElementById('scroll-to-top');
      if (!btn) return;

      let isTicking = false;
      const threshold = 300;

      function updateButtonVisibility() {
        const scrolled = window.scrollY || document.documentElement.scrollTop || 0;
        if (scrolled > threshold) {
          if (btn.getAttribute('aria-hidden') === 'true') {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4', 'invisible');
            btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'visible');
            btn.setAttribute('aria-hidden', 'false');
            btn.setAttribute('tabindex', '0');
          }
        } else {
          if (btn.getAttribute('aria-hidden') === 'false') {
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4', 'invisible');
            btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'visible');
            btn.setAttribute('aria-hidden', 'true');
            btn.setAttribute('tabindex', '-1');
          }
        }
        isTicking = false;
      }

      function onScroll() {
        if (!isTicking) {
          window.requestAnimationFrame(updateButtonVisibility);
          isTicking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      updateButtonVisibility();

      btn.addEventListener('click', () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollToTop);
    } else {
      initScrollToTop();
    }
  })();
</script>
