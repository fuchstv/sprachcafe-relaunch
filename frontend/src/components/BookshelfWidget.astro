---
import { getBooks, type BookItem } from "../lib/cms-api";
import { type LanguageCode } from "../i18n/ui";
import { useTranslations, getLocalizedPath } from "../i18n/utils";

interface Props {
  title?: string;
  subtitle?: string;
  lang?: LanguageCode;
  maxBooks?: number;
}

const {
  title,
  subtitle,
  lang = "de",
  maxBooks = 12,
} = Astro.props;

const t = useTranslations(lang);
const l = (p: string) => getLocalizedPath(p, lang);

const allBooks = await getBooks();
// Pick the latest/featured books
const featuredBooks = allBooks.slice(0, maxBooks);

const headingTitle = title || t('bookshelf.title');
const headingSubtitle = subtitle || t('bookshelf.subtitle');
const viewAllText = t('bookshelf.viewAll');
const catalogLink = l('/hausbibliothek/');
---

<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto" aria-labelledby="bookshelf-heading">
  
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#FF758F] text-xs font-bold uppercase tracking-wider mb-2">
        <span>{t('bookshelf.badge')}</span>
      </div>
      <h2 id="bookshelf-heading" class="font-serif text-3xl sm:text-4xl font-bold text-[#1D1B1A] dark:text-[#F5F0EE] tracking-tight">
        {headingTitle}
      </h2>
      <p class="font-sans text-sm sm:text-base text-[#5B403D] dark:text-[#D4C5C2] mt-1 max-w-xl leading-relaxed">
        {headingSubtitle}
      </p>
    </div>

    <!-- Carousel Nav Buttons -->
    <div class="flex items-center gap-2 self-end sm:self-auto">
      <button
        type="button"
        id="bookshelf-prev-btn"
        class="w-10 h-10 rounded-full border border-[#DCD3C7] dark:border-[#4A423F] bg-white dark:bg-[#2A2725] text-[#1D1B1A] dark:text-[#F5F0EE] hover:bg-[#FAF6EE] dark:hover:bg-[#363230] hover:border-[#8B1E2D] flex items-center justify-center transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        aria-label={t('bookshelf.prev')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        type="button"
        id="bookshelf-next-btn"
        class="w-10 h-10 rounded-full border border-[#DCD3C7] dark:border-[#4A423F] bg-white dark:bg-[#2A2725] text-[#1D1B1A] dark:text-[#F5F0EE] hover:bg-[#FAF6EE] dark:hover:bg-[#363230] hover:border-[#8B1E2D] flex items-center justify-center transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        aria-label={t('bookshelf.next')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Wooden Bookshelf Construction Container (3D Shadowbox Depth) -->
  <div class="relative bg-[#2B1810] dark:bg-[#1A0F0A] border-4 border-[#3E2723] rounded-3xl p-6 sm:p-8 shadow-[inset_0_6px_20px_rgba(0,0,0,0.8),0_16px_40px_rgba(20,10,5,0.4)] overflow-hidden">
    
    <!-- Warm Wood Grain Texture Overlay & Bevel Lighting -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#5D4037]/30 via-transparent to-black/60 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-[#8D6E63]/40 to-transparent pointer-events-none" aria-hidden="true"></div>

    <!-- Book Spines / Covers Carousel Track -->
    <div
      id="bookshelf-scroll-container"
      class="flex gap-6 sm:gap-8 overflow-x-auto pb-4 pt-4 px-2 scroll-smooth no-scrollbar relative z-10"
      tabindex="0"
      aria-label={t('bookshelf.carouselLabel')}
    >
      {featuredBooks.map((book: BookItem) => (
        <div class="group shrink-0 w-36 sm:w-44 flex flex-col items-center">
          
          <!-- Upright Standing Book Cover on Shelf with 3D Depth & Shadow -->
          <a
            href={l(`/hausbibliothek/${book.id}/`)}
            class="relative block w-full aspect-[2/3] rounded-lg overflow-hidden shadow-[0_12px_28px_rgba(0,0,0,0.7)] transform group-hover:-translate-y-2 group-hover:scale-105 transition-all duration-300 bg-[#3E2723] focus:outline-none focus:ring-2 focus:ring-[#FF758F]"
            title={`${book.title} ${t('bookshelf.byAuthor')} ${book.author}`}
          >
            {book.cover ? (
              <img
                src={book.cover}
                alt={`${book.title} - ${book.author}`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full p-3 flex flex-col justify-between bg-gradient-to-b from-[#8B1E2D] to-[#4A0E17] text-white">
                <span class="text-[10px] font-bold uppercase tracking-widest text-[#FFB3AC]">{book.language}</span>
                <span class="font-serif font-bold text-xs leading-tight line-clamp-3">{book.title}</span>
                <span class="text-[10px] text-[#FFDAD6] truncate">{book.author}</span>
              </div>
            )}

            <!-- 3D Book Spine Left Shadow & Corner Emboss Effect -->
            <div class="absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/50 via-white/10 to-transparent pointer-events-none" aria-hidden="true"></div>
            <!-- Glass / Satin Sheen on Hover -->
            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/20 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" aria-hidden="true"></div>
          </a>

          <!-- Book Metadata Tag below cover -->
          <div class="mt-3 text-center w-full px-1">
            <h3 class="font-serif text-xs sm:text-sm font-bold text-[#F5F0EE] group-hover:text-[#FF758F] transition-colors truncate">
              {book.title}
            </h3>
            <p class="font-sans text-[11px] text-[#D4C5C2] truncate mt-0.5">
              {book.author}
            </p>
            <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-[#8B1E2D]/90 text-white border border-[#FF758F]/30 shadow-sm">
              📍 {book.location}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- 3D Wooden Shelf Ledge / Plank at Bottom with Bevel -->
    <div class="relative mt-2 h-5 sm:h-6 bg-gradient-to-b from-[#6D4C41] via-[#4E342E] to-[#1B0D07] border-t border-[#A1887F]/40 rounded-sm shadow-[0_6px_16px_rgba(0,0,0,0.9)]" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-0.5 bg-[#8D6E63]/60"></div>
      <div class="absolute inset-x-0 bottom-0 h-2 bg-[#120804]"></div>
    </div>

  </div>

  <!-- Bottom Link to Full Catalog -->
  <div class="mt-8 text-center">
    <a
      href={catalogLink}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white dark:bg-[#22201E] border border-[#DCD3C7] dark:border-[#4A423F] text-[#8B1E2D] dark:text-[#FF758F] font-bold text-sm hover:border-[#8B1E2D] hover:bg-[#FAF6EE] transition-all shadow-sm group focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
    >
      <span>{viewAllText}</span>
      <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
    </a>
  </div>

</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("bookshelf-scroll-container");
    const prevBtn = document.getElementById("bookshelf-prev-btn");
    const nextBtn = document.getElementById("bookshelf-next-btn");

    if (container && prevBtn && nextBtn) {
      prevBtn.addEventListener("click", () => {
        container.scrollBy({ left: -280, behavior: "smooth" });
      });
      nextBtn.addEventListener("click", () => {
        container.scrollBy({ left: 280, behavior: "smooth" });
      });
    }
  });
</script>