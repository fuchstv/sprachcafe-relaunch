    pankow: {
      id: "pankow",
      name: "Pankow",
      slogan: "Zielona dzielnica & Siedziba",
      address: "Schulzestraße 1, 13187 Berlin",
      hours: "Wt & Czw: 14:00 – 18:00 | Sob: 10:00 – 14:00",
      transit: "S1, S2, S25, S26, S+U Pankow, Tram M1, 50",
