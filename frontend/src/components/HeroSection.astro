---
interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  images?: string[];
  lang?: "de" | "pl" | "en";
}

const {
  title,
  subtitle,
  badge = "☕ Kultur- & Begegnungszentrum in Berlin",
  primaryCtaText = "Veranstaltungen entdecken",
  primaryCtaLink = "/events/",
  secondaryCtaText = "Hausbibliothek Katalog",
  secondaryCtaLink = "/hausbibliothek/",
  images = [
    "/images/hero/hero-collage-1.avif",
    "/images/hero/hero-collage-2.avif",
    "/images/hero/hero-collage-3.avif"
  ],
  lang = "de",
} = Astro.props;
---

<section class="relative py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto overflow-hidden">
  
  <!-- Subtle warm ambient background glow -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#D97706]/10 dark:bg-[#D97706]/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/2 -right-24 w-80 h-80 bg-[#8B1E2D]/10 dark:bg-[#8B1E2D]/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
    
    <!-- Hero Text Content -->
    <div class="lg:col-span-7 text-center lg:text-left">
      
      <!-- Warm Badge with Icon -->
      {badge && (
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#FAF5EB] dark:bg-[#2A2725] border border-[#E2D8CC] dark:border-[#3A3532] text-[#8B1E2D] dark:text-[#FF758F] text-xs sm:text-sm font-bold mb-6 shadow-sm">
          <span>{badge}</span>
        </div>
      )}

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-[#1D1B1A] dark:text-[#F5F0EE] tracking-tight leading-[1.15] mb-6">
        {title}
      </h1>

      <p class="font-sans text-base sm:text-lg lg:text-xl text-[#5B403D] dark:text-[#D4C5C2] max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        {primaryCtaText && (
          <a
            href={primaryCtaLink}
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#8B1E2D] hover:bg-[#6E1420] text-white font-bold transition-all shadow-md text-center flex items-center justify-center gap-2 group text-base"
          >
            <span>{primaryCtaText}</span>
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        )}
        {secondaryCtaText && (
          <a
            href={secondaryCtaLink}
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#3A3532] text-[#1D1B1A] dark:text-[#F5F0EE] font-bold hover:border-[#8B1E2D] hover:bg-[#FAF6EE] dark:hover:bg-[#2A2725] transition-all text-center text-base shadow-sm"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-10 pt-6 border-t border-[#E2D8CC]/80 dark:border-[#363230] flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs sm:text-sm text-[#5B403D] dark:text-[#D4C5C2]">
        <div class="flex items-center gap-2">
          <span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span>
          <span>Eintritt frei / Spendenbasis</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span>
          <span>Bilingual Deutsch & Polnisch</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span>
          <span>3 Standorte in Berlin</span>
        </div>
      </div>

    </div>

    <!-- Organic Image Collage (Stitch Variant 1 Style) -->
    <div class="lg:col-span-5 relative">
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <div class="h-48 sm:h-56 rounded-3xl overflow-hidden border-2 border-white dark:border-[#363230] shadow-[0_8px_25px_rgba(42,36,33,0.12)]">
            <img src={images[0]} alt="SprachCafé Begegnung und Austausch" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="h-36 sm:h-44 rounded-3xl overflow-hidden border-2 border-white dark:border-[#363230] shadow-[0_8px_25px_rgba(42,36,33,0.12)]">
            <img src={images[1]} alt="Gemeinschaft im SprachCafé" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
        <div class="pt-8 space-y-4">
          <div class="h-64 sm:h-72 rounded-3xl overflow-hidden border-2 border-white dark:border-[#363230] shadow-[0_8px_25px_rgba(42,36,33,0.12)]">
            <img src={images[2]} alt="Hausbibliothek und Leseraum" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
      </div>
    </div>

  </div>
</section>