---
interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  images?: string[];
}

const {
  title,
  subtitle,
  badge = "Willkommen im SprachCafé Polnisch",
  primaryCtaText = "Nächste Termine entdecken",
  primaryCtaLink = "/events/",
  secondaryCtaText = "Bibliothekskatalog",
  secondaryCtaLink = "/hausbibliothek/",
  images = [
    "https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=800&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=800&auto=format&fit=crop"
  ]
} = Astro.props;
---

<section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Hero Text Content -->
    <div class="lg:col-span-7 text-center lg:text-left">
      {badge && (
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-sm font-semibold mb-6">
          <span>{badge}</span>
        </div>
      )}

      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-brand-text-muted max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
        {primaryCtaText && (
          <a
            href={primaryCtaLink}
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-brand-primary-light text-slate-950 font-bold hover:bg-sky-300 transition-colors shadow-lg shadow-sky-500/20 text-center"
          >
            {primaryCtaText} &rarr;
          </a>
        )}
        {secondaryCtaText && (
          <a
            href={secondaryCtaLink}
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-white font-semibold hover:bg-slate-700 transition-colors text-center"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>

    <!-- Image Collage -->
    <div class="lg:col-span-5 relative">
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <div class="h-48 sm:h-56 rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
            <img src={images[0]} alt="SprachCafé Begegnung 1" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="h-32 sm:h-40 rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
            <img src={images[1]} alt="SprachCafé Begegnung 2" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
        <div class="pt-8">
          <div class="h-64 sm:h-72 rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
            <img src={images[2]} alt="SprachCafé Begegnung 3" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
