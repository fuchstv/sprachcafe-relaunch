const t = content[lang] || content.de;
---

<div class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-[0_4px_24px_rgba(51,49,48,0.06)]" id="kinder-anmeldung-container">
  
  <div class="mb-8 pb-6 border-b border-[#e7e1df] dark:border-[#363230]">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
      <span>🎈</span>
      <span>{t.badge}</span>
    </span>
    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-2 tracking-tight">
      {t.title}
    </h2>
    <p class="font-sans text-sm sm:text-base text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
      {t.subtitle}
    </p>
  </div>

  <!-- Success Notification Box (Initially Hidden) -->
  <div id="kinder-success-box" class="hidden mb-8 p-6 sm:p-8 rounded-2xl bg-[#1e6e23]/10 border-2 border-[#1e6e23] text-[#1e6e23] dark:text-[#4ade80] animate-fadeIn">
    <div class="flex items-start gap-4">
      <div class="text-3xl sm:text-4xl">🎉</div>
      <div class="space-y-2">
        <h3 class="font-serif text-xl sm:text-2xl font-bold">
          {t.successTitle}
        </h3>
        <p class="font-sans text-sm sm:text-base leading-relaxed">
          {t.successText}
        </p>
      </div>
    </div>
  </div>

  <!-- Error Notification Box (Initially Hidden) -->
  <div id="kinder-error-box" class="hidden mb-8 p-5 rounded-2xl bg-[#b91c1c]/10 border border-[#b91c1c] text-[#b91c1c] dark:text-[#ff6b6b]">
    <div class="flex items-center gap-3">
      <span class="text-2xl">⚠️</span>
      <div>
        <h4 class="font-bold text-sm">{t.errorTitle}</h4>
        <p class="text-xs" id="kinder-error-msg">{t.errorText}</p>
      </div>
    </div>
  </div>

  <!-- Registration Form -->
  <form id="kinder-anmeldung-form" data-webhook={webhookUrl} data-lang={lang} class="space-y-8" novalidate>
    
    <!-- Section 1: Dates and Details -->
    <fieldset class="space-y-6">
      <legend class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] flex items-center gap-2 mb-4">
        <span>📅</span>
        <span>{t.section1Title}</span>
      </legend>

      <p class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] mb-3">
        {t.bookingLead}
      </p>

      <!-- Date Pickers Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="date_from" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {t.dateFromLabel} *
          </label>
          <input
            type="date"
            id="date_from"
            name="date_from"
            min="2026-09-01"
            max="2027-01-31"
            value="2026-09-01"
            required
            class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          />
        </div>

        <div>
          <label for="date_to" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {t.dateToLabel} *
          </label>
          <input
            type="date"
            id="date_to"
            name="date_to"
            min="2026-09-01"
            max="2027-01-31"
            value="2027-01-31"
            required
            class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          />
        </div>
      </div>

      <!-- Child Name & Age -->
      <div>
        <label for="child_name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          {t.childLabel}
        </label>
        <input
          type="text"
          id="child_name"
          name="child_name"
          placeholder={t.childPlaceholder}
          required
          autocomplete="off"
          class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
        />
      </div>

      <!-- Parent Name -->
      <div>
        <label for="parent_name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          {t.parentLabel}
        </label>
        <input
          type="text"
          id="parent_name"
          name="parent_name"
          placeholder={t.parentPlaceholder}
          required
          autocomplete="name"
          class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
        />
      </div>

      <!-- Email & Phone Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {t.emailLabel}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder={t.emailPlaceholder}
            required
            autocomplete="email"
            class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          />
        </div>

        <div>
          <label for="phone" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {t.phoneLabel}
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder={t.phonePlaceholder}
            autocomplete="tel"
            class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
          />
        </div>
      </div>

      <!-- Location Select -->
      <div>
        <label for="location" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          {t.locationLabel}
        </label>
        <select
          id="location"
          name="location"
          required
          class="w-full px-4 py-3 bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-sm text-[#1d1b1a] dark:text-[#f5f0ee] focus:outline-none focus:ring-2 focus:ring-[#8B263E]"
        >
          {t.locationOptions.map(opt => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
      </div>
    </fieldset>

    <!-- Section 2: Bankverbindung Info Box -->
    <section class="p-6 rounded-2xl bg-[#faf6f3] dark:bg-[#181615] border border-[#e7e1df] dark:border-[#363230] space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">🏦</span>
        <h3 class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee]">
          {t.section2Title}
        </h3>
      </div>
      <p class="text-xs sm:text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        {t.bankIntro}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="space-y-1">
          <p><strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">Empfänger:</strong> {t.bankAccountHolder}</p>
          <p><strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">Bank:</strong> {t.bankName}</p>
          <p><strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">BIC:</strong> <code class="font-mono bg-white dark:bg-[#22201e] px-1.5 py-0.5 rounded border border-[#e7e1df] dark:border-[#363230]">{t.bic}</code></p>
        </div>

        <div class="space-y-2">
          <div>
            <span class="block font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">IBAN:</span>
            <div class="flex items-center gap-2">
              <code class="font-mono font-bold text-xs sm:text-sm bg-white dark:bg-[#22201e] px-3 py-1.5 rounded-lg border border-[#e7e1df] dark:border-[#363230] text-[#8B263E] dark:text-[#ff758f]" id="iban-display">
                {t.iban}
              </code>
              <button
                type="button"
                id="copy-iban-button"
                data-iban={t.iban}
                class="px-2.5 py-1.5 bg-[#8B263E] hover:bg-[#6e1e31] text-white text-xs font-bold rounded-lg transition-colors shadow-sm flex items-center gap-1 cursor-pointer"
              >
                <span>📋</span>
                <span id="copy-btn-label">{t.copyIban}</span>
              </button>
            </div>
          </div>
          <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-900 dark:text-amber-200 text-xs">
            <strong>{t.purposeLabel}</strong><br/>
            <span>{t.purposeHint}</span>
          </div>
        </div>
      </div>

      <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2] italic pt-1">
        ℹ️ {t.proofNotice}
      </p>
    </section>

    <!-- Section 3: Legal & Terms -->
    <fieldset class="space-y-4">
      <legend class="font-serif text-lg font-bold text-[#1d1b1a] dark:text-[#f5f0ee] flex items-center gap-2 mb-2">
        <span>⚖️</span>
        <span>{t.section3Title}</span>
      </legend>

      <div class="space-y-3 text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed bg-[#faf6f3] dark:bg-[#181615] p-4 rounded-xl border border-[#e7e1df] dark:border-[#363230]">
        <p><strong>Haftung &amp; Fürsorge:</strong> {t.liabilityText}</p>
        <p><strong>Foto-/Video-Material:</strong> {t.photoText}</p>
        <p><strong>Datenschutz (DSGVO):</strong> {t.privacyText}</p>
      </div>

      <div class="pt-2">
        <label class="flex items-start gap-3 cursor-pointer group">
          <input
            type="checkbox"
            id="acceptance_terms"
            name="acceptance_terms"
            required
            class="mt-1 w-4 h-4 rounded text-[#8B263E] border-[#e7e1df] dark:border-[#363230] focus:ring-[#8B263E]"
          />
          <span class="text-xs sm:text-sm font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] group-hover:text-[#8B263E] dark:group-hover:text-[#ff758f] transition-colors">
            {t.acceptTermsLabel}
          </span>
        </label>
      </div>
    </fieldset>

    <!-- Submit Button -->
    <div class="pt-4 border-t border-[#e7e1df] dark:border-[#363230] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
        🔒 Gesicherte SSL-Übertragung &amp; DSGVO-konforme Speicherung
      </p>

      <button
        type="submit"
        id="kinder-submit-btn"
        class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-[#8B263E] hover:bg-[#6e1e31] text-white font-bold text-base transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-3 cursor-pointer focus:outline-none focus:ring-4 focus:ring-[#8B263E]/30"
      >
        <span id="kinder-submit-text">{t.submitBtn}</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>
    </div>
  </form>
</div>

<script>
  // Clipboard helper for IBAN
  const copyBtn = document.getElementById('copy-iban-button');
  const copyLabel = document.getElementById('copy-btn-label');

  copyBtn?.addEventListener('click', () => {
    const iban = copyBtn.getAttribute('data-iban') || 'DE61 8306 5408 0404 9743 36';
    navigator.clipboard.writeText(iban.replace(/\s+/g, '')).then(() => {
      if (copyLabel) {
        const origText = copyLabel.textContent;
        copyLabel.textContent = 'Kopiert! ✓';
        copyBtn.classList.add('bg-green-700');
        setTimeout(() => {
          copyLabel.textContent = origText;
          copyBtn.classList.remove('bg-green-700');
        }, 2000);
      }
    });
  });

  // Form submission handler
  const form = document.getElementById('kinder-anmeldung-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('kinder-submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('kinder-submit-text');
  const successBox = document.getElementById('kinder-success-box');
  const errorBox = document.getElementById('kinder-error-box');
  const errorMsg = document.getElementById('kinder-error-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);
    const payload = {
      child_name: formData.get('child_name'),
      parent_name: formData.get('parent_name'),
      email: formData.get('email'),
      phone: formData.get('phone') || '',
      location: formData.get('location'),
      date_from: formData.get('date_from'),
      date_to: formData.get('date_to'),
      acceptance_terms: formData.get('acceptance_terms') === 'on',
      lang: form.getAttribute('data-lang') || 'de',
      submittedAt: new Date().toISOString()
    };

    const webhookUrl = form.getAttribute('data-webhook');

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = payload.lang === 'pl' ? 'Wysyłanie...' : payload.lang === 'en' ? 'Submitting...' : 'Wird übermittelt...';
    }

    try {
      if (webhookUrl && webhookUrl.startsWith('http')) {
        const res = await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          throw new Error(`Server status ${res.status}`);
        }
      } else {
        // Fallback simulation for local/staging environment
        await new Promise(r => setTimeout(r, 600));
        console.log('[KINDER-ANMELDUNG] Form payload registered locally:', payload);
      }

      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
      successBox?.scrollIntoView({ behavior: 'smooth' });
    } catch (err: any) {
      console.error('[KINDER-ANMELDUNG-ERROR]', err);
      if (errorBox) {
        errorBox.classList.remove('hidden');
        if (errorMsg) {
          errorMsg.textContent = payload.lang === 'pl'
            ? 'Błąd połączenia. Prosimy spróbować ponownie lub napisać na kontakt@sprachcafe-polnisch.org.'
            : payload.lang === 'en'
            ? 'Connection error. Please try again or write to kontakt@sprachcafe-polnisch.org.'
            : 'Verbindungsfehler beim Absenden. Bitte versuchen Sie es erneut oder schreiben Sie uns an kontakt@sprachcafe-polnisch.org.';
        }
      }
    } finally {
      if (submitBtn && submitText) {
        submitBtn.disabled = false;
        submitText.textContent = payload.lang === 'pl' ? 'Wyślij zgłoszenie' : payload.lang === 'en' ? 'Submit Registration' : 'Anmeldung verbindlich senden';
      }
    }
  });
</script>
