---
interface Props {
  webhookUrl?: string;
  lang?: 'de' | 'pl' | 'en';
}

const {
  webhookUrl = import.meta.env.PUBLIC_POWER_AUTOMATE_KINDER_WEBHOOK_URL || "",
  lang = 'de'
} = Astro.props;

