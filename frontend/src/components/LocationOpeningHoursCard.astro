---
export interface OpeningHourItem {
  day: string;
  time: string;
}

interface Props {
  id?: string;
  location: string;
  address: string;
  subTitle?: string;
  openingHours?: string;
  hours?: OpeningHourItem[];
  contactEmail?: string;
  mapUrl?: string;
}

const {
  id,
  location,
  address,
  subTitle,
  openingHours,
  hours
} = Astro.props;
---

<div id={id} class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 shadow-[0_4px_20px_rgba(51,49,48,0.05)] flex flex-col justify-between hover:border-[#8B263E]/50 transition-all scroll-mt-24">
  <div>
    <div class="flex items-center justify-between mb-4">
      <span class="px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase">
        📍 {location}
      </span>
      <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2] font-medium">SprachCafé & Hausbibliothek</span>
    </div>

    <h3 class="font-serif text-xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] mb-1">{location}</h3>
    {subTitle && <p class="text-xs text-[#8B263E] dark:text-[#ff758f] font-semibold mb-2">{subTitle}</p>}
    <p class="text-sm text-[#5b403d] dark:text-[#d4c5c2] mb-6 leading-relaxed whitespace-pre-line">
      🏢 {address}
    </p>

    <div class="space-y-2 text-sm border-t border-[#e7e1df] dark:border-[#363230] pt-4">
      <h4 class="text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">🕒 Öffnungszeiten & Treffen</h4>
      {openingHours ? (
        <p class="text-[#5b403d] dark:text-[#d4c5c2] whitespace-pre-line leading-relaxed text-sm">{openingHours}</p>
      ) : hours ? (
        hours.map((item) => (
          <div class="flex justify-between text-[#5b403d] dark:text-[#d4c5c2] py-0.5 gap-2">
            <span class="text-[#5b403d] dark:text-[#d4c5c2]">{item.day}:</span>
            <span class="font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] text-right">{item.time}</span>
          </div>
        ))
      ) : null}
    </div>
  </div>
</div>
