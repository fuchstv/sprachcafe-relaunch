---
export interface OpeningHourItem {
  day: string;
  time: string;
}

interface Props {
  location: 'Pankow' | 'Schöneberg' | 'Köpenick';
  address: string;
  hours: OpeningHourItem[];
  contactEmail?: string;
  mapUrl?: string;
}

const {
  location,
  address,
  hours,
  contactEmail = "pankow@sprachcafe-polnisch.org",
  mapUrl = "#"
} = Astro.props;
---

<div class="bg-brand-surface border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between hover:border-slate-700 transition-colors">
  <div>
    <div class="flex items-center justify-between mb-4">
      <span class="px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-brand-primary-light text-xs font-bold uppercase">
        📍 Standort {location}
      </span>
      <span class="text-xs text-slate-400 font-medium">SprachCafé & Hausbibliothek</span>
    </div>

    <h3 class="text-xl font-bold text-white mb-2">SprachCafé {location}</h3>
    <p class="text-sm text-brand-text-muted mb-6 leading-relaxed">
      🏢 {address}
    </p>

    <div class="space-y-2 text-sm border-t border-slate-800/80 pt-4 mb-6">
      <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">🕒 Öffnungszeiten & Treffen</h4>
      {hours.map((item) => (
        <div class="flex justify-between text-slate-300 py-0.5">
          <span class="text-brand-text-muted">{item.day}:</span>
          <span class="font-semibold text-white">{item.time}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-2 text-xs">
    <a href={`mailto:${contactEmail}`} class="text-brand-primary-light hover:underline">
      ✉️ {contactEmail}
    </a>
    <a href={mapUrl} class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-200 font-semibold hover:bg-slate-700 transition-colors">
      Route planen &rarr;
    </a>
  </div>
</div>
