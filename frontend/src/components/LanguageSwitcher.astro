---
import { languages, type LanguageCode } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  currentLang: LanguageCode;
}

const { currentLang } = Astro.props;
const pathname = Astro.url.pathname;
const t = useTranslations(currentLang);
---

<nav class="inline-flex items-center bg-slate-800/80 border border-slate-700/80 rounded-full p-1 shadow-inner" aria-label={t('lang.switch')}>
  <ul class="flex items-center gap-1 list-none m-0 p-0">
    {Object.entries(languages).map(([code, langInfo]) => {
      const targetLang = code as LanguageCode;
      const isActive = targetLang === currentLang;
      const targetUrl = getLocalizedPath(pathname, targetLang);

      return (
        <li>
          <a
            href={targetUrl}
            class:list={[
              'flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold tracking-wider transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900',
              isActive
                ? 'bg-brand-primary-light text-slate-950 shadow-md font-bold'
                : 'text-brand-text-muted hover:text-brand-text hover:bg-slate-700/60'
            ]}
            aria-current={isActive ? 'page' : undefined}
            title={langInfo.name}
          >
            <span class="text-sm" aria-hidden="true">{langInfo.flag}</span>
            <span>{langInfo.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
