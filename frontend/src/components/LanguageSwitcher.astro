---
import { languages, type LanguageCode } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  currentLang: LanguageCode;
}

const { currentLang } = Astro.props;
const pathname = Astro.url.pathname;
const t = useTranslations(currentLang);
---

<nav class="inline-flex items-center bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-full p-1 shadow-sm" aria-label={t('lang.switch')}>
  <ul class="flex items-center gap-1 list-none m-0 p-0">
    {Object.entries(languages).map(([code, langInfo]) => {
      const targetLang = code as LanguageCode;
      const isActive = targetLang === currentLang;
      const targetUrl = getLocalizedPath(pathname, targetLang);

      return (
        <li>
          <a
            href={targetUrl}
            class:list={[
              'flex items-center gap-1 px-2.5 py-1 rounded-full text-xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]',
              isActive
                ? 'bg-[#8B1E2D] text-white font-bold shadow-sm'
                : 'text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 font-semibold'
            ]}
            aria-current={isActive ? 'page' : undefined}
            title={langInfo.name}
          >
            <span class="text-xs" aria-hidden="true">{langInfo.flag}</span>
            <span>{langInfo.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
