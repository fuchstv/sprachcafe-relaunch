---

<div class="membership-form-container bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-[0_4px_25px_rgba(51,49,48,0.06)] max-w-4xl mx-auto my-12" id="mitglied-form">
  <div class="mb-8 text-center sm:text-left">
    <span class="inline-block px-3 py-1 rounded-full bg-[#8B1E2D]/10 border border-[#8B1E2D]/20 text-[#8B1E2D] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-2">
      {current.badge}
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">{current.title}</h2>
    <p class="mt-2 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
      {current.subtitle}
    </p>
  </div>

  <!-- Success Banner -->
  <div id="member-form-success" class="hidden mb-6 p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-3xl">🎉</span>
      <div>
        <h3 class="font-bold text-emerald-900 dark:text-emerald-200 text-base">{current.successTitle}</h3>
        <p class="mt-1">{current.successText}</p>
      </div>
    </div>
  </div>

  <!-- Error Banner -->
  <div id="member-form-error" class="hidden mb-6 p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-3xl">⚠️</span>
      <div>
        <h3 class="font-bold text-rose-900 dark:text-rose-200 text-base">{current.errorTitle}</h3>
        <p id="member-error-msg" class="mt-1">{current.errorText}</p>
      </div>
    </div>
  </div>

  <!-- HTML5 Native Form -->
  <form id="membership-native-form" class="space-y-8" data-webhook={webhookUrl}>
    
    <!-- 1. Allgemeine Angaben -->
    <div class="space-y-4 pt-2">
      <h3 class="font-serif text-xl font-bold text-[#8B1E2D] dark:text-[#ff758f] border-b border-[#E2D8CC] dark:border-[#363230] pb-2">
        {current.generalTitle}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label for="member-fullname" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.nameLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <input
            type="text"
            id="member-fullname"
            required
            placeholder={current.namePlaceholder}
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <div>
          <label for="member-birthdate" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.birthLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <input
            type="date"
            id="member-birthdate"
            required
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

