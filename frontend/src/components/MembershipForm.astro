          <label for="member-occupation" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.occupationLabel}
          </label>
          <input
            type="text"
            id="member-occupation"
            placeholder={current.occupationPlaceholder}
