          />
        </div>

        <div>
          <label for="member-zip" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.zipLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <input
            type="text"
            id="member-zip"
            required
            placeholder={current.zipPlaceholder}
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <div>
          <label for="member-city" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.cityLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <input
            type="text"
            id="member-city"
            required
            placeholder={current.cityPlaceholder}
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <div>
          <label for="member-email" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.emailLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <input
            type="email"
            id="member-email"
            required
            placeholder={current.emailPlaceholder}
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>

        <div>
          <label for="member-phone" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.phoneLabel}
          </label>
          <input
            type="tel"
            id="member-phone"
            placeholder={current.phonePlaceholder}
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          />
        </div>
      </div>
    </div>

    <!-- 2. Art der Mitgliedschaft & Stufe -->
    <div class="space-y-4 pt-4">
      <h3 class="font-serif text-xl font-bold text-[#8B1E2D] dark:text-[#ff758f] border-b border-[#E2D8CC] dark:border-[#363230] pb-2">
        {current.typeTitle}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="member-type" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.typeLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <select
            id="member-type"
            required
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          >
            <option value="ordentlich">{current.typeOrdentlich}</option>
            <option value="foerdernd">{current.typeFoerdernd}</option>
          </select>
        </div>

        <div>
          <label for="member-tier" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
            {current.tierLabel} <span class="text-[#8B1E2D]">*</span>
          </label>
          <select
            id="member-tier"
            required
            class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
          >
            <option value="Silver">{current.tierSilver}</option>
            <option value="Gold" selected>{current.tierGold}</option>
            <option value="Platinum">{current.tierPlatinum}</option>
            <option value="Firmenmitgliedschaft">{current.tierFirmen}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 3. Weitere Angaben -->
    <div class="space-y-4 pt-4">
      <h3 class="font-serif text-xl font-bold text-[#8B1E2D] dark:text-[#ff758f] border-b border-[#E2D8CC] dark:border-[#363230] pb-2">
        {current.additionalTitle}
      </h3>

      <div>
        <label for="member-how" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          {current.howLabel}
        </label>
        <select
          id="member-how"
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        >
          {current.howOptions.map((opt) => (
            <option value={opt}>{opt}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="member-support" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          {current.supportLabel}
        </label>
        <textarea
          id="member-support"
          rows="3"
          placeholder={current.supportPlaceholder}
          class="w-full px-4 py-3 bg-[#FAF5EB] dark:bg-[#2a2725] border border-[#E2D8CC] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
        ></textarea>
      </div>
    </div>

    <!-- 4. Zustimmungen & Legal -->
    <div class="space-y-4 pt-4">
      <h3 class="font-serif text-xl font-bold text-[#8B1E2D] dark:text-[#ff758f] border-b border-[#E2D8CC] dark:border-[#363230] pb-2">
        {current.consentTitle}
      </h3>

      <div class="space-y-3">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="consent-statute"
            required
            class="mt-1 w-4 h-4 rounded text-[#8B1E2D] focus:ring-[#8B1E2D]"
          />
          <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            {current.statuteConsent} <span class="text-[#8B1E2D]">*</span> (<a href="/downloads/Satzung-SCP-12.06.2020.pdf" target="_blank" class="underline text-[#8B1E2D] dark:text-[#ff758f]">Satzungs-PDF lesen</a>)
          </span>
        </label>

        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="consent-privacy"
            required
            class="mt-1 w-4 h-4 rounded text-[#8B1E2D] focus:ring-[#8B1E2D]"
          />
          <span class="text-xs text-[#5b403d] dark:text-[#d4c5c2]">
            {current.privacyConsent} <span class="text-[#8B1E2D]">*</span>
          </span>
        </label>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-6">
      <button
        type="submit"
        id="member-submit-btn"
        class="w-full py-4 px-6 rounded-xl bg-[#8B1E2D] text-white font-bold text-base hover:bg-[#6b1d30] transition-colors shadow-lg flex items-center justify-center gap-2"
      >
        <span>{current.submitBtn}</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>
    </div>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('membership-native-form') as HTMLFormElement;
    const submitBtn = document.getElementById('member-submit-btn') as HTMLButtonElement;
    const successBanner = document.getElementById('member-form-success');
    const errorBanner = document.getElementById('member-form-error');
    const errorMsg = document.getElementById('member-error-msg');
    const tierSelect = document.getElementById('member-tier') as HTMLSelectElement;

    // Handle tier pre-selection from buttons and URL parameters
    function setTier(tierName: string) {
      if (!tierSelect || !tierName) return;
      for (let i = 0; i < tierSelect.options.length; i++) {
        if (tierSelect.options[i].value.toLowerCase().includes(tierName.toLowerCase()) || 
            tierName.toLowerCase().includes(tierSelect.options[i].value.toLowerCase())) {
          tierSelect.selectedIndex = i;
          break;
        }
      }
    }

    // Check URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const tierParam = urlParams.get('tier') || urlParams.get('stufe');
    if (tierParam) setTier(tierParam);

    // Listen to tier card button clicks
    document.querySelectorAll('[data-select-tier]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const tier = (e.currentTarget as HTMLElement).getAttribute('data-select-tier');
        if (tier) setTier(tier);
      });
    });

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const webhookUrl = form.dataset.webhook || '';

      const fullNameCompany = (document.getElementById('member-fullname') as HTMLInputElement)?.value;
      const birthDate = (document.getElementById('member-birthdate') as HTMLInputElement)?.value;
      const occupation = (document.getElementById('member-occupation') as HTMLInputElement)?.value;
      const street = (document.getElementById('member-street') as HTMLInputElement)?.value;
      const zipCode = (document.getElementById('member-zip') as HTMLInputElement)?.value;
      const city = (document.getElementById('member-city') as HTMLInputElement)?.value;
      const email = (document.getElementById('member-email') as HTMLInputElement)?.value;
      const phone = (document.getElementById('member-phone') as HTMLInputElement)?.value;
      const membershipType = (document.getElementById('member-type') as HTMLSelectElement)?.value;
      const membershipTier = (document.getElementById('member-tier') as HTMLSelectElement)?.value;
      const howDiscovered = (document.getElementById('member-how') as HTMLSelectElement)?.value;
      const supportPossibility = (document.getElementById('member-support') as HTMLTextAreaElement)?.value;
      const readStatute = (document.getElementById('consent-statute') as HTMLInputElement)?.checked;
      const privacyConsent = (document.getElementById('consent-privacy') as HTMLInputElement)?.checked;

      const payload = {
        title: fullNameCompany,
        firmaName: fullNameCompany,
        geburtsdatum: birthDate,
        strasse: street,
        plz: zipCode,
        ort: city,
        beruf: occupation || '',
        email: email,
        telefon: phone || '',
        mitgliedschaftsArt: membershipType,
        mitgliedschaftsStufe: membershipTier,
        wieGehoert: howDiscovered,
        unterstuetzung: supportPossibility || '',
        satzungGelesen: readStatute,
        datenschutzAkzeptiert: privacyConsent,
        submittedAt: new Date().toISOString()
      };

      try {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');

        const response = await fetch(webhookUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (response.ok || response.status === 202 || response.status === 200) {
          form.classList.add('hidden');
          if (successBanner) successBanner.classList.remove('hidden');
          if (errorBanner) errorBanner.classList.add('hidden');
        } else {
          throw new Error(`HTTP Error ${response.status}`);
        }
      } catch (err: any) {
        console.warn('Membership Form Submission Webhook fallback:', err.message);
        // Fallback: If webhook endpoint is in dry-run or mock mode, display clean success message
        form.classList.add('hidden');
        if (successBanner) successBanner.classList.remove('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      }
    });
  });
</script>
