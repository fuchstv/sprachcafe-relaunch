---
interface Props {
  placeholder?: string;
}

const { placeholder = "Suchen Sie nach Events, Büchern, Themen..." } = Astro.props;
---

<div class="pagefind-search-container bg-brand-surface border border-slate-800 rounded-2xl p-6 shadow-2xl">
  
  <!-- Search Input & Filters Bar -->
  <div class="space-y-4">
    <div class="relative">
      <label for="pagefind-input" class="sr-only">Volltextsuche</label>
      <input
        type="search"
        id="pagefind-input"
        placeholder={placeholder}
        class="w-full pl-11 pr-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white text-base focus:outline-none focus:ring-2 focus:ring-brand-focus"
      />
      <div class="absolute left-3.5 top-3.5 text-slate-400 pointer-events-none" aria-hidden="true">
        🔍
      </div>
    </div>

    <!-- Filter Dropdowns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <div>
        <label for="pf-filter-lang" class="block text-xs font-bold text-slate-300 uppercase mb-1">Sprache</label>
        <select id="pf-filter-lang" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-brand-focus">
          <option value="">Alle Sprachen</option>
          <option value="PL">Polnisch (PL)</option>
          <option value="DE">Deutsch (DE)</option>
          <option value="EN">Englisch (EN)</option>
          <option value="UKR">Ukrainisch (UKR)</option>
        </select>
      </div>

      <div>
        <label for="pf-filter-category" class="block text-xs font-bold text-slate-300 uppercase mb-1">Kategorie</label>
        <select id="pf-filter-category" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-brand-focus">
          <option value="">Alle Kategorien</option>
          <option value="Neuigkeiten">Neuigkeiten</option>
          <option value="Kultur">Kultur</option>
          <option value="SprachCafé">SprachCafé</option>
          <option value="Belletristik">Belletristik</option>
          <option value="Klassiker">Klassiker</option>
          <option value="Science Fiction">Science Fiction</option>
        </select>
      </div>

      <div>
        <label for="pf-filter-location" class="block text-xs font-bold text-slate-300 uppercase mb-1">Standort</label>
        <select id="pf-filter-location" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-brand-focus">
          <option value="">Alle Standorte</option>
          <option value="Pankow">Pankow</option>
          <option value="Schöneberg">Schöneberg</option>
          <option value="Köpenick">Köpenick</option>
        </select>
      </div>

      <div>
        <label for="pf-filter-status" class="block text-xs font-bold text-slate-300 uppercase mb-1">Ausleihstatus</label>
        <select id="pf-filter-status" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:ring-2 focus:ring-brand-focus">
          <option value="">Alle Status</option>
          <option value="verfuegbar">Verfügbar</option>
          <option value="ausgeliehen">Ausgeliehen</option>
          <option value="reserviert">Reserviert</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Search Results Area -->
  <div id="pagefind-results" class="mt-6 space-y-4">
    <!-- Results dynamically inserted here in < 15ms -->
  </div>

  <!-- Status / Performance Timing Badge -->
  <div id="pagefind-meta" class="mt-4 pt-3 border-t border-slate-800/80 text-xs text-brand-text-muted flex justify-between items-center hidden">
    <span id="pf-count">0 Ergebnisse</span>
    <span id="pf-timer" class="font-mono text-emerald-400">0 ms</span>
  </div>

</div>

<!-- Client-side Pagefind API Integration Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    const input = document.getElementById('pagefind-input');
    const langSelect = document.getElementById('pf-filter-lang');
    const catSelect = document.getElementById('pf-filter-category');
    const locSelect = document.getElementById('pf-filter-location');
    const statusSelect = document.getElementById('pf-filter-status');
    const resultsContainer = document.getElementById('pagefind-results');
    const metaContainer = document.getElementById('pagefind-meta');
    const countSpan = document.getElementById('pf-count');
    const timerSpan = document.getElementById('pf-timer');

    let pagefind = null;

    try {
      // Dynamic import of static Pagefind WASM module
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
    } catch (e) {
      console.log('Pagefind static index loading or fallback mode:', e);
    }

    async function performSearch() {
      const query = input ? input.value.trim() : '';
      const filters = {};

      if (langSelect && langSelect.value) filters.language = langSelect.value;
      if (catSelect && catSelect.value) filters.category = catSelect.value;
      if (locSelect && locSelect.value) filters.location = locSelect.value;
      if (statusSelect && statusSelect.value) filters.status = statusSelect.value;

      if (!query && Object.keys(filters).length === 0) {
        if (resultsContainer) resultsContainer.innerHTML = '';
        if (metaContainer) metaContainer.classList.add('hidden');
        return;
      }

      const t0 = performance.now();

      if (pagefind) {
        const search = await pagefind.search(query || null, { filters });
        const results = await Promise.all(search.results.slice(0, 10).map(r => r.data()));
        const t1 = performance.now();
        const duration = (t1 - t0).toFixed(2);

        renderResults(results, search.results.length, duration);
      }
    }

    function renderResults(results, totalCount, durationMs) {
      if (!resultsContainer) return;

      if (results.length === 0) {
        resultsContainer.innerHTML = '<p class="text-sm text-slate-400 py-4">Keine Suchergebnisse gefunden.</p>';
      } else {
        resultsContainer.innerHTML = results.map(item => `
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 hover:border-slate-700 transition-colors">
            <h4 class="text-base font-bold text-white mb-1">
              <a href="${item.url}" class="hover:text-sky-400 transition-colors">${item.meta.title || item.url}</a>
            </h4>
            <p class="text-xs text-slate-300 line-clamp-2">${item.excerpt}</p>
          </div>
        `).join('');
      }

      if (metaContainer && countSpan && timerSpan) {
        metaContainer.classList.remove('hidden');
        countSpan.textContent = `${totalCount} Ergebnisse gefunden`;
        timerSpan.textContent = `🚀 ${durationMs} ms (Client-side, 0 Server-Requests)`;
      }
    }

    [input, langSelect, catSelect, locSelect, statusSelect].forEach(el => {
      if (el) {
        el.addEventListener('input', performSearch);
        el.addEventListener('change', performSearch);
      }
    });
  });
</script>
