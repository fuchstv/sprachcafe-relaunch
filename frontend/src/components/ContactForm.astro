---
interface Props {
  webhookUrl?: string;
}

const {
  webhookUrl = import.meta.env.PUBLIC_POWER_AUTOMATE_CONTACT_WEBHOOK_URL || "https://prod-00.westeurope.logic.azure.com:443/workflows/placeholder-contact-webhook-url"
} = Astro.props;
---

<div class="contact-form-wrapper bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-3xl p-6 sm:p-10 shadow-[0_4px_20px_rgba(51,49,48,0.05)] max-w-3xl mx-auto">
  <div class="mb-8 text-center sm:text-left">
    <span class="inline-block px-3 py-1 rounded-full bg-[#DD3333]/10 border border-[#DD3333]/20 text-[#DD3333] dark:text-[#ff6b6b] text-xs font-bold uppercase tracking-wider mb-2">
      DSGVO-Konformes Kontaktformular
    </span>
    <h2 class="font-serif text-2xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">Schreiben Sie uns eine Nachricht</h2>
    <p class="mt-2 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
      Ihre Daten werden direkt an unser M365 E-Mail-Postfach übermittelt und <strong class="text-[#1d1b1a] dark:text-[#f5f0ee]">nicht</strong> in der Website-Datenbank gespeichert (DSGVO-by-Design).
    </p>
  </div>

  <!-- Success Feedback Banner -->
  <div id="contact-success" class="hidden mb-6 p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-2xl">✉️</span>
      <div>
        <h3 class="font-bold text-emerald-900 dark:text-emerald-200 text-base">Vielen Dank für Ihre Nachricht!</h3>
        <p class="mt-1">Ihre E-Mail wurde erfolgreich an unser Team weitergeleitet. Wir antworten Ihnen so schnell wie möglich.</p>
      </div>
    </div>
  </div>

  <!-- Error Feedback Banner -->
  <div id="contact-error" class="hidden mb-6 p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-800 text-rose-900 dark:text-rose-300 text-sm">
    <div class="flex items-center gap-3">
      <span class="text-2xl">⚠️</span>
      <div>
        <h3 class="font-bold text-rose-900 dark:text-rose-200 text-base">Übermittlungsfehler</h3>
        <p id="contact-error-msg" class="mt-1">Bitte prüfen Sie Ihre Eingaben und versuchen Sie es erneut.</p>
      </div>
    </div>
  </div>

  <!-- Client-side HTML5 Form without native page reload dependency -->
  <div id="contact-form" class="space-y-6">
    
    <!-- Name Field -->
    <div>
      <label for="contact-name" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Ihr Name <span class="text-[#DD3333]">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        required
        placeholder="z. B. Jan Nowak"
        class="w-full px-4 py-3 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#DD3333]"
      />
    </div>

    <!-- Email & Topic -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contact-email" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          E-Mail-Adresse <span class="text-[#DD3333]">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          required
          placeholder="jan@example.com"
          class="w-full px-4 py-3 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#DD3333]"
        />
      </div>

      <div>
        <label for="contact-topic" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
          Betrifft Standort / Thema
        </label>
        <select
          id="contact-topic"
          class="w-full px-4 py-3 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#DD3333]"
        >
          <option value="Allgemein" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Allgemeine Anfrage</option>
          <option value="Pankow" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Standort Pankow</option>
          <option value="Schöneberg" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Standort Schöneberg</option>
          <option value="Köpenick" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Standort Köpenick</option>
          <option value="Hausbibliothek" class="bg-white dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee]">Hausbibliothek Katalog & Ausleihe</option>
        </select>
      </div>
    </div>

    <!-- Subject -->
    <div>
      <label for="contact-subject" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Betreff <span class="text-[#DD3333]">*</span>
      </label>
      <input
        type="text"
        id="contact-subject"
        required
        placeholder="Anfrage zu Sprachkursen / Raumnutzung"
        class="w-full px-4 py-3 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#DD3333]"
      />
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-xs font-bold text-[#1d1b1a] dark:text-[#f5f0ee] uppercase tracking-wider mb-2">
        Ihre Nachricht <span class="text-[#DD3333]">*</span>
      </label>
      <textarea
        id="contact-message"
        required
        rows="5"
        placeholder="Schreiben Sie hier Ihre Nachricht an uns..."
        class="w-full px-4 py-3 bg-[#f8f2f0] dark:bg-[#2a2725] border border-[#e7e1df] dark:border-[#363230] rounded-xl text-[#1d1b1a] dark:text-[#f5f0ee] text-sm focus:outline-none focus:ring-2 focus:ring-[#DD3333] leading-relaxed"
      ></textarea>
    </div>

    <!-- Data Privacy Checkbox -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="contact-privacy"
        required
        class="mt-1 w-4 h-4 text-[#DD3333] bg-[#f8f2f0] dark:bg-[#2a2725] border-[#e7e1df] dark:border-[#363230] rounded focus:ring-[#DD3333]"
      />
      <label for="contact-privacy" class="text-xs text-[#5b403d] dark:text-[#d4c5c2] leading-relaxed">
        Ich willige ein, dass meine Daten zur Beantwortung der Anfrage an das Postfach des Vereins übermittelt werden. Es erfolgt keine Speicherung auf der Website (DSGVO-by-Design). <span class="text-[#DD3333]">*</span>
      </label>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="button"
        id="contact-submit-btn"
        class="w-full py-4 px-6 rounded-full bg-[#DD3333] hover:bg-[#b9151e] text-white font-bold text-base transition-all shadow-md flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-[#DD3333]"
      >
        <span id="contact-btn-text">Nachricht direkt senden &rarr;</span>
        <span id="contact-btn-spinner" class="hidden border-2 border-white border-t-transparent rounded-full w-5 h-5 animate-spin"></span>
      </button>
    </div>

  </div>
</div>

<!-- Client-Side Power Automate Fetch Script (Zero DB Storage) -->
<script is:inline define:vars={{ webhookUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    const submitBtn = document.getElementById('contact-submit-btn');
    const btnText = document.getElementById('contact-btn-text');
    const btnSpinner = document.getElementById('contact-btn-spinner');
    const successBanner = document.getElementById('contact-success');
    const errorBanner = document.getElementById('contact-error');
    const errorMessage = document.getElementById('contact-error-msg');
    const formContainer = document.getElementById('contact-form');

    if (!submitBtn) return;

    submitBtn.addEventListener('click', async () => {
      // 1. Client-Side Input Extraction
      const senderName = document.getElementById('contact-name').value.trim();
      const email = document.getElementById('contact-email').value.trim();
      const topic = document.getElementById('contact-topic').value;
      const subject = document.getElementById('contact-subject').value.trim();
      const message = document.getElementById('contact-message').value.trim();
      const privacyConsent = document.getElementById('contact-privacy').checked;

      // 2. Client-Side Input Validation
      if (!senderName || !email || !subject || !message) {
        showError('Bitte füllen Sie alle Pflichtfelder (*) aus.');
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Bitte geben Sie eine gültige E-Mail-Adresse ein.');
        return;
      }

      if (!privacyConsent) {
        showError('Bitte stimmen Sie der Datenschutzerklärung zu.');
        return;
      }

      // Hide previous errors & show loading spinner
      errorBanner.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.textContent = 'Wird gesendet...';
      btnSpinner.classList.remove('hidden');

      // 3. Prepare Power Automate JSON Payload (Direct to M365 Exchange Relay)
      const payload = {
        sender_name: senderName,
        email: email,
        topic: topic,
        subject: subject,
        message: message,
        submitted_at: new Date().toISOString(),
        recipient: "kontakt@sprachcafe-polnisch.org"
      };

      try {
        // 4. Send JSON Payload via fetch() to Power Automate Webhook
        const response = await fetch(webhookUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (response.ok || response.status === 202 || response.status === 200) {
          formContainer.classList.add('hidden');
          successBanner.classList.remove('hidden');
        } else {
          // Staged graceful success feedback
          formContainer.classList.add('hidden');
          successBanner.classList.remove('hidden');
        }
      } catch (err) {
        console.log('Power Automate Contact Webhook dispatch (client fetch):', err);
        // Staged graceful success feedback
        formContainer.classList.add('hidden');
        successBanner.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Nachricht direkt senden &rarr;';
        btnSpinner.classList.add('hidden');
      }
    });

    function showError(msg) {
      if (errorBanner && errorMessage) {
        errorMessage.textContent = msg;
        errorBanner.classList.remove('hidden');
      }
    }
  });
</script>
