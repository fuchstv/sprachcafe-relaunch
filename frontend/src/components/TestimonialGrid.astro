---
export interface TestimonialItem {
  quote: string;
  name: string;
  role?: string;
  location?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: TestimonialItem[];
}

const {
  title = "Was unsere Besucher & Community sagen",
  subtitle = "Erfahrungsberichte von Sprachschülern, Künstlern und Vereinsmitgliedern.",
  testimonials = [
    {
      quote: "Ihr habt einen magischen Ort geschaffen. Das SprachCafé Polnisch verbindet Menschen und Kultur auf einzigartige Weise.",
      name: "A.W.",
      role: "Künstlerin",
      location: "Berlin-Pankow"
    },
    {
      quote: "Das SprachCafé ist ein Ort gefüllt mit positiver Energie. Ich habe hier wundervolle Gesprächspartner für mein Polnisch gefunden.",
      name: "H.P.",
      role: "Schülerpraktikantin",
      location: "Berlin-Schöneberg"
    },
    {
      quote: "Die Hausbibliothek bietet fantastische polnische Literatur, und die Frauenkreise sind eine Bereicherung für Familien.",
      name: "M.K.",
      role: "Mutter & Bibliotheksnutzerin",
      location: "Berlin-Köpenick"
    }
  ]
} = Astro.props;
---

<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="mb-10 text-center">
    <span class="inline-block px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold uppercase tracking-wider mb-3">
      Stimmen aus der Community
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{title}</h2>
    {subtitle && <p class="mt-2 text-brand-text-muted text-base max-w-2xl mx-auto">{subtitle}</p>}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((item) => (
      <figure class="bg-brand-surface border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl flex flex-col justify-between hover:border-slate-700 transition-all duration-300">
        <blockquote class="text-brand-text text-base leading-relaxed mb-6 italic relative">
          <span class="text-4xl text-sky-400 leading-none absolute -top-4 -left-2 opacity-40" aria-hidden="true">&ldquo;</span>
          <p class="pt-2">{item.quote}</p>
        </blockquote>

        <figcaption class="pt-4 border-t border-slate-800/80 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-500 to-rose-500 flex items-center justify-center text-slate-950 font-bold text-sm">
            {item.name.charAt(0)}
          </div>
          <div>
            <span class="block font-bold text-white text-sm">{item.name}</span>
            <span class="block text-xs text-brand-text-muted">
              {item.role}{item.location ? ` • ${item.location}` : ''}
            </span>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
