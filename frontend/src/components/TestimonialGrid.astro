---
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  subtitle?: string;
  lang?: 'de' | 'pl' | 'en';
}

const {
  title = "Was unsere Besucher & Community sagen",
  subtitle = "Erfahrungsberichte von Sprachschülern, Künstlern und Vereinsmitgliedern.",
  lang = 'de'
} = Astro.props;

const rawTestimonials = await getCollection('testimonials');
const testimonials = rawTestimonials.map((t) => ({
  quote: t.data.quote[lang] || t.data.quote.de,
  name: t.data.author,
  role: t.data.role[lang] || t.data.role.de,
  avatar: t.data.avatar,
}));
---

<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto">
  <div class="mb-10 text-center">
    <span class="inline-block px-3 py-1 rounded-full bg-[#8B263E]/10 border border-[#8B263E]/20 text-[#8B263E] dark:text-[#ff758f] text-xs font-bold uppercase tracking-wider mb-3">
      Stimmen aus der Community
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#1d1b1a] dark:text-[#f5f0ee] tracking-tight">{title}</h2>
    {subtitle && <p class="mt-2 text-[#5b403d] dark:text-[#d4c5c2] text-base max-w-2xl mx-auto">{subtitle}</p>}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((item) => (
      <figure class="bg-white dark:bg-[#22201e] border border-[#e7e1df] dark:border-[#363230] rounded-2xl p-6 sm:p-8 shadow-[0_4px_20px_rgba(51,49,48,0.05)] flex flex-col justify-between hover:border-[#8B263E]/50 transition-all duration-300">
        <blockquote class="text-[#1d1b1a] dark:text-[#f5f0ee] text-base leading-relaxed mb-6 italic relative">
          <span class="text-4xl text-[#8B263E] dark:text-[#ff758f] opacity-40 leading-none absolute -top-4 -left-2" aria-hidden="true">&ldquo;</span>
          <p class="pt-2">{item.quote}</p>
        </blockquote>

        <figcaption class="pt-4 border-t border-[#e7e1df] dark:border-[#363230] flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#8B263E] text-white flex items-center justify-center font-bold text-sm">
            {item.name.charAt(0)}
          </div>
          <div>
            <span class="block font-serif font-bold text-[#1d1b1a] dark:text-[#f5f0ee] text-sm">{item.name}</span>
            <span class="block text-xs text-[#5b403d] dark:text-[#d4c5c2]">
              {item.role}
            </span>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
