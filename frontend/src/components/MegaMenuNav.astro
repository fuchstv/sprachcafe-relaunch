---
import { type LanguageCode } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: LanguageCode;
}

const { currentLang = 'de' } = Astro.props;
const t = useTranslations(currentLang);
---

<nav role="navigation" aria-label="Mega-Menü Navigation" class="relative hidden lg:flex items-center gap-6">
  
  <!-- Standorte Mega Dropdown -->
  <div class="relative group">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-2"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>📍 Standorte</span>
      <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-72">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-2xl space-y-3">
        <a href="#pankow" class="block p-3 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">📍 Pankow</span>
          <span class="block text-xs text-brand-text-muted">Schulzestr. 1 (an S1 Wollankstr.) • Mo-Fr 10-18 Uhr</span>
        </a>
        <a href="#schoeneberg" class="block p-3 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">📍 Schöneberg</span>
          <span class="block text-xs text-brand-text-muted">Hauptstr. 121 A & Gotenstr. 45 • Bei Veranstaltungen</span>
        </a>
        <a href="#koepenick" class="block p-3 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">📍 Köpenick</span>
          <span class="block text-xs text-brand-text-muted">Am Wiesengraben 7a (Wiesentreff) • Bei Veranstaltungen</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Über uns Dropdown -->
  <div class="relative group">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-2"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>ℹ️ Über uns</span>
      <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3 shadow-2xl space-y-1">
        <a href="/ueber-uns/" class="block p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">🏢 Über uns (Übersicht)</span>
          <span class="block text-xs text-brand-text-muted">Verein & 3 Standorte</span>
        </a>
        <a href="/ueber-uns/mission/" class="block p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">🎯 Mission & Werte</span>
          <span class="block text-xs text-brand-text-muted">Historie & Leitbild</span>
        </a>
        <a href="/ueber-uns/team/" class="block p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">👥 Team & Vorstand</span>
          <span class="block text-xs text-brand-text-muted">Unsere Köpfe & Dozierenden</span>
        </a>
        <a href="/ueber-uns/frequently-asked-questions/" class="block p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors">
          <span class="block font-bold text-white text-sm">❓ Häufige Fragen (FAQ)</span>
          <span class="block text-xs text-brand-text-muted">Auskunft & Öffnungszeiten</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Veranstaltungen Dropdown -->
  <a
    href="/events/"
    class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-2"
  >
    {t('nav.events')}
  </a>

  <!-- Blog / News -->
  <a
    href="/posts/"
    class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-2"
  >
    Blog
  </a>

  <!-- Hausbibliothek -->
  <a
    href="/hausbibliothek/"
    class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-2"
  >
    {t('nav.library')}
  </a>

</nav>
