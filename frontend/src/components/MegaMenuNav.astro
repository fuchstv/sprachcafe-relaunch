---
import { type LanguageCode } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang?: LanguageCode;
}

const { currentLang = 'de' } = Astro.props;
const t = useTranslations(currentLang);
const l = (p: string) => getLocalizedPath(p, currentLang);
---

<nav role="navigation" aria-label={t('menu.main')} class="relative hidden lg:flex items-center gap-6">
  
  <!-- Standorte Mega Dropdown -->
  <div class="relative group">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>📍 {t('nav.locations')}</span>
      <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-72">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-3 shadow-xl space-y-2">
        <a href={l('/kontakt/#pankow')} class="block p-3 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">📍 Pankow</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Schulzestr. 1 (an S1 Wollankstr.)</span>
        </a>
        <a href={l('/kontakt/#schoeneberg')} class="block p-3 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">📍 Schöneberg</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Hauptstr. 121 A &amp; Gotenstr. 45</span>
        </a>
        <a href={l('/kontakt/#koepenick')} class="block p-3 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">📍 Köpenick</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Am Wiesengraben 7a (Wiesentreff)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Über uns Dropdown -->
  <div class="relative group">
    <a
      href={l('/ueber-uns/')}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>ℹ️ {t('nav.about')}</span>
      <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </a>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={l('/ueber-uns/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.about.overview')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Verein &amp; 3 Standorte</span>
        </a>
        <a href={l('/ueber-uns/mission/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.about.mission')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Historie &amp; Leitbild</span>
        </a>
        <a href={l('/ueber-uns/team/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.about.team')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Vorstand &amp; Mitwirkende</span>
        </a>
        <a href={l('/ueber-uns/frequently-asked-questions/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.about.faq')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Auskunft &amp; Öffnungszeiten</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Entdecken Dropdown -->
  <div class="relative group">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>✨ {t('nav.discover')}</span>
      <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-64">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={l('/ueber-uns/ausstellungen/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.exhibitions')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Fotografie, Kunst &amp; Galerie</span>
        </a>
        <a href={l('/mehrsprachigkeit/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.multilingual')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Zweisprachige Beratung</span>
        </a>
        <a href={l('/ueber-uns/kleiner-laden/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.shop')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Vereins-Merchandise</span>
        </a>
        <a href={l('/ueber-uns/begegnungscafe/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.cafe')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Kaffee &amp; Austausch</span>
        </a>
        <a href={l('/hausbibliothek/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.library')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Zweisprachiges Buchportal</span>
        </a>
        <a href="https://kurse.sprachcafe-polnisch.org" target="_blank" rel="noopener noreferrer" class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">🎓 Kurse &amp; Camps</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Buchungsportal &amp; Kursräume</span>
        </a>
        <a href={l('/news/')} class="block p-2.5 rounded-xl hover:bg-[#FAF5EB] dark:hover:bg-[#2A2725] transition-colors">
          <span class="block font-bold text-[#1D1B1A] dark:text-[#F5F0EE] text-sm">{t('nav.discover.news')}</span>
          <span class="block text-xs text-[#5B403D] dark:text-[#D4C5C2]">Mitteilungen &amp; Berichte</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Veranstaltungen Dropdown -->
  <a
    href={l('/events/')}
    class="text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
  >
    {t('nav.events')}
  </a>

  <!-- News / Aktuelles -->
  <a
    href={l('/news/')}
    class="text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
  >
    {t('nav.news')}
  </a>

  <!-- Hausbibliothek -->
  <a
    href={l('/hausbibliothek/')}
    class="text-sm font-semibold text-[#5B403D] dark:text-[#D4C5C2] hover:text-[#8B1E2D] dark:hover:text-[#FF758F] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-2"
  >
    {t('nav.library')}
  </a>

</nav>
