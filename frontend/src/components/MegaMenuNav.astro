---
import { type LanguageCode } from '../i18n/ui';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang?: LanguageCode;
}

const { currentLang = 'de' } = Astro.props;
const t = useTranslations(currentLang);
const l = (p: string) => getLocalizedPath(p, currentLang);

// Localized links
const eventsAdultsUrl = l('/events/');
const eventsKidsUrl = currentLang === 'pl' 
  ? '/pl/kafejka-dla-dzieci/' 
  : currentLang === 'en' 
    ? '/en/cafe-for-children/' 
    : '/sprachcafe-fuer-kinder/';

const donateUrl = l('/mitmachen/spenden/');
const rentRoomUrl = currentLang === 'en' 
  ? '/en/rent-our-room/' 
  : l('/unseren-raum-mieten/');
const membershipUrl = l('/mitmachen/mitglied-werden/');
const volunteerUrl = currentLang === 'pl' 
  ? '/pl/wolontariat/' 
  : currentLang === 'en' 
    ? '/en/volunteering/' 
    : '/mitmachen/ehrenamt/';
const internshipUrl = currentLang === 'pl' 
  ? '/pl/praktyki-w-kafejce/' 
  : currentLang === 'en' 
    ? '/en/internship-in-sprachcafe/' 
    : '/mitmachen/praktikum-im-scp/';
const partnerBecomeUrl = currentLang === 'pl' 
  ? '/pl/wspolpraca/' 
  : currentLang === 'en' 
    ? '/en/cooperation/' 
    : '/mitmachen/kooperationen/';
const partnersUrl = l('/mitmachen/kooperationen/unsere-partner/');
---

<nav role="navigation" aria-label={t('menu.main')} class="relative hidden md:flex items-center gap-4 lg:gap-5">
  
  <!-- 1. Spenden CTA Button (WordPress Position 1) -->
  <a
    href={donateUrl}
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#8B1E2D] hover:bg-[#721824] text-white text-xs font-bold uppercase tracking-wider shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] focus:ring-offset-1"
  >
    <svg class="w-3.5 h-3.5 fill-current text-white/90" viewBox="0 0 24 24">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span>{t('nav.donate_cta')}</span>
  </a>

  <!-- 2. Veranstaltungen Dropdown -->
  <div class="relative group">
    <a
      href={l('/events/')}
      class="inline-flex items-center gap-1 text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1.5"
    >
      <span>{t('nav.events')}</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </a>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-56">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={eventsAdultsUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.events.adults')}
        </a>
        <a href={eventsKidsUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.events.kids')}
        </a>
      </div>
    </div>
  </div>

  <!-- 3. Mitmachen! Dropdown -->
  <div class="relative group">
    <a
      href={l('/mitmachen/')}
      class="inline-flex items-center gap-1 text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1.5"
    >
      <span>{t('nav.participate')}</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </a>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-60">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={donateUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.donate')}
        </a>
        <a href={rentRoomUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.rent')}
        </a>
        <a href={membershipUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.membership')}
        </a>
        <a href={volunteerUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.volunteer')}
        </a>
        <a href={internshipUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.internship')}
        </a>
        <a href={partnerBecomeUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.partner_become')}
        </a>
        <a href={partnersUrl} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.participate.partner')}
        </a>
      </div>
    </div>
  </div>

  <!-- 4. Über uns Dropdown -->
  <div class="relative group">
    <a
      href={l('/ueber-uns/')}
      class="inline-flex items-center gap-1 text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1.5"
    >
      <span>{t('nav.about')}</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </a>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-56">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={l('/ueber-uns/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.about.overview')}
        </a>
        <a href={l('/ueber-uns/mission/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.about.mission')}
        </a>
        <a href={l('/ueber-uns/team/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.about.team')}
        </a>
        <a href={l('/ueber-uns/frequently-asked-questions/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.about.faq')}
        </a>
      </div>
    </div>
  </div>

  <!-- 5. Entdecken Dropdown -->
  <div class="relative group">
    <button
      type="button"
      class="inline-flex items-center gap-1 text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1.5"
    >
      <span>{t('nav.discover')}</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 w-60">
      <div class="bg-white dark:bg-[#24201E] border border-[#E2D8CC] dark:border-[#363230] rounded-2xl p-2 shadow-xl space-y-1">
        <a href={l('/hausbibliothek/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.library')}
        </a>
        <a href={l('/ueber-uns/ausstellungen/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.exhibitions')}
        </a>
        <a href={l('/mehrsprachigkeit/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.multilingual')}
        </a>
        <a href={l('/speak-dating/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.speakdating')}
        </a>
        <a href={l('/ueber-uns/kleiner-laden/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.shop')}
        </a>
        <a href={l('/ueber-uns/begegnungscafe/')} class="block px-3 py-2 text-xs font-semibold text-[#1d1b1a] dark:text-[#f5f0ee] hover:bg-[#8B1E2D]/10 rounded-xl transition-colors">
          {t('nav.discover.cafe')}
        </a>
      </div>
    </div>
  </div>

  <!-- 6. Kontakt -->
  <a
    href={l('/kontakt/')}
    class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:hover:text-[#ff758f] transition-colors py-2 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1.5"
  >
    {t('nav.contact')}
  </a>
</nav>
