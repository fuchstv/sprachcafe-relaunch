---
import { type LanguageCode } from '../i18n/ui';
import { getHreflangLinks, useTranslations } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  lang?: LanguageCode;
}

const {
  title,
  description = "SprachCafé Polnisch - Ort der Begegnung, Sprache und Kultur",
  lang = "de"
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.toString() : "https://sprachcafe-polnisch.org";
const hreflangs = getHreflangLinks(pathname, siteUrl);
const t = useTranslations(lang);
---

<!DOCTYPE html>
<html lang={lang} class="h-full bg-brand-bg text-brand-text font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Native i18n SEO: Alternate hreflang tags for WCAG & Search Engines -->
    {hreflangs.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}
    <link rel="canonical" href={`${siteUrl.replace(/\/$/, '')}${pathname}`} />
  </head>
  <body class="min-h-full flex flex-col bg-brand-bg text-brand-text">
    
    <!-- WCAG 2.1 AA Skip Link: Keyboard Focus Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-brand-primary-light focus:text-slate-950 focus:font-bold focus:rounded-lg focus:shadow-xl focus:ring-4 focus:ring-sky-300 focus:outline-none"
    >
      {lang === 'de' ? 'Zum Hauptinhalt springen' : lang === 'pl' ? 'Przejdź do treści głównej' : 'Skip to main content'}
    </a>

    <!-- Semantic Landmark: Header -->
    <header role="banner" class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800/80 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Brand Logo -->
        <a
          href={lang === 'de' ? '/' : `/${lang}/`}
          class="flex items-center gap-2.5 text-xl font-bold text-brand-text hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-1 py-0.5"
          aria-label="SprachCafé Polnisch Startseite"
        >
          <span class="text-2xl" aria-hidden="true">☕</span>
          <span>SprachCafé <span class="text-brand-primary-light">Polnisch</span></span>
        </a>

        <!-- Semantic Landmark: Main Navigation -->
        <nav role="navigation" aria-label={lang === 'de' ? 'Hauptnavigation' : lang === 'pl' ? 'Nawigacja główna' : 'Main Navigation'} class="hidden md:flex items-center gap-6">
          <a
            href={lang === 'de' ? '/' : `/${lang}/`}
            class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-2 py-1"
          >
            {t('nav.home')}
          </a>
          <a
            href="#about"
            class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-2 py-1"
          >
            {t('nav.about')}
          </a>
          <a
            href="#events"
            class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-2 py-1"
          >
            {t('nav.events')}
          </a>
          <a
            href="#library"
            class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-2 py-1"
          >
            {t('nav.library')}
          </a>
          <a
            href="#contact"
            class="text-sm font-medium text-brand-text-muted hover:text-brand-primary-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-focus focus:ring-offset-2 focus:ring-offset-slate-900 rounded-md px-2 py-1"
          >
            {t('nav.contact')}
          </a>
        </nav>

        <!-- Reusable Language Switcher -->
        <LanguageSwitcher currentLang={lang} />
      </div>
    </header>

    <!-- Semantic Landmark: Main Content -->
    <main id="main-content" role="main" tabindex="-1" class="flex-grow focus:outline-none">
      <slot />
    </main>

    <!-- Semantic Landmark: Footer -->
    <footer role="contentinfo" class="bg-slate-950 border-t border-slate-800/80 py-8 px-4 sm:px-6 lg:px-8 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-brand-text-muted text-center md:text-left">
        <p>&copy; {new Date().getFullYear()} SprachCafé Polnisch e.V. — Wszystkie prawa zastrzeżone / Alle Rechte vorbehalten.</p>
        <div class="flex items-center gap-4">
          <a href="#privacy" class="hover:text-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-1">Datenschutz</a>
          <span>•</span>
          <a href="#imprint" class="hover:text-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-1">Impressum</a>
          <span>•</span>
          <a href="#accessibility" class="hover:text-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-focus rounded-md px-1">Barrierefreiheit</a>
        </div>
      </div>
    </footer>

  </body>
</html>
