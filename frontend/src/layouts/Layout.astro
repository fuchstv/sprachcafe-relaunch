---
import { type LanguageCode } from '../i18n/ui';
import { getHreflangLinks, useTranslations, getLocalizedPath } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import MegaMenuNav from '../components/MegaMenuNav.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/fonts.css';

interface Props {
  title: string;
  description?: string;
  lang?: LanguageCode;
  image?: string;
  type?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = "SprachCafé Polnisch e.V. - Ort der Begegnung, Sprache und Kultur in Berlin",
  lang = "de",
  image,
  type = "website",
  jsonLd
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.toString() : "https://xn--sprachcaf-j4a.org";
const canonicalUrl = `${siteUrl.replace(/\/$/, '')}${pathname}`;
const defaultOgImage = `${siteUrl.replace(/\/$/, '')}/brand-assets/logo.png`;
const ogImage = image ? (image.startsWith('http') ? image : `${siteUrl.replace(/\/$/, '')}${image}`) : defaultOgImage;

const hreflangs = getHreflangLinks(pathname, siteUrl);
const t = useTranslations(lang);
const l = (p: string) => getLocalizedPath(p, lang);

// Localized navigation URLs
const eventsAdultsUrl = l('/events/');
const eventsKidsUrl = lang === 'pl' 
  ? '/pl/kafejka-dla-dzieci/' 
  : lang === 'en' 
    ? '/en/cafe-for-children/' 
    : '/sprachcafe-fuer-kinder/';

const donateUrl = l('/mitmachen/spenden/');
const rentRoomUrl = lang === 'en' 
  ? '/en/rent-our-room/' 
  : l('/unseren-raum-mieten/');
const membershipUrl = l('/mitmachen/mitglied-werden/');
const volunteerUrl = lang === 'pl' 
  ? '/pl/wolontariat/' 
  : lang === 'en' 
    ? '/en/volunteering/' 
    : '/mitmachen/ehrenamt/';
const internshipUrl = lang === 'pl' 
  ? '/pl/praktyki-w-kafejce/' 
  : lang === 'en' 
    ? '/en/internship-in-sprachcafe/' 
    : '/mitmachen/praktikum-im-scp/';
const partnerBecomeUrl = lang === 'pl' 
  ? '/pl/wspolpraca/' 
  : lang === 'en' 
    ? '/en/cooperation/' 
    : '/mitmachen/kooperationen/';
const partnersUrl = l('/mitmachen/kooperationen/unsere-partner/');

// Format locale string for OpenGraph
const ogLocale = lang === 'de' ? 'de_DE' : lang === 'pl' ? 'pl_PL' : 'en_US';
const altLocales = ['de_DE', 'pl_PL', 'en_US'].filter(l => l !== ogLocale);
---

<!DOCTYPE html>
<html lang={lang} class="h-full font-sans antialiased overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Anti-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    
    <!-- Official Brand Assets: Favicon & Logo -->
    <link rel="icon" type="image/png" sizes="512x512" href="/brand-assets/favicon.png" />
    <link rel="apple-touch-icon" href="/brand-assets/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Social Meta Tags -->
    <meta property="og:site_name" content="SprachCafé Polnisch e.V." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    {altLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Native i18n SEO: Alternate hreflang tags -->
    {hreflangs.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}

    <!-- Schema.org JSON-LD Structured Data Block -->
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd, null, 2)} />
    )}

    <style is:global>
      mark {
        background-color: #FEF08A !important;
        color: #713F12 !important;
        padding: 0.1em 0.3em;
        border-radius: 0.25rem;
      }
      :global(.dark) mark {
        background-color: #854D0E !important;
        color: #FEF08A !important;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col bg-[#FAF6EE] dark:bg-[#181615] text-[#1d1b1a] dark:text-[#f5f0ee] transition-colors duration-300 overflow-x-hidden">
    
    <!-- WCAG 2.1 AA Skip Link: Keyboard Focus Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-[#8B1E2D] focus:text-white focus:font-bold focus:rounded-lg focus:shadow-xl focus:outline-none"
    >
      {t('skip.content')}
    </a>

    <!-- Semantic Landmark: Header -->
    <header role="banner" class="sticky top-0 z-40 bg-[#FAF6EE]/90 dark:bg-[#181615]/90 backdrop-blur-md border-b border-[#E2D8CC] dark:border-[#363230] shadow-sm transition-colors duration-300">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Official Brand Logo -->
        <a
          href={l('/')}
          class="flex items-center gap-3 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md p-1"
          aria-label={t('hero.title') + ' ' + t('nav.home')}
        >
          <img src="/brand-assets/logo.webp" alt="SprachCafé Polnisch Logo" class="h-12 w-auto object-contain rounded-lg shadow-sm" />
          <span class="font-serif font-bold text-xl tracking-tight text-[#1d1b1a] dark:text-[#f5f0ee] hidden sm:inline-block">SprachCafé Polnisch e.V.</span>
        </a>

        <!-- Semantic Landmark: Main Navigation (1:1 WordPress MegaMenu) -->
        <MegaMenuNav currentLang={lang} />

        <!-- Right Side: Dark Mode Toggle, Language Switcher & Mobile Hamburger -->
        <div class="flex items-center gap-2 sm:gap-3">
          <button
            id="theme-toggle-btn"
            type="button"
            class="p-2 rounded-full border border-[#E2D8CC] dark:border-[#363230] bg-[#F5EFEB] dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee] hover:opacity-90 transition-all focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] text-sm"
            aria-label={t('theme.toggle')}
            title={t('theme.toggle')}
          >
            <span class="hidden dark:inline">☀️</span>
            <span class="inline dark:hidden">🌙</span>
          </button>
          
          <LanguageSwitcher currentLang={lang} />

          <!-- Mobile Hamburger Toggle -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden p-2 rounded-xl border border-[#E2D8CC] dark:border-[#363230] bg-[#F5EFEB] dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee] hover:opacity-90 transition-all focus:outline-none focus:ring-2 focus:ring-[#8B1E2D]"
            aria-label={t('menu.open')}
            aria-expanded="false"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-[#E2D8CC] dark:border-[#363230] bg-[#FAF6EE] dark:bg-[#181615] px-4 py-6 space-y-4 shadow-lg">
        <!-- 1. Spenden CTA Button -->
        <a
          href={donateUrl}
          class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#8B1E2D] hover:bg-[#721824] text-white font-bold text-sm tracking-wide shadow-sm transition-all"
        >
          <svg class="w-4 h-4 fill-current text-white/90" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>{t('nav.donate_cta')}</span>
        </a>

        <!-- Home -->
        <a
          href={l('/')}
          class="block py-2 text-base font-bold text-[#1d1b1a] dark:text-[#f5f0ee] border-b border-[#E2D8CC] dark:border-[#363230]"
        >
          {t('nav.home')}
        </a>

        <!-- 2. Veranstaltungen -->
        <div class="space-y-1 border-b border-[#E2D8CC] dark:border-[#363230] pb-3">
          <a
            href={l('/events/')}
            class="block py-1 text-base font-bold text-[#8B1E2D] dark:text-[#ff758f]"
          >
            📅 {t('nav.events')}
          </a>
          <div class="pl-4 space-y-1 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
            <a href={eventsAdultsUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.events.adults')}</a>
            <a href={eventsKidsUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.events.kids')}</a>
          </div>
        </div>

        <!-- 3. Mitmachen! -->
        <div class="space-y-1 border-b border-[#E2D8CC] dark:border-[#363230] pb-3">
          <a
            href={l('/mitmachen/')}
            class="block py-1 text-base font-bold text-[#8B1E2D] dark:text-[#ff758f]"
          >
            🤝 {t('nav.participate')}
          </a>
          <div class="pl-4 space-y-1 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
            <a href={donateUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.donate')}</a>
            <a href={rentRoomUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.rent')}</a>
            <a href={membershipUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.membership')}</a>
            <a href={volunteerUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.volunteer')}</a>
            <a href={internshipUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.internship')}</a>
            <a href={partnerBecomeUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.partner_become')}</a>
            <a href={partnersUrl} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.participate.partner')}</a>
          </div>
        </div>

        <!-- 4. Über uns -->
        <div class="space-y-1 border-b border-[#E2D8CC] dark:border-[#363230] pb-3">
          <a
            href={l('/ueber-uns/')}
            class="block py-1 text-base font-bold text-[#8B1E2D] dark:text-[#ff758f]"
          >
            🏢 {t('nav.about')}
          </a>
          <div class="pl-4 space-y-1 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
            <a href={l('/ueber-uns/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.about.overview')}</a>
            <a href={l('/ueber-uns/mission/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.about.mission')}</a>
            <a href={l('/ueber-uns/team/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.about.team')}</a>
            <a href={l('/ueber-uns/frequently-asked-questions/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.about.faq')}</a>
          </div>
        </div>

        <!-- 5. Entdecken -->
        <div class="space-y-1 border-b border-[#E2D8CC] dark:border-[#363230] pb-3">
          <span class="block py-1 text-base font-bold text-[#8B1E2D] dark:text-[#ff758f]">
            ✨ {t('nav.discover')}
          </span>
          <div class="pl-4 space-y-1 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
            <a href={l('/hausbibliothek/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.library')}</a>
            <a href={l('/ueber-uns/ausstellungen/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.exhibitions')}</a>
            <a href={l('/mehrsprachigkeit/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.multilingual')}</a>
            <a href={l('/speak-dating/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.speakdating')}</a>
            <a href={l('/ueber-uns/kleiner-laden/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.shop')}</a>
            <a href={l('/ueber-uns/begegnungscafe/')} class="block py-1.5 hover:text-[#8B1E2D]">{t('nav.discover.cafe')}</a>
          </div>
        </div>

        <!-- 6. Kontakt -->
        <a
          href={l('/kontakt/')}
          class="block py-2 text-base font-bold text-[#1d1b1a] dark:text-[#f5f0ee]"
        >
          ✉️ {t('nav.contact')}
        </a>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Semantic Landmark: Footer with Social & Donation Brand Assets -->
    <footer role="contentinfo" class="bg-[#F5EFEB] dark:bg-[#24201E] border-t border-[#E2D8CC] dark:border-[#363230] py-10 px-4 sm:px-6 lg:px-8 mt-auto transition-colors duration-300">
      <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        
        <div class="flex items-center gap-3">
          <a href={l('/mitmachen/spenden/')} class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B1E2D] dark:text-[#ff758f] hover:underline" title="SprachCafé Polnisch mit einer Spende unterstützen">
            <img src="/brand-assets/heart-donation.svg" alt="Spenden Herz-Icon" class="w-5 h-5" />
            <span>{t('footer.donate')}</span>
          </a>
          <span class="text-[#e7e1df] dark:text-[#363230]">|</span>
          <p>{t('footer.rights')}</p>
        </div>

        <!-- Official Social Icons (Facebook, Instagram, YouTube, LinkedIn, TikTok) -->
        <div class="flex items-center gap-3 sm:gap-4 flex-wrap justify-center">
          <a
            href="https://www.facebook.com/sprachcafe.polnisch/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:text-[#ff758f] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-full"
            aria-label="Facebook"
          >
            <img src="/brand-assets/icon-facebook.svg" alt="Facebook Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.instagram.com/sprachcafepolnisch/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:text-[#ff758f] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-full"
            aria-label="Instagram"
          >
            <img src="/brand-assets/icon-instagram.svg" alt="Instagram Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.youtube.com/channel/UCAgdsEs-YX_i6tDGbBtEz-w"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:text-[#ff758f] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-full"
            aria-label="YouTube"
          >
            <img src="/brand-assets/icon-youtube.svg" alt="YouTube Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.linkedin.com/company/sprachcafe-polnisch-ev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:text-[#ff758f] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-full"
            aria-label="LinkedIn"
          >
            <img src="/brand-assets/icon-linkedin.svg" alt="LinkedIn Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.tiktok.com/@sprachcafepolnisch?_r=1&_t=ZN-95X7nApX6xC"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#8B1E2D] dark:text-[#ff758f] transition-colors focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-full"
            aria-label="TikTok"
          >
            <img src="/brand-assets/icon-tiktok.svg" alt="TikTok Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
        </div>

        <div class="flex items-center gap-4">
          <a href={l('/datenschutz/')} class="hover:text-[#8B1E2D] dark:hover:text-[#ff758f] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1 font-medium">{t('footer.privacy')}</a>
          <span>•</span>
          <a href={l('/impressum/')} class="hover:text-[#8B1E2D] dark:hover:text-[#ff758f] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1 font-medium">{t('footer.imprint')}</a>
          <span>•</span>
          <a href={l('/barrierefreiheit/')} class="hover:text-[#8B1E2D] dark:hover:text-[#ff758f] focus:outline-none focus:ring-2 focus:ring-[#8B1E2D] rounded-md px-1 font-medium">{t('footer.accessibility')}</a>
        </div>

      </div>
    </footer>

    <!-- Scroll to top floating action button -->
    <ScrollToTop lang={lang} />

    <!-- Theme Switcher & Mobile Menu Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          });
        }

        const menuToggle = document.getElementById('mobile-menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener('click', () => {
            const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
            menuToggle.setAttribute('aria-expanded', !isExpanded);
            mobileMenu.classList.toggle('hidden');
            if (hamburgerIcon && closeIcon) {
              hamburgerIcon.classList.toggle('hidden');
              closeIcon.classList.toggle('hidden');
            }
          });
        }
      });
    </script>
  </body>
</html>
