---
import { type LanguageCode } from '../i18n/ui';
import { getHreflangLinks, useTranslations } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/fonts.css';

interface Props {
  title: string;
  description?: string;
  lang?: LanguageCode;
  image?: string;
  type?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = "SprachCafé Polnisch e.V. - Ort der Begegnung, Sprache und Kultur in Berlin",
  lang = "de",
  image,
  type = "website",
  jsonLd
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.toString() : "https://sprachcafe-polnisch.org";
const canonicalUrl = `${siteUrl.replace(/\/$/, '')}${pathname}`;
const defaultOgImage = `${siteUrl.replace(/\/$/, '')}/brand-assets/logo.png`;
const ogImage = image ? (image.startsWith('http') ? image : `${siteUrl.replace(/\/$/, '')}${image}`) : defaultOgImage;

const hreflangs = getHreflangLinks(pathname, siteUrl);
const t = useTranslations(lang);

// Format locale string for OpenGraph
const ogLocale = lang === 'de' ? 'de_DE' : lang === 'pl' ? 'pl_PL' : 'en_US';
const altLocales = ['de_DE', 'pl_PL', 'en_US'].filter(l => l !== ogLocale);
---

<!DOCTYPE html>
<html lang={lang} class="h-full font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Anti-FOUC Dark Mode Initializer -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    
    <!-- Official Brand Assets: Favicon & Logo -->
    <link rel="icon" type="image/png" sizes="512x512" href="/brand-assets/favicon.png" />
    <link rel="apple-touch-icon" href="/brand-assets/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph Social Meta Tags -->
    <meta property="og:site_name" content="SprachCafé Polnisch e.V." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    {altLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Native i18n SEO: Alternate hreflang tags -->
    {hreflangs.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}

    <!-- Schema.org JSON-LD Structured Data Block -->
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd, null, 2)} />
    )}
  </head>
  <body class="min-h-full flex flex-col bg-[#FDFBF7] dark:bg-[#181615] text-[#1d1b1a] dark:text-[#f5f0ee] transition-colors duration-300">
    
    <!-- WCAG 2.1 AA Skip Link: Keyboard Focus Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-[#DD3333] focus:text-white focus:font-bold focus:rounded-lg focus:shadow-xl focus:outline-none"
    >
      {lang === 'de' ? 'Zum Hauptinhalt springen' : lang === 'pl' ? 'Przejdź do treści głównej' : 'Skip to main content'}
    </a>

    <!-- Semantic Landmark: Header -->
    <header role="banner" class="sticky top-0 z-40 bg-[#FDFBF7]/90 dark:bg-[#181615]/90 backdrop-blur-md border-b border-[#e7e1df] dark:border-[#363230] shadow-sm transition-colors duration-300">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Official Brand Logo -->
        <a
          href={lang === 'de' ? '/' : `/${lang}/`}
          class="flex items-center gap-3 transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md p-1"
          aria-label="SprachCafé Polnisch Startseite"
        >
          <img src="/brand-assets/logo.webp" alt="SprachCafé Polnisch Logo" class="h-12 w-auto object-contain rounded-lg shadow-sm" />
          <span class="font-serif font-bold text-xl tracking-tight text-[#1d1b1a] dark:text-[#f5f0ee] hidden sm:inline-block">SprachCafé Polnisch e.V.</span>
        </a>

        <!-- Semantic Landmark: Main Navigation -->
        <nav role="navigation" aria-label={lang === 'de' ? 'Hauptnavigation' : lang === 'pl' ? 'Nawigacja główna' : 'Main Navigation'} class="hidden md:flex items-center gap-6">
          <a
            href={lang === 'de' ? '/' : `/${lang}/`}
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            {t('nav.home')}
          </a>
          <a
            href="/events/"
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            {t('nav.events')}
          </a>
          <a
            href="/posts/"
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            Blog
          </a>
          <a
            href="/hausbibliothek/"
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            {t('nav.library')}
          </a>
          <a
            href="/mitmachen/"
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            Mitmachen
          </a>
          <a
            href="/kontakt/"
            class="text-sm font-semibold text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] dark:hover:text-[#ff6b6b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-2 py-1"
          >
            {t('nav.contact')}
          </a>
        </nav>

        <!-- Right Side: Dark Mode Toggle & Language Switcher -->
        <div class="flex items-center gap-3">
          <button
            id="theme-toggle-btn"
            type="button"
            class="p-2 rounded-full border border-[#e7e1df] dark:border-[#363230] bg-[#f8f2f0] dark:bg-[#2a2725] text-[#1d1b1a] dark:text-[#f5f0ee] hover:opacity-90 transition-all focus:outline-none focus:ring-2 focus:ring-[#DD3333] text-sm"
            aria-label="Design umschalten"
            title="Design umschalten (Hell / Dunkel)"
          >
            <span class="hidden dark:inline">☀️</span>
            <span class="inline dark:hidden">🌙</span>
          </button>
          
          <LanguageSwitcher currentLang={lang} />
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Semantic Landmark: Footer with Social & Donation Brand Assets -->
    <footer role="contentinfo" class="bg-[#f8f2f0] dark:bg-[#22201e] border-t border-[#e7e1df] dark:border-[#363230] py-10 px-4 sm:px-6 lg:px-8 mt-auto transition-colors duration-300">
      <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-[#5b403d] dark:text-[#d4c5c2]">
        
        <div class="flex items-center gap-3">
          <img src="/brand-assets/heart-donation.svg" alt="Spenden Herz-Icon" class="w-6 h-6" />
          <p>&copy; 2026 SprachCafé Polnisch e.V. — Alle Rechte vorbehalten.</p>
        </div>

        <!-- Official Social Icons (Facebook, Instagram, YouTube, LinkedIn, TikTok) -->
        <div class="flex items-center gap-3 sm:gap-4 flex-wrap justify-center">
          <a
            href="https://www.facebook.com/sprachcafe.polnisch/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-full"
            aria-label="Facebook Seite"
          >
            <img src="/brand-assets/icon-facebook.svg" alt="Facebook Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.instagram.com/sprachcafepolnisch/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-full"
            aria-label="Instagram Profil"
          >
            <img src="/brand-assets/icon-instagram.svg" alt="Instagram Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.youtube.com/channel/UCAgdsEs-YX_i6tDGbBtEz-w"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-full"
            aria-label="YouTube Kanal"
          >
            <img src="/brand-assets/icon-youtube.svg" alt="YouTube Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.linkedin.com/company/sprachcafe-polnisch-ev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-full"
            aria-label="LinkedIn Firmenseite"
          >
            <img src="/brand-assets/icon-linkedin.svg" alt="LinkedIn Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
          <a
            href="https://www.tiktok.com/@sprachcafepolnisch?_r=1&_t=ZN-95X7nApX6xC"
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center text-[#5b403d] dark:text-[#d4c5c2] hover:text-[#DD3333] transition-colors focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-full"
            aria-label="TikTok Profil"
          >
            <img src="/brand-assets/icon-tiktok.svg" alt="TikTok Icon" class="w-5 h-5 opacity-80 hover:opacity-100 dark:invert" />
          </a>
        </div>

        <div class="flex items-center gap-4">
          <a href="#privacy" class="hover:text-[#DD3333] focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-1">Datenschutz</a>
          <span>•</span>
          <a href="#imprint" class="hover:text-[#DD3333] focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-1">Impressum</a>
          <span>•</span>
          <a href="#accessibility" class="hover:text-[#DD3333] focus:outline-none focus:ring-2 focus:ring-[#DD3333] rounded-md px-1">Barrierefreiheit</a>
        </div>

      </div>
    </footer>

    <!-- Theme Switcher Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          });
        }
      });
    </script>
  </body>
</html>
