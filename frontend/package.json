{
  "name": "sprachcafe-frontend",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:library": "tsx ../scripts/sync_hausbibliothek_catalog.ts",
    "sync:library:dry-run": "tsx ../scripts/sync_hausbibliothek_catalog.ts --dry-run",
    "sync:calendars": "tsx ../scripts/sync_google_calendars.ts",
    "build": "npx -y tsx ../scripts/sync_hausbibliothek_catalog.ts && npx -y tsx ../scripts/sync_google_calendars.ts && astro build && pagefind --site dist",
    "preview": "astro preview",
    "pagefind": "pagefind --site dist",
    "test:a11y": "astro build && pagefind --site dist && node scripts/test-a11y.js",
    "test:search-benchmark": "node scripts/benchmark-search.js",
    "test:jsonld": "node ../scripts/validate-jsonld.js",
    "test:pagespeed": "node ../scripts/test-pagespeed.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "dotenv": "^16.4.7",
    "node-ical": "^0.26.1",
    "pagefind": "^1.3.0",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2"
  }
}
