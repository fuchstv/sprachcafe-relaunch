{
  "collection": "events",
  "name": "Veranstaltungen & SprachCafés",
  "i18n": true,
  "locales": ["de", "pl", "en"],
  "fields": [
    { "name": "id", "type": "uuid", "primaryKey": true },
    { "name": "title", "type": "string", "required": true, "i18n": true },
    { "name": "slug", "type": "string", "unique": true, "required": true },
    { "name": "date_start", "type": "datetime", "required": true },
    { "name": "date_end", "type": "datetime" },
    {
      "name": "location",
      "type": "select",
      "options": ["Pankow", "Schöneberg", "Köpenick"],
      "required": true
    },
    {
      "name": "target_group",
      "type": "select",
      "options": ["Kinder", "Erwachsene", "Familien", "Jugendliche", "Alle"],
      "required": true
    },
    {
      "name": "language",
      "type": "select",
      "options": ["DE", "PL", "EN", "Bilingual"],
      "required": true
    },
    { "name": "description", "type": "richtext", "i18n": true },
    { "name": "image", "type": "media" },
    { "name": "max_participants", "type": "integer" },
    { "name": "power_automate_trigger", "type": "boolean", "default": true }
  ]
}
