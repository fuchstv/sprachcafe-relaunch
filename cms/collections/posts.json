{
  "collection": "posts",
  "name": "Magazin & News",
  "i18n": true,
  "locales": ["de", "pl", "en"],
  "fields": [
    { "name": "id", "type": "uuid", "primaryKey": true },
    { "name": "title", "type": "string", "required": true, "i18n": true },
    { "name": "slug", "type": "string", "unique": true, "required": true },
    { "name": "date", "type": "date", "required": true },
    {
      "name": "category",
      "type": "select",
      "options": ["Neuigkeiten", "Kultur", "SprachCafé", "Verein"],
      "required": true
    },
    {
      "name": "location_tag",
      "type": "select",
      "options": ["Pankow", "Schöneberg", "Köpenick", "Global"]
    },
    { "name": "content", "type": "richtext", "required": true, "i18n": true },
    { "name": "featured_image", "type": "media" },
    { "name": "author", "type": "string" }
  ]
}
