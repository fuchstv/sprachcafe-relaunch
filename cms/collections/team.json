{
  "collection": "team",
  "name": "Team & Partner",
  "i18n": true,
  "locales": ["de", "pl", "en"],
  "fields": [
    { "name": "id", "type": "uuid", "primaryKey": true },
    { "name": "name", "type": "string", "required": true },
    { "name": "role", "type": "string", "required": true, "i18n": true },
    {
      "name": "type",
      "type": "select",
      "options": ["team", "partner"],
      "default": "team",
      "required": true
    },
    { "name": "email", "type": "string" },
    { "name": "website", "type": "string" },
    { "name": "bio", "type": "text", "i18n": true },
    { "name": "photo", "type": "media" }
  ]
}
