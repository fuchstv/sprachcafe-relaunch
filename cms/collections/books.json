{
  "collection": "books",
  "name": "Hausbibliothek Katalog",
  "i18n": true,
  "locales": ["de", "pl", "en"],
  "fields": [
    { "name": "id", "type": "uuid", "primaryKey": true },
    { "name": "title", "type": "string", "required": true },
    { "name": "author", "type": "string", "required": true },
    { "name": "isbn", "type": "string", "unique": true, "required": true },
    {
      "name": "language",
      "type": "select",
      "options": ["DE", "PL", "EN", "UKR"],
      "required": true
    },
    { "name": "category", "type": "string", "required": true },
    {
      "name": "location",
      "type": "select",
      "options": ["Pankow", "Schöneberg", "Köpenick"],
      "required": true
    },
    {
      "name": "status",
      "type": "select",
      "options": ["verfuegbar", "ausgeliehen", "reserviert"],
      "default": "verfuegbar",
      "required": true
    },
    { "name": "cover", "type": "media" },
    { "name": "description", "type": "text", "i18n": true }
  ]
}
