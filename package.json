{
  "name": "sprachcafe-relaunch-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "create:content": "npx tsx scripts/create_content_item.ts",
    "deploy:flows": "npx tsx scripts/deploy_m365_flows.ts",
    "setup:mitglied-flow": "npx tsx scripts/setup-mitglied-flow.ts",
    "sync:calendars": "npx tsx scripts/sync_google_calendars.ts",
    "sync:library": "npx tsx scripts/sync_hausbibliothek_catalog.ts",
    "enrich:library": "npx tsx scripts/enrich_hausbibliothek_catalog.ts",
    "archive:kpi": "npx tsx scripts/archive_kpi_snapshots.ts",
    "build:reports": "npx tsx scripts/fetch_cloudflare_analytics.ts && npx tsx scripts/fetch_mailchimp_metrics.ts && npx tsx scripts/archive_kpi_snapshots.ts && npx tsx scripts/generate_powerbi_previews.ts",
    "provision:it-structure": "npx tsx scripts/provision_sharepoint_it_structure.ts",
    "deploy:ops-flow": "npx tsx scripts/deploy_ops_flow_cli.ts",
    "server:check": "bash scripts/server_maintenance.sh --check-only",
    "server:health": "bash scripts/server_maintenance.sh --health-check",
    "server:maintenance": "sudo bash scripts/server_maintenance.sh --full",
    "test:ops-alert": "npx tsx scripts/test_ops_email_alert.ts",
    "validate:media": "npx tsx scripts/validate_media_s3_links.ts",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "he": "^1.2.0",
    "node-ical": "^0.20.1",
    "rrule": "^2.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "@pnp/cli-microsoft365": "^11.10.0",
    "@types/he": "^1.2.3",
    "axe-core": "^4.13.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pac-cli": "^1.0.3"
  }
}
