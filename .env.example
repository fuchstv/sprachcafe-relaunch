# ==========================================
# SprachCafé Relaunch - Environment Template
# ==========================================
# Kopieren Sie diese Datei nach `.env` bzw. `.env.production` und tragen Sie die entsprechenden Werte ein.

# ------------------------------------------
# 1. Allgemeine Einstellungen / Node & App
# ------------------------------------------
NODE_ENV=production
APP_PORT=3000
SITE_URL=https://sprachcafe-polnisch.org
PUBLIC_ASTRO_SITE_URL=https://sprachcafe-polnisch.org

# ------------------------------------------
# 2. Power Automate Webhook URLs
# ------------------------------------------
# Regel: Alle Web-Formulare triggern Flows im Microsoft 365 Tenant.
# Benachrichtigungen gehen per MS Teams an Agata Koch und per E-Mail an kontakt@sprachcafe-polnisch.org.

# 1. Mitgliedsantrag (Silver, Gold, Platinum, Firmen)
PUBLIC_POWER_AUTOMATE_MEMBER_WEBHOOK_URL="https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/28/workflows/5684425e46d24419b097ca7f097e13f5/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=..."

# 2. Kinder- & Elternangebote / Kursanmeldung
PUBLIC_POWER_AUTOMATE_KINDER_WEBHOOK_URL="https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/30/workflows/c044424868fc4e9289ca3a780ff1b584/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=..."

# 3. Allgemeines Kontaktformular & Themenauswahl
PUBLIC_POWER_AUTOMATE_CONTACT_WEBHOOK_URL="https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/16/workflows/6ed5943cba294ab8b56cbe50beedee96/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=..."

# 4. Ehrenamt & Praktikumsbewerbung
PUBLIC_POWER_AUTOMATE_VOLUNTEER_WEBHOOK_URL="https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/11/workflows/230c5da119164e9fb4cedf5a6b9391bd/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=..."

# 5. Barrierefreiheit melden
PUBLIC_POWER_AUTOMATE_BARRIER_WEBHOOK_URL="https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/00/workflows/6ee8c349217040098bb4614ea6b63677/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=..."

# ------------------------------------------
# 3. AWS-Zugangsdaten & Cloud-Ressourcen
# ------------------------------------------
AWS_REGION=eu-central-1
AWS_S3_BUCKET=sprachcafe-media-storage
AWS_S3_BUCKET_BACKUPS=sprachcafe-backups-prod

# ------------------------------------------
# 4. Infrastructure & Caddy Proxy Domains
# ------------------------------------------
DOMAIN_NAME=sprachcafe-polnisch.org
BETA_DOMAIN_NAME=beta.sprachcafe-polnisch.org
ACME_EMAIL=admin@sprachcafe-polnisch.org

# Deployment Pfade auf dem Server
PROD_DEPLOY_DIR=/var/www/production
BETA_DEPLOY_DIR=/var/www/beta
