# ==========================================
# SprachCafé Relaunch - Environment Template
# ==========================================
# Kopieren Sie diese Datei nach `.env` und tragen Sie die entsprechenden Werte ein.

# ------------------------------------------
# 1. Allgemeine Einstellungen / Node & App
# ------------------------------------------
NODE_ENV=development
APP_PORT=3000
SITE_URL=http://localhost:3000

# ------------------------------------------
# 2. AWS-Zugangsdaten & Cloud-Ressourcen
# ------------------------------------------
# HINWEIS: Verwenden Sie in Produktion IAM-Rollen oder AWS Secrets Manager.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=sprachcafe-media-storage
AWS_S3_BUCKET_BACKUPS=sprachcafe-backups-prod

# ------------------------------------------
# 3. Power Automate Webhook URLs
# ------------------------------------------
# Webhook für Mitgliedsanträge / Anmeldungen
POWER_AUTOMATE_MEMBER_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com:443/workflows/example-member-id/triggers/manual/paths/invoke?api-version=2016-06-01
PUBLIC_POWER_AUTOMATE_MEMBER_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com:443/workflows/example-member-id/triggers/manual/paths/invoke?api-version=2016-06-01

# Webhook für Event-Anmeldungen & SprachCafé-Treffen
POWER_AUTOMATE_EVENT_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com:443/workflows/example-event-id/triggers/manual/paths/invoke?api-version=2016-06-01

# Webhook für Kontaktformular & Allgemeine Anfragen
POWER_AUTOMATE_CONTACT_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com:443/workflows/example-contact-id/triggers/manual/paths/invoke?api-version=2016-06-01

# ------------------------------------------
# 4. Frontend (Astro) Konfiguration
# ------------------------------------------
PUBLIC_ASTRO_SITE_URL=http://localhost:3000

# ------------------------------------------
# 5. Infrastructure & Caddy Proxy Domains
# ------------------------------------------
DOMAIN_NAME=sprachcafe-polnisch.org
BETA_DOMAIN_NAME=beta.sprachcafe-polnisch.org
ACME_EMAIL=admin@sprachcafe-polnisch.org

# Deployment Pfade auf dem Server
PROD_DEPLOY_DIR=/var/www/production
BETA_DEPLOY_DIR=/var/www/beta
