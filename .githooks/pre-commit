#!/usr/bin/env bash
# ==============================================================================
# Pre-Commit Hook: Secret Leak Prevention for SprachCafé Relaunch
# Checks staged files for hardcoded secrets, private keys, and API tokens.
# ==============================================================================

set -eo pipefail

echo "🔍 Running Pre-Commit Secret Scanner..."

# Check if gitleaks is installed locally
if command -v gitleaks &> /dev/null; then
    echo "Running gitleaks protect on staged changes..."
    gitleaks protect --staged --verbose --config .gitleaks.toml
    echo "✓ Gitleaks check passed."
    exit 0
fi

# Fallback: Regex scan on staged files if gitleaks is not installed locally
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '(\.env\.example|\.md$|\.gitleaks\.toml)' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✓ No code files staged for secret scanning."
    exit 0
fi

ERRORS=0

for FILE in $STAGED_FILES; do
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # 1. AWS Access Key Check
    if git diff --cached "$FILE" | grep -qE '(AKIA|ASIA)[0-9A-Z]{16}'; then
        echo "❌ ERROR: AWS Access Key ID detected in staged file: $FILE"
        ERRORS=$((ERRORS + 1))
    fi

    # 2. Private SSH Key Check
    if git diff --cached "$FILE" | grep -qE '-----BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY-----'; then
        echo "❌ ERROR: Private Key detected in staged file: $FILE"
        ERRORS=$((ERRORS + 1))
    fi

    # 3. Hardcoded Azure / Power Automate Webhook Signatures
    if git diff --cached "$FILE" | grep -qE 'https://.*logic\.azure\.com.*sig=[a-zA-Z0-9_-]+'; then
        echo "❌ ERROR: Hardcoded Power Automate Webhook Secret URL detected in staged file: $FILE"
        ERRORS=$((ERRORS + 1))
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "🚨 COMMIT REJECTED: Hardcoded secrets found!"
    echo "Please remove secrets, place them in .env (or GitHub Secrets), and retry."
    exit 1
fi

echo "✓ Pre-Commit Secret Scan Passed Cleanly."
