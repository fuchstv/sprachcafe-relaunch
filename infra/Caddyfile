# Caddyfile - Central Reverse Proxy & Automatic TLS Configuration
# Automatic TLS via Let's Encrypt / ACME
{
	email admin@sprachcafe-polnisch.org
}

# ==============================================================================
# 1. Haupt-Website (Production): sprachcafe-polnisch.org & www.sprachcafe-polnisch.org & xn--sprachcaf-j4a.org (sprachcafé.org)
# -> Statische Dateien aus /var/www/production
# ==============================================================================
sprachcafe-polnisch.org, www.sprachcafe-polnisch.org, sprachcafé.org, www.sprachcafé.org, xn--sprachcaf-j4a.org, www.xn--sprachcaf-j4a.org {
	root * /var/www/production
	encode zstd gzip

	# ==============================================================================
	# 301 Redirect Map: Legacy WordPress URLs -> Astro Routes (Phase 6.1)
	# ==============================================================================

	# 1. Date-based Post Permalinks (/YYYY/MM/DD/slug & /YYYY/MM/slug)
	@wp_date_day path_regexp wp_date_day ^/(\d{4})/(\d{2})/(\d{2})/(.+?)/?$
	redir @wp_date_day /posts/{re.wp_date_day.4} 301

	@wp_date_month path_regexp wp_date_month ^/(\d{4})/(\d{2})/(.+?)/?$
	redir @wp_date_month /posts/{re.wp_date_month.3} 301

	# 2. Multilingual Legacy Post Permalinks (/(de|pl|en)/YYYY/MM/slug)
	@wp_lang_date path_regexp wp_lang_date ^/(de|pl|en)/(\d{4})/(\d{2})/(.+?)/?$
	redir @wp_lang_date /{re.wp_lang_date.1}/posts/{re.wp_lang_date.4} 301

	# 3. Specific WordPress Post & Article Slugs Mappings
	redir /erfolgreicher-relaunch/ /posts/erfolgreicher-relaunch-webportal 301
	redir /erfolgreicher-relaunch /posts/erfolgreicher-relaunch-webportal 301
	redir /neue-buchbestaende-koepenick/ /posts/neue-buchbestaende-koepenick 301
	redir /neue-buchbestaende-koepenick /posts/neue-buchbestaende-koepenick 301
	redir /pl/udany-relaunch/ /posts/erfolgreicher-relaunch-webportal 301
	redir /pl/udany-relaunch /posts/erfolgreicher-relaunch-webportal 301

	# 4. Legacy Categories, Tags, Authors & RSS Feeds
	@wp_categories path_regexp wp_cats ^/category/(.+?)/?$
	redir @wp_categories /posts/ 301

	@wp_tags path_regexp wp_tags ^/tag/(.+?)/?$
	redir @wp_tags /posts/ 301

	@wp_authors path_regexp wp_authors ^/author/(.+?)/?$
	redir @wp_authors /posts/ 301

	@wp_feeds path_regexp wp_feeds ^/(feed|rss|rss2|atom)/?$
	redir @wp_feeds /posts/ 301

	# 5. Legacy Pages & Content Sections to Astro Routes
	redir /ueber-uns/ /de/ 301
	redir /ueber-uns /de/ 301
	redir /ueber-uns/mission/ /de/ 301
	redir /ueber-uns/mission /de/ 301
	redir /projekte/ /posts/ 301
	redir /projekte /posts/ 301
	redir /de/projekte/ /posts/ 301
	redir /de/projekte /posts/ 301
	redir /freiwillig/ /mitmachen/ 301
	redir /freiwillig /mitmachen/ 301
	redir /ehrenamt/ /mitmachen/ 301
	redir /ehrenamt /mitmachen/ 301
	redir /engagiere-dich-als-freiwilliger/ /mitmachen/ 301
	redir /engagiere-dich-als-freiwilliger /mitmachen/ 301
	redir /test-engagiere-dich-als-freiwilliger/ /mitmachen/ 301
	redir /test-engagiere-dich-als-freiwilliger /mitmachen/ 301
	redir /veranstaltungen/ /events/ 301
	redir /veranstaltungen /events/ 301
	redir /bibliothek/ /hausbibliothek/ 301
	redir /bibliothek /hausbibliothek/ 301

	# 6. Legacy WordPress Admin & System Endpoints
	redir /wp-admin* https://admin.sprachcafe-polnisch.org 301
	redir /wp-login.php https://admin.sprachcafe-polnisch.org 301

	handle {
		file_server
	}

	# Security Headers for Production
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/production_access.log
		format json
	}
}

# ==============================================================================
# 2. CMS / Admin Interface (Production): admin.sprachcafe-polnisch.org
# -> Forced HTTPS, Token Auth Passthrough & Optional IP-Whitelist Directive
# ==============================================================================
admin.sprachcafe-polnisch.org {
	encode zstd gzip

	# --------------------------------------------------------------------------
	# OPTIONALE IP-WHITELIST DIREKTIVE (Auskommentierte Option für den produktiven Einsatz)
	# Schränkt den CMS-Adminzugriff auf autorisierte IPs/Vereinsbüro/VPN ein.
	# Zum Aktivieren der IP-Sperre einfach die nachfolgenden Zeilen einkommentieren:
	# --------------------------------------------------------------------------
	# @admin_whitelist {
	# 	not client_ip 192.168.1.0/24 203.0.113.50 127.0.0.1
	# }
	# respond @admin_whitelist "403 Forbidden - CMS Admin Access Restricted by IP Whitelist" 403

	# --------------------------------------------------------------------------
	# Token-Authentifizierung-Passthrough & Dynamic Header Forwarding zum CMS Backend
	# Transparente Weiterleitung aller Authorization-Header (Bearer Tokens & JWTs)
	# --------------------------------------------------------------------------
	# Headless CMS decommissioned - return 503 Service Unavailable
	respond "503 Service Unavailable - CMS Admin Interface decommissioned" 503

	# Forced HTTPS Security Headers (HSTS Preload, No-Sniff, Frame Deny)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/admin_access.log
		format json
	}
}

# ==============================================================================
# 3. Beta / Staging Environment: beta.sprachcafe-polnisch.org
# -> Staging-Proxy auf Port 3000 (separater Build-Ordner / Staging)
# ==============================================================================
beta.sprachcafe-polnisch.org {
	root * /var/www/beta
	encode zstd gzip

	handle {
		file_server
	}

	# Roboter-Indizierung für Staging unterbinden
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output file /var/log/caddy/beta_access.log
		format json
	}
}

# ==============================================================================
# 4. Hausbibliothek (Dauerhafter Proxy für Bibliotheks-App): hausbibliothek.org
# -> Proxy auf Port 8080 (Bibliotheks-App mit Nutzerkonten, Ausleihe, Admin-Dashboard)
# HINWEIS: Explizite Proxy-Header X-Forwarded-Proto, X-Forwarded-For, X-Forwarded-Host
# für Session-Cookies / CSRF Validation in Phase L.9
# ==============================================================================
hausbibliothek.org, www.hausbibliothek.org {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	log {
		output file /var/log/caddy/hausbibliothek_access.log
		format json
	}
}
