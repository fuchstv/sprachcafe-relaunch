{
  "name": "7078b566-3858-4507-a37d-3084075d582a",
  "id": "/providers/Microsoft.ProcessSimple/environments/Default-b745a80a-f682-45e4-ba2e-d48bbd9e703d/flows/7078b566-3858-4507-a37d-3084075d582a",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "SprachCafé - Anmeldung Kinder & Eltern (MS Teams an Agata Koch)",
    "state": "Started",
    "triggerUrl": "https://defaultb745a80af68245e4ba2ed48bbd9e70.3d.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/04/workflows/2654d01ee53146a3b6906f7d4cec2ab1/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=yRf_6IcNJXkpPo9LKVIsPue_tBQ6DIFXl65f-olH8QM",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "child_name": {
                  "type": "string",
                  "description": "Vorname, Name und Alter des Kindes / Imię, nazwisko i wiek dziecka"
                },
                "parent_name": {
                  "type": "string",
                  "description": "Vornamen, Name(n) der Eltern / Imiona, nazwisko(-a) rodziców"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "description": "E-Mail-Adresse / Adres e-mail"
                },
                "phone": {
                  "type": "string",
                  "description": "Telefonnummer / Numer telefonu"
                },
                "location": {
                  "type": "string",
                  "enum": [
                    "Pankow",
                    "Schöneberg",
                    "Köpenick"
                  ],
                  "description": "Veranstaltungsort / Miejsce"
                },
                "date_from": {
                  "type": "string",
                  "description": "Buchungszeitraum Beginn (YYYY-MM-DD)"
                },
                "date_to": {
                  "type": "string",
                  "description": "Buchungszeitraum Ende (YYYY-MM-DD)"
                },
                "acceptance_terms": {
                  "type": "boolean",
                  "description": "Zustimmung zu Bedingungen & Haftung"
                },
                "lang": {
                  "type": "string",
                  "enum": [
                    "de",
                    "pl",
                    "en"
                  ]
                },
                "submittedAt": {
                  "type": "string"
                }
              },
              "required": [
                "child_name",
                "parent_name",
                "email",
                "location",
                "date_from",
                "date_to",
                "acceptance_terms"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_Teams_Recipient": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "AgataKochEmail",
                "type": "string",
                "value": "a.koch@sprachcafe-polnisch.org"
              },
              {
                "name": "TeamsNotificationCard",
                "type": "string",
                "value": "🎈 Neue Kursanmeldung (Kinder & Eltern) für Agata Koch (a.koch@sprachcafe-polnisch.org): Kind: @{triggerBody()?['child_name']}, Eltern: @{triggerBody()?['parent_name']}, Ort: @{triggerBody()?['location']}, Zeitraum: @{triggerBody()?['date_from']} bis @{triggerBody()?['date_to']}, E-Mail: @{triggerBody()?['email']}, Tel: @{triggerBody()?['phone']}"
              }
            ]
          }
        },
        "Response_Success": {
          "type": "Response",
          "kind": "Http",
          "runAfter": {
            "Initialize_Teams_Recipient": [
              "Succeeded"
            ]
          },
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "status": "success",
              "message": "Anmeldung für Kinder & Eltern erfolgreich übermittelt. MS Teams Nachricht an Agata Koch (a.koch@sprachcafe-polnisch.org) initiiert.",
              "recipient": "a.koch@sprachcafe-polnisch.org",
              "child": "@{triggerBody()?['child_name']}",
              "parent": "@{triggerBody()?['parent_name']}",
              "location": "@{triggerBody()?['location']}",
              "timestamp": "@{utcNow()}"
            }
          }
        }
      }
    }
  }
}
