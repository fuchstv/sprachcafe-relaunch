{
  "name": "PowerAutomate_Flow_Exhibitions_Registration",
  "displayName": "SprachCafé - Redaktion Ausstellung (MS Forms zu S3 zu GitHub PR)",
  "formId": "CqhFt4L25EW6LtSLvZ5wPZc9f-Yj5GpMoZYjm79OAKdUME1NN0xVOEw4M1dNNUZBUk42N1NaTDQ1RS4u",
  "targetCollection": "exhibitions",
  "s3Bucket": "sprachcafe-media-storage",
  "s3Prefix": "exhibitions",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_new_response_is_submitted": {
        "type": "OpenApiConnectionWebhook",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms",
            "connectionName": "shared_microsoftforms"
          },
          "parameters": {
            "form_id": "CqhFt4L25EW6LtSLvZ5wPZc9f-Yj5GpMoZYjm79OAKdUME1NN0xVOEw4M1dNNUZBUk42N1NaTDQ1RS4u"
          }
        }
      }
    },
    "actions": {
      "Get_response_details": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms",
            "connectionName": "shared_microsoftforms"
          },
          "parameters": {
            "form_id": "CqhFt4L25EW6LtSLvZ5wPZc9f-Yj5GpMoZYjm79OAKdUME1NN0xVOEw4M1dNNUZBUk42N1NaTDQ1RS4u",
            "response_id": "@triggerBody()?['extraProperties']?['responderId']"
          }
        }
      },
      "Get_Uploaded_File_Content": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness",
            "connectionName": "shared_onedriveforbusiness"
          },
          "method": "get",
          "path": "/datasets/default/files/@{encodeURIComponent(json(body('Get_response_details')?['r123_image'])?[0]?['id'])}/content"
        }
      },
      "Upload_Image_To_Amazon_S3": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_amazons3",
            "connectionName": "shared_amazons3"
          },
          "method": "put",
          "path": "/v2/buckets/@{encodeURIComponent('sprachcafe-media-storage')}/objects/@{encodeURIComponent(concat('exhibitions/', utcNow('yyyyMMdd-HHmmss'), '-', json(body('Get_response_details')?['r123_image'])?[0]?['name']))}",
          "body": "@body('Get_Uploaded_File_Content')"
        }
      },
      "Create_Git_Branch": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_github",
            "connectionName": "shared_github"
          },
          "method": "post",
          "path": "/repos/fuchstv/sprachcafe-relaunch/git/refs",
          "body": {
            "ref": "@concat('refs/heads/content/exhibition-', formatDateTime(utcNow(), 'yyyyMMdd-HHmmss'))",
            "sha": "@body('Get_beta_branch_SHA')?['object']?['sha']"
          }
        }
      },
      "Create_Content_File": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_github",
            "connectionName": "shared_github"
          },
          "method": "put",
          "path": "/repos/fuchstv/sprachcafe-relaunch/contents/frontend/src/content/exhibitions/@{concat('exhibition-', formatDateTime(utcNow(), 'yyyyMMddHHmmss'))}.md",
          "body": {
            "branch": "@concat('content/exhibition-', formatDateTime(utcNow(), 'yyyyMMdd-HHmmss'))",
            "message": "feat(content): add exhibition via MS Forms and S3 media storage",
            "content": "@base64(concat('---\ntitle:\n  de: \"', body('Get_response_details')?['r123_title'], '\"\nartist: \"', body('Get_response_details')?['r123_artist'], '\"\ngallery:\n  - url: \"https://sprachcafe-media-storage.s3.eu-central-1.amazonaws.com/exhibitions/', utcNow('yyyyMMdd-HHmmss'), '-', json(body('Get_response_details')?['r123_image'])?[0]?['name'], '\"\n---\n'))"
          }
        }
      },
      "Create_Pull_Request": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionProviderDeletePolicy": "Any",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_github",
            "connectionName": "shared_github"
          },
          "method": "post",
          "path": "/repos/fuchstv/sprachcafe-relaunch/pulls",
          "body": {
            "title": "[Redaktion] Neue Ausstellung (S3-Galerie) via MS Forms",
            "head": "@concat('content/exhibition-', formatDateTime(utcNow(), 'yyyyMMdd-HHmmss'))",
            "base": "beta",
            "body": "Automatisch generierter PR aus Microsoft Forms mit S3-Medienspeicher für beta.sprachcafe-polnisch.org"
          }
        }
      }
    }
  }
}
